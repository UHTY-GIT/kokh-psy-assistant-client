{"ast":null,"code":"import apiService from '@/services/apiService';\nimport M from 'materialize-css';\nimport { ref } from 'vue';\nimport ModalTemplates from \"@/components/modal/ModalTemplates.vue\";\nexport default {\n  name: \"AllClient\",\n  components: {\n    ModalTemplates\n  },\n  setup() {\n    const showModal = ref(false);\n    const clients = ref([]);\n    const templates = ref([]);\n    const fetchClients = async () => {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getClients(token);\n          if (response && response.data && response.data.data) {\n            clients = response.data.data; // Зберігання даних клієнтів у масив\n          }\n        }\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n        M.toast({\n          html: `Увійдіть у систему`\n        });\n      }\n    };\n    const fetchTemplates = async () => {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getForms(token);\n          if (response && response.data && response.data.data) {\n            templates = response.data.data; // Зберігання даних форм у масив\n          }\n        }\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n        M.toast({\n          html: `Увійдіть у систему`\n        });\n      }\n    };\n    const openModal = () => {\n      showModal.value = true;\n      fetchTemplates();\n    };\n\n    // // Перенесіть логіку з mounted сюди, якщо потрібно запустити щось при створенні компонента\n    // fetchClients();\n\n    return {\n      clients,\n      showModal,\n      openModal\n    };\n  }\n};","map":{"version":3,"names":["apiService","M","ref","ModalTemplates","name","components","setup","showModal","clients","templates","fetchClients","token","localStorage","getItem","response","getClients","data","error","console","toast","html","fetchTemplates","getForms","openModal","value"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\AllClientPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"client-header\">\r\n      <button class=\"btn-add-client\">\r\n        Додати клієнта\r\n      </button>\r\n      <button class=\"btn-refresh\">\r\n        <img src=\"@/assets/icons/refresh.svg\" alt=\"Оновити\">\r\n      </button>\r\n    </div>\r\n    <div class=\"search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Ім'я</th>\r\n          <th>Номер телефону</th>\r\n          <th>Прийняв згоду</th>\r\n          <th>Первинне оцінювання</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"client in clients\" :key=\"client.telegram_id\">\r\n          <td>{{ client.name }}</td>\r\n          <td>{{ client.phone }}</td>\r\n          <td>{{ client.was_agreed ? 'так' : 'ні' }}</td>\r\n          <td>{{ client.primary_poll_complete ? 'так' : 'ні' }}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\" data-tooltip=\"Надіслати повідомлення\" @click=\"openModal\">\r\n              <img src=\"@/assets/icons/send-template-white.svg\" alt=\"Надіслати повідомлення\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Переглянути\">\r\n              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Редагувати\">\r\n              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Видалити\">\r\n              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">\r\n            </button>\r\n          </td>\r\n\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n<!--  Модальне вікно-->\r\n  <modal-templates v-if=\"showModal\" @close=\"showModal = false\" />\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport M from 'materialize-css';\r\nimport { ref } from 'vue';\r\nimport ModalTemplates from \"@/components/modal/ModalTemplates.vue\";\r\nexport default {\r\n  name: \"AllClient\",\r\n  components: {\r\n    ModalTemplates\r\n  },\r\n  setup() {\r\n    const showModal = ref(false);\r\n    const clients = ref([]);\r\n    const templates = ref([]);\r\n\r\n    const fetchClients = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getClients(token);\r\n          if (response && response.data && response.data.data) {\r\n            clients = response.data.data; // Зберігання даних клієнтів у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n        M.toast({ html: `Увійдіть у систему` });\r\n      }\r\n    };\r\n\r\n    const fetchTemplates = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getForms(token);\r\n          if (response && response.data && response.data.data) {\r\n            templates = response.data.data; // Зберігання даних форм у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n        M.toast({ html: `Увійдіть у систему` });\r\n      }\r\n    };\r\n\r\n    const openModal = () => {\r\n      showModal.value = true;\r\n      fetchTemplates();\r\n    };\r\n\r\n    // // Перенесіть логіку з mounted сюди, якщо потрібно запустити щось при створенні компонента\r\n    // fetchClients();\r\n\r\n    return {\r\n      clients,\r\n      showModal,\r\n      openModal\r\n    }\r\n  }\r\n};\r\n</script>"],"mappings":"AAgEA,OAAOA,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,SAASC,GAAE,QAAS,KAAK;AACzB,OAAOC,cAAa,MAAO,uCAAuC;AAClE,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIL,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMM,OAAM,GAAIN,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMO,SAAQ,GAAIP,GAAG,CAAC,EAAE,CAAC;IAEzB,MAAMQ,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;QAC7C,IAAIF,KAAK,EAAE;UACT,MAAMG,QAAO,GAAI,MAAMd,UAAU,CAACe,UAAU,CAACJ,KAAK,CAAC;UACnD,IAAIG,QAAO,IAAKA,QAAQ,CAACE,IAAG,IAAKF,QAAQ,CAACE,IAAI,CAACA,IAAI,EAAE;YACnDR,OAAM,GAAIM,QAAQ,CAACE,IAAI,CAACA,IAAI,EAAE;UAChC;QACF;MACF,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;QAC/ChB,CAAC,CAACkB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAoB,CAAC,CAAC;MACzC;IACF,CAAC;IAED,MAAMC,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMV,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;QAC7C,IAAIF,KAAK,EAAE;UACT,MAAMG,QAAO,GAAI,MAAMd,UAAU,CAACsB,QAAQ,CAACX,KAAK,CAAC;UACjD,IAAIG,QAAO,IAAKA,QAAQ,CAACE,IAAG,IAAKF,QAAQ,CAACE,IAAI,CAACA,IAAI,EAAE;YACnDP,SAAQ,GAAIK,QAAQ,CAACE,IAAI,CAACA,IAAI,EAAE;UAClC;QACF;MACF,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;QAC/ChB,CAAC,CAACkB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAoB,CAAC,CAAC;MACzC;IACF,CAAC;IAED,MAAMG,SAAQ,GAAIA,CAAA,KAAM;MACtBhB,SAAS,CAACiB,KAAI,GAAI,IAAI;MACtBH,cAAc,CAAC,CAAC;IAClB,CAA