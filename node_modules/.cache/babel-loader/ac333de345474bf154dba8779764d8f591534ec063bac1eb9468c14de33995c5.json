{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport apiService from \"@/services/apiService\";\nexport default {\n  props: {\n    clientId: Number,\n    clientName: String,\n    customFormId: Number,\n    customFormTitle: String,\n    sessionNumber: Number\n  },\n  setup(props) {\n    const formData = ref([]);\n    const fetchFormData = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          return;\n        }\n        const response = await apiService.getCustomFormById(props.customFormId);\n        formData.value = response.data;\n      } catch (error) {\n        console.error('Error fetching form data:', error);\n      }\n    };\n    onMounted(fetchFormData);\n    return {\n      formData,\n      ...props\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","apiService","props","clientId","Number","clientName","String","customFormId","customFormTitle","sessionNumber","setup","formData","fetchFormData","token","localStorage","getItem","response","getCustomFormById","value","data","error","console"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\ActiveSessionPage.vue"],"sourcesContent":["<!--src/views/ActiveSession.vue-->\r\n<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Сесія №{{ sessionNumber }}, клієнт {{ clientName }}\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"block_active_session\">\r\n    <div class=\"titte_field\">\r\n      <p>\r\n        Базові поля\r\n      </p>\r\n    </div>\r\n    <div class=\"block_input_field\">\r\n      <form>\r\n        <div class=\"forms-name-add\">\r\n          <div class=\"container-input\">\r\n            <label for=\"main-points-of-the-session\">Основні думки сесії</label>\r\n            <input\r\n                type=\"text\"\r\n                id=\"main-points-of-the-session\"\r\n\r\n                placeholder=\"Введіть основні думки по цій сесії\"\r\n            >\r\n            <!--          v-model=\"form.title\"-->\r\n            <!--          :class=\"{ 'is-invalid': v$.title.$dirty && v$.title.required.$invalid }\"-->\r\n          </div>\r\n          <!--        <span class=\"validate-error\" v-if=\"v$.title.$dirty && v$.title.required.$invalid\">Це поле не може бути пустим</span>-->\r\n        </div>\r\n\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/share.svg\" alt=\"Send name form\">\r\n            <span class=\"edit-link\">Завершити сесію</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  props: {\r\n    clientId: Number,\r\n    clientName: String,\r\n    customFormId: Number,\r\n    customFormTitle: String,\r\n    sessionNumber: Number\r\n  },\r\n  setup(props) {\r\n    const formData = ref([]);\r\n\r\n    const fetchFormData = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          return;\r\n        }\r\n        const response = await apiService.getCustomFormById(props.customFormId);\r\n        formData.value = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching form data:', error);\r\n      }\r\n    };\r\n\r\n    onMounted(fetchFormData);\r\n\r\n    return {\r\n      formData,\r\n      ...props\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AA8CA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,KAAK,EAAE;IACLC,QAAQ,EAAEC,MAAM;IAChBC,UAAU,EAAEC,MAAM;IAClBC,YAAY,EAAEH,MAAM;IACpBI,eAAe,EAAEF,MAAM;IACvBG,aAAa,EAAEL;EACj