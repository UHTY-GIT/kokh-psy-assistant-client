{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport apiService from \"@/services/apiService\";\nexport default {\n  setup() {\n    const route = useRoute();\n    const formData = ref({\n      fields: []\n    });\n    const clientId = route.query.clientId;\n    const clientName = route.query.clientName;\n    const customFormId = route.query.customFormId;\n    const customFormTitle = route.query.customFormTitle;\n    const sessionNumber = route.query.sessionNumber;\n    const fetchFormData = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          throw new Error('No authentication token found');\n        }\n        const response = await apiService.getCustomFormById(customFormId);\n        formData.value.fields = response.data.fields; // Assuming the response contains fields data\n      } catch (error) {\n        console.error('Error fetching form data:', error);\n      }\n    };\n    onMounted(fetchFormData);\n    return {\n      formData,\n      clientId,\n      clientName,\n      customFormId,\n      customFormTitle,\n      sessionNumber\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","apiService","setup","route","formData","fields","clientId","query","clientName","customFormId","customFormTitle","sessionNumber","fetchFormData","token","localStorage","getItem","Error","response","getCustomFormById","value","data","error","console"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\ActiveSessionPage.vue"],"sourcesContent":["<!-- src/views/ActiveSessionPage.vue -->\r\n<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Сесія №{{ sessionNumber }}, клієнт {{ clientName }}\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"block_active_session\">\r\n    <div class=\"titte_field\">\r\n      <p>\r\n        Базові поля\r\n      </p>\r\n    </div>\r\n    <div class=\"block_input_field\">\r\n      <form>\r\n        <div class=\"forms-name-add\">\r\n          <div class=\"container-input\">\r\n            <label for=\"main-points-of-the-session\">Основні думки сесії</label>\r\n            <input\r\n                type=\"text\"\r\n                id=\"main-points-of-the-session\"\r\n                placeholder=\"Введіть основні думки по цій сесії\"\r\n            >\r\n          </div>\r\n        </div>\r\n        <div v-for=\"field in formData.fields\" :key=\"field.id\" class=\"forms-name-add\">\r\n          <div class=\"container-input\">\r\n            <label :for=\"field.id\">{{ field.label }}</label>\r\n            <input\r\n                :type=\"field.type\"\r\n                :id=\"field.id\"\r\n                v-model=\"field.value\"\r\n                :placeholder=\"field.placeholder\"\r\n            >\r\n          </div>\r\n        </div>\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/share.svg\" alt=\"Send name form\">\r\n            <span class=\"edit-link\">Завершити сесію</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  setup() {\r\n    const route = useRoute();\r\n    const formData = ref({\r\n      fields: [],\r\n    });\r\n\r\n    const clientId = route.query.clientId;\r\n    const clientName = route.query.clientName;\r\n    const customFormId = route.query.customFormId;\r\n    const customFormTitle = route.query.customFormTitle;\r\n    const sessionNumber = route.query.sessionNumber;\r\n\r\n    const fetchFormData = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          throw new Error('No authentication token found');\r\n        }\r\n        const response = await apiService.getCustomFormById(customFormId);\r\n        formData.value.fields = response.data.fields; // Assuming the response contains fields data\r\n      } catch (error) {\r\n        console.error('Error fetching form data:', error);\r\n      }\r\n    };\r\n\r\n    onMounted(fetchFormData);\r\n\r\n    return {\r\n      formData,\r\n      clientId,\r\n      clientName,\r\n      customFormId,\r\n      customFormTitle,\r\n      sessionNumber\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAmDA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIH,QAAQ,CAAC,CAAC;IACxB,MAAMI,QAAO,GAAIN,GAAG,CAAC;MACnBO,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,QAAO,GAAIH,KAAK,CAACI,KAAK,CAACD,QAAQ;IACrC,MAAME,UAAS,GAAIL,KAAK,CAACI,KAAK,CAACC,UAAU;IACzC,MAAMC,YAAW,GAAIN,KAAK,CAACI,KAAK,CAACE,YAAY;IAC7C,MAAMC,eAAc,GAAIP,KAAK,CAACI,KAAK,CAACG,eAAe;IACnD,MAAMC,aAAY,GAAIR,KAAK,CAACI,KAAK,CAACI,aAAa;IAE/C,MAAMC,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACV,MAAM,IAAIG,KAAK,CAAC,+BAA+B,CAAC;QAClD;QACA,MAAMC,QAAO,GAAI,MAAMhB,UAAU,CAACiB,iBAAiB,CAACT,YAAY,CAAC;QACjEL,QAAQ,CAACe,KAAK,CAACd,MAAK,GAAIY,QAAQ,CAACG,IAAI,CAACf,MAAM,EAAE;MAChD,EAAE,OAAOgB,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;MACnD;IACF,CAAC;IAEDtB,SAAS,CAACa,aAAa,CAAC;IAExB,OAAO;MACLR,QAAQ;MACRE,QAAQ;MACRE,UAAU;MACVC,YAAY;MACZC,eAAe;MACfC;IACF,CAAC;EACH;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}