{"ast":null,"code":"import { createElementVNode as _createElementVNode, toDisplayString as _toDisplayString, resolveComponent as _resolveComponent, withCtx as _withCtx, createVNode as _createVNode, normalizeStyle as _normalizeStyle, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  class: \"container-user-photo\"\n};\nconst _hoisted_2 = {\n  class: \"user-photo\"\n};\nconst _hoisted_3 = [\"src\"];\nconst _hoisted_4 = {\n  class: \"container-user-name\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  const _component_router_link = _resolveComponent(\"router-link\");\n  return _openBlock(), _createElementBlock(\"div\", {\n    style: _normalizeStyle({\n      backgroundImage: `url(${$options.fullBackgroundImageUrl})`\n    }),\n    class: \"background-navbar\"\n  }, [_createElementVNode(\"div\", _hoisted_1, [_createVNode(_component_router_link, {\n    to: \"/profile\"\n  }, {\n    default: _withCtx(() => [_createElementVNode(\"div\", _hoisted_2, [_createElementVNode(\"img\", {\n      src: $options.fullUserPhotoUrl,\n      alt: \"user photo\"\n    }, null, 8, _hoisted_3)]), _createElementVNode(\"span\", _hoisted_4, _toDisplayString($data.userName), 1)]),\n    _: 1\n  })])], 4);\n}","map":{"version":3,"names":["class","_createElementBlock","style","_normalizeStyle","backgroundImage","$options","fullBackgroundImageUrl","_createElementVNode","_hoisted_1","_createVNode","_component_router_link","to","default","_withCtx","_hoisted_2","src","fullUserPhotoUrl","alt","_hoisted_3","_hoisted_4","_toDisplayString","$data","userName","_"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\app\\NavBar.vue"],"sourcesContent":["<template>\r\n  <div :style=\"{ backgroundImage: `url(${fullBackgroundImageUrl})` }\" class=\"background-navbar\">\r\n    <div class=\"container-user-photo\">\r\n      <router-link to=\"/profile\">\r\n        <div class=\"user-photo\">\r\n          <img :src=\"fullUserPhotoUrl\" alt=\"user photo\">\r\n        </div>\r\n        <span class=\"container-user-name\">\r\n          {{ userName }}\r\n        </span>\r\n      </router-link>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport defaultUserPhoto from '@/assets/photo/Potted Plant.svg';\r\nimport defaultBackgroundImage from '@/assets/photo/back-users-1.png';\r\n//import { mapState } from 'vuex';\r\nexport default {\r\n  name: 'NavBar',\r\n  data() {\r\n    return {\r\n      userPhoto: defaultUserPhoto,\r\n      userName: '',\r\n      backgroundImage: defaultBackgroundImage,\r\n      baseImageUrl: 'http://assistant.psy-kokh.online:3000',\r\n    };\r\n  },\r\n  computed: {\r\n    fullUserPhotoUrl() {\r\n      // Якщо userPhoto не null і містить шлях, який не починається з 'http', додаємо baseImageUrl\r\n      return this.userPhoto && !this.userPhoto.startsWith('http') ? `${this.baseImageUrl}${this.userPhoto}` : this.userPhoto;\r\n    },\r\n    fullBackgroundImageUrl() {\r\n      // Якщо backgroundImage містить шлях, який не починається з 'http', додаємо baseImageUrl\r\n      // В іншому випадку, повертаємо сам backgroundImage або defaultBackgroundImage, якщо перший null\r\n      return this.backgroundImage && !this.backgroundImage.startsWith('http') ? `${this.baseImageUrl}${this.backgroundImage}` : (this.backgroundImage || defaultBackgroundImage);\r\n    }\r\n  },\r\n  async mounted() {\r\n    try {\r\n      const token = localStorage.getItem('token');\r\n      console.log(token);\r\n      if (token) {\r\n        const userProfile = await apiService.getUserProfile(token);\r\n        console.log(userProfile.data)\r\n        if (userProfile && userProfile.data) {\r\n          this.userName = userProfile.data.name || 'Username';\r\n          this.userPhoto = userProfile.data.avatar_url || defaultUserPhoto;\r\n          this.backgroundImage = userProfile.data.background_photo_url || defaultBackgroundImage;\r\n        }\r\n      }\r\n    } catch (error) {\r\n      console.error('Error fetching user profile:', error);\r\n    }\r\n  },\r\n}\r\n</script>"],"mappings":";;EAESA,KAAK,EAAC;AAAsB;;EAExBA,KAAK,EAAC;AAAY;mBAJ/B;;EAOcA,KAAK,EAAC;AAAqB;;;uBANvCC,mBAAA,CAWM;IAXAC,KAAK,EADbC,eAAA;MAAAC,eAAA,SACyCC,QAAA,CAAAC,sBAAsB;IAAA;IAAON,KAAK,EAAC;MACxEO,mBAAA,CASM,OATNC,UASM,GARJC,YAAA,CAOcC,sBAAA;IAPDC,EAAE,EAAC;EAAU;IAHhCC,OAAA,EAAAC,QAAA,CAIQ,MAEM,CAFNN,mBAAA,CAEM,OAFNO,UAEM,GADJP,mBAAA,CAA8C;MAAxCQ,GAAG,EAAEV,QAAA,CAAAW,gBAAgB;MAAEC,GAAG,EAAC;gBAL3CC,UAAA,E,GAOQX,mBAAA,CAEO,QAFPY,UAEO,EAAAC,gBAAA,CADFC,KAAA,CAAAC,QAAQ,M;IARrBC,CAAA"},"metadata":{},"sourceType":"module","externalDependencies":[]}