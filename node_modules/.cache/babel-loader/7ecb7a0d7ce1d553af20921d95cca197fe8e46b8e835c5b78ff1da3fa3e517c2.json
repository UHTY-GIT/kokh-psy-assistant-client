t v$ = useVuelidate({\r\n      workingDays: { atLeastOneDaySelected }\r\n    }, { workingDays });\r\n    const submitDaysProfile = () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        console.log('Обрані робочі дні:', Object.keys(workingDays.value).filter(day => workingDays.value[day]));\r\n        // Логіка відправки даних на сервер\r\n      } else {\r\n        // Логіка для обробки помилки валідації\r\n      }\r\n    };\r\n\r\n    return {\r\n      v$,\r\n      workingDays,\r\n      submitDaysProfile,\r\n    }\r\n  },\r\n}\r\n\r\n</script>"],"mappings":"AAuHA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,YAAW,QAAS,iBAAiB;AAC9C;AACA,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN;IACA,MAAMC,WAAU,GAAIH,GAAG,CAAC;MACtBI,MAAM,EAAE,KAAK;MACbC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,KAAK;MAChBC,QAAQ,EAAE,KAAK;MACfC,MAAM,EAAE,KAAK;MACbC,QAAQ,EAAE;IACZ,CAAC,CAAC;;IAEF;IACA,MAAMC,qBAAoB,GAAKC,KAAK,IAAK;MACvC,OAAOC,MAAM,CAACC,MAAM,CAACF,KAAK,CAAC,CAACG,IAAI,CAACC,CAAA,IAAKA,CAAC,CAAC;IAC1C,CAAC;IAED,MAAMC,EAAC,GAAIf,YAAY,CAAC;MACtBE,WAAW,EAAE;QAAEO;MAAsB;IACvC,CAAC,EAAE;MAAEP;IAAY,CAAC,CAAC;IACnB,MAAMc,iBAAgB,GAAIA,CAAA,KAAM;MAC9BD,EAAE,CAACL,KAAK,CAACO,MAAM,CAAC,CAAC;MACjB,IAAI,CAACF,EAAE,CAACL,KAAK,CAACQ,QAAQ,EAAE;QACtBC,OAAO,CAACC,GAAG,CAAC,oBAAoB,EAAET,MAAM,CAACU,IAAI,CAACnB,WAAW,CAACQ,KAAK,CAAC,CAACY,MAAM,CAACC,GAAE,IAAKrB,WAAW,CAACQ,KAAK,CAACa,GAAG,CAAC,CAAC,CAAC;QACvG;MACF,OAAO;QACL;MAAA;IAEJ,CAAC;IAED,OAAO;MACLR,EAAE;MACFb,WAAW;MACXc;IACF;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}