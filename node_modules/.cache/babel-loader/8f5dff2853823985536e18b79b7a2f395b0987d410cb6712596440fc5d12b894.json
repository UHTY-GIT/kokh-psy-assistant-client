{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { reactive, ref } from 'vue';\nimport apiService from '@/services/apiService';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\nimport M from 'materialize-css';\nimport router from \"@/router\";\nexport default {\n  setup() {\n    // Реактивний об'єкт для форми\n    const form = reactive({\n      title: '',\n      primaryPollId: '',\n      formType: '',\n      formItems: [{\n        field_name: '',\n        field_type: 'text'\n      }]\n    });\n    const rules = {\n      title: {\n        required\n      }\n    };\n\n    // Використання Vuelidate\n    const v$ = useVuelidate(rules, form);\n    const createdFormId = ref('');\n\n    // Методи\n    const addFormItem = () => {\n      form.formItems.push({\n        field_name: '',\n        field_type: 'text'\n      });\n    };\n    const removeFormItem = index => {\n      form.formItems.splice(index, 1);\n    };\n    const handleSubmit = async () => {\n      v$.value.$touch();\n      if (!v$.value.$invalid) {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          M.toast({\n            html: `Ви не авторизовані`\n          });\n          return;\n        }\n        try {\n          const response = await apiService.createCustomForm(token, form.title, form.primaryPollId, form.formType);\n          createdFormId.value = response.data.data.id;\n          M.toast({\n            html: `Назву форми успішно задано`\n          });\n        } catch (error) {\n          console.error('Помилка при створенні форми:', error);\n        }\n      }\n    };\n    const submitFormItems = async () => {\n      const token = localStorage.getItem('token');\n      if (createdFormId.value && form.formItems.length) {\n        try {\n          await apiService.createFormItem(token, createdFormId.value, form.formItems);\n          M.toast({\n            html: `Форма успішно створена`\n          });\n          router.push('/bank-info');\n        } catch (error) {\n          M.toast({\n            html: `Помилка під час створеня елементів форми`\n          });\n        }\n      } else {\n        M.toast({\n          html: `Форма не створена або елементи форми відсутні`\n        });\n      }\n    };\n    return {\n      v$,\n      form,\n      addFormItem,\n      removeFormItem,\n      handleSubmit,\n      submitFormItems,\n      createdFormId\n    };\n  }\n};","map":{"version":3,"names":["reactive","ref","apiService","useVuelidate","required","M","router","setup","form","title","primaryPollId","formType","formItems","field_name","field_type","rules","v$","createdFormId","addFormItem","push","removeFormItem","index","splice","handleSubmit","value","$touch","$invalid","token","localStorage","getItem","toast","html","response","createCustomForm","data","id","error","console","submitFormItems","length","createFormItem"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\TemplateForm.vue"],"sourcesContent":["<!--template form-->\r\n<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Створити нову форму\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"form-bank-info-container\">\r\n    <!-- Форма для створення шаблону -->\r\n    <form class=\"name-update-form\" @submit.prevent=\"handleSubmit\">\r\n      <div class=\"forms-name-add\">\r\n        <div class=\"container-input\">\r\n          <label for=\"formType\">Виберіть тип шаблону</label>\r\n          <select id=\"formType\" v-model=\"form.formType\">\r\n            <option value=\"consent_individual\">Первинне опитування індивідуальне</option>\r\n            <option value=\"primary_poll_couple\">Первинне опитування парне</option>\r\n            <option value=\"primary_poll_individual\">Первинне опитування індивідуальне</option>\r\n            <option value=\"primary_poll_couple\">Первинне опитування парне</option>\r\n            <option value=\"individual_consultation\">Індивідуальна консультація</option>\r\n            <option value=\"couple_consultation\">Парна консультація</option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n      <div class=\"forms-name-add\">\r\n        <div class=\"container-input\">\r\n          <label for=\"title\">Назва шаблону</label>\r\n          <input\r\n              type=\"text\"\r\n              id=\"title\"\r\n              v-model=\"form.title\"\r\n              :class=\"{ 'is-invalid': v$.title.$dirty && v$.title.required.$invalid }\"\r\n              placeholder=\"Введіть назву шаблону\"\r\n          >\r\n        </div>\r\n        <span class=\"validate-error\" v-if=\"v$.title.$dirty && v$.title.required.$invalid\">Це поле не може бути пустим</span>\r\n      </div>\r\n\r\n      <!--      <button type=\"submit\" class=\"btn-submit\">Задати назву</button>-->\r\n      <div class=\"container-global-form-edit\">\r\n        <button class=\"global-form-edit\" type=\"submit\">\r\n          <img src=\"@/assets/icons/edit-form.svg\" alt=\"Send name form\">\r\n          <span class=\"edit-link\">Задати назву</span>\r\n        </button>\r\n      </div>\r\n    </form>\r\n\r\n    <!-- Умовний рендеринг для додавання елементів форми, якщо форма створена -->\r\n    <div v-if=\"createdFormId\">\r\n      <div class=\"undertittle-on-bank-ifro\">\r\n        <p>Додати елемент форми</p>\r\n      </div>\r\n      <div class=\"form-items\">\r\n        <!-- Відображення динамічних полів форми -->\r\n        <div\r\n            v-for=\"(item, index) in form.formItems\"\r\n            :key=\"index\"\r\n            class=\"form-item\"\r\n        >\r\n          <div class=\"forms-name-add\">\r\n            <div class=\"container-input\">\r\n              <label for=\"Namefield\">Назва поля</label>\r\n              <input\r\n                  id=\"Namefield\"\r\n                  type=\"text\"\r\n                  v-model=\"item.field_name\"\r\n\r\n                  placeholder=\"Введіть назву для цього поля\"\r\n              >\r\n            </div>\r\n<!--            <span class=\"validate-error\" v-if=\":class=\"{'is-invalid': v$.formItems.$each[index].field_name.$dirty && v$.formItems.$each[index].field_name.$error}\"\">Це поле не може бути пустим</span>-->\r\n          </div>\r\n          <div class=\"forms-name-add\">\r\n            <div class=\"container-input\">\r\n              <label for=\"Typefield\">Виберіть тип поля</label>\r\n              <select\r\n                  id=\"Typefield\"\r\n                  v-model=\"item.field_type\"\r\n              >\r\n                <option value=\"text\">Довгий текст</option>\r\n                <option value=\"string\">Короткий текст</option>\r\n                <option value=\"boolean\">Так / Ні</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"container-global-form-edit\">\r\n            <button class=\"global-form-edit\" type=\"button\" @click=\"removeFormItem(index)\">\r\n              <img src=\"@/assets/icons/form-minus-white.svg\" alt=\"delete name form\">\r\n              <span class=\"edit-link\">Видалити поле</span>\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div class=\"bank-button-forms\">\r\n        <!-- Кнопка для додавання нового елементу форми -->\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"global-form-edit\" type=\"button\" @click=\"addFormItem\">\r\n            <img src=\"@/assets/icons/more.svg\" alt=\"Add name form\">\r\n            <span class=\"edit-link\">Додати поле</span>\r\n          </button>\r\n        </div>\r\n        <!-- Кнопка для фінального створення шаблону форми -->\r\n        <div class=\"container-global-form-edit create-template\">\r\n          <button class=\"global-form-edit\" type=\"button\" @click=\"submitFormItems\">\r\n            <img src=\"@/assets/icons/form-check-white.svg\" alt=\"Check name form\">\r\n            <span class=\"edit-link\">Створити шаблон</span>\r\n          </button>\r\n        </div>\r\n      </div>\r\n      </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { reactive, ref } from 'vue';\r\nimport apiService from '@/services/apiService';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { required } from '@vuelidate/validators';\r\nimport M from 'materialize-css';\r\nimport router from \"@/router\";\r\nexport default {\r\n  setup() {\r\n    // Реактивний об'єкт для форми\r\n    const form = reactive({\r\n      title: '',\r\n      primaryPollId: '',\r\n      formType: '',\r\n      formItems: [{ field_name: '', field_type: 'text' }],\r\n    });\r\n\r\n    const rules = {\r\n      title: { required }\r\n    };\r\n\r\n    // Використання Vuelidate\r\n    const v$ = useVuelidate(rules, form);\r\n    const createdFormId = ref('');\r\n\r\n    // Методи\r\n    const addFormItem = () => {\r\n      form.formItems.push({ field_name: '', field_type: 'text' });\r\n    };\r\n\r\n    const removeFormItem = (index) => {\r\n      form.formItems.splice(index, 1);\r\n    };\r\n    const handleSubmit = async () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          M.toast({ html: `Ви не авторизовані` });\r\n          return;\r\n        }\r\n\r\n        try {\r\n          const response = await apiService.createCustomForm(token, form.title, form.primaryPollId, form.formType);\r\n          createdFormId.value = response.data.data.id;\r\n          M.toast({ html: `Назву форми успішно задано` });\r\n        } catch (error) {\r\n          console.error('Помилка при створенні форми:', error);\r\n        }\r\n      }\r\n    };\r\n    const submitFormItems = async () =>  {\r\n      const token = localStorage.getItem('token');\r\n      if (createdFormId.value && form.formItems.length) {\r\n        try {\r\n          await apiService.createFormItem(token, createdFormId.value, form.formItems);\r\n          M.toast({ html: `Форма успішно створена` });\r\n          router.push('/bank-info');\r\n        } catch (error) {\r\n          M.toast({ html: `Помилка під час створеня елементів форми` });\r\n        }\r\n      } else {\r\n        M.toast({ html: `Форма не створена або елементи форми відсутні` });\r\n      }\r\n    };\r\n\r\n    return {\r\n      v$,\r\n      form,\r\n      addFormItem,\r\n      removeFormItem,\r\n      handleSubmit,\r\n      submitFormItems,\r\n      createdFormId\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AAqHA,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAK;AACnC,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAO,QAAS,uBAAuB;AAChD,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,OAAOC,MAAK,MAAO,UAAU;AAC7B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN;IACA,MAAMC,IAAG,GAAIR,QAAQ,CAAC;MACpBS,KAAK,EAAE,EAAE;MACTC,aAAa,EAAE,EAAE;MACjBC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,CAAC;QAAEC,UAAU,EAAE,EAAE;QAAEC,UAAU,EAAE;MAAO,CAAC;IACpD,CAAC,CAAC;IAEF,MAAMC,KAAI,GAAI;MACZN,KAAK,EAAE;QAAEL;MAAS;IACpB,CAAC;;IAED;IACA,MAAMY,EAAC,GAAIb,YAAY,CAACY,KAAK,EAAEP,IAAI,CAAC;IACpC,MAAMS,aAAY,GAAIhB,GAAG,CAAC,EAAE,CAAC;;IAE7B;IACA,MAAMiB,WAAU,GAAIA,CAAA,KAAM;MACxBV,IAAI,CAACI,SAAS,CAACO,IAAI,CAAC;QAAEN,UAAU,EAAE,EAAE;QAAEC,UAAU,EAAE;MAAO,CAAC,CAAC;IAC7D,CAAC;IAED,MAAMM,cAAa,GAAKC,KAAK,IAAK;MAChCb,IAAI,CAACI,SAAS,CAACU,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IACjC,CAAC;IACD,MAAME,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/BP,EAAE,CAACQ,KAAK,CAACC,MAAM,CAAC,CAAC;MACjB,IAAI,CAACT,EAAE,CAACQ,KAAK,CAACE,QAAQ,EAAE;QACtB,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVtB,CAAC,CAACyB,KAAK,CAAC;YAAEC,IAAI,EAAG;UAAoB,CAAC,CAAC;UACvC;QACF;QAEA,IAAI;UACF,MAAMC,QAAO,GAAI,MAAM9B,UAAU,CAAC+B,gBAAgB,CAACN,KAAK,EAAEnB,IAAI,CAACC,KAAK,EAAED,IAAI,CAACE,aAAa,EAAEF,IAAI,CAACG,QAAQ,CAAC;UACxGM,aAAa,CAACO,KAAI,GAAIQ,QAAQ,CAACE,IAAI,CAACA,IAAI,CAACC,EAAE;UAC3C9B,CAAC,CAACyB,KAAK,CAAC;YAAEC,IAAI,EAAG;UAA4B,CAAC,C