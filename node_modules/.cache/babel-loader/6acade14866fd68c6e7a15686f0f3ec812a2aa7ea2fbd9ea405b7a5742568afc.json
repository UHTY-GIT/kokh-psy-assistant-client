{"ast":null,"code":"import apiService from '@/services/apiService';\nimport M from 'materialize-css';\nexport default {\n  name: \"AllClient\",\n  data() {\n    return {\n      clients: [] // Масив для зберігання даних клієнтів\n    };\n  },\n  async mounted() {\n    await this.fetchClients();\n  },\n  methods: {\n    async fetchClients() {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getClients(token);\n          if (response && response.data && response.data.data) {\n            this.clients = response.data.data; // Зберігання даних клієнтів у масив\n          }\n        }\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n        M.toast({\n          html: `Увійдіть у систему`\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["apiService","M","name","data","clients","mounted","fetchClients","methods","token","localStorage","getItem","response","getClients","error","console","toast","html"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\AllClientPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"client-header\">\r\n      <button class=\"btn-add-client\">\r\n        Додати клієнта\r\n      </button>\r\n      <button class=\"btn-refresh\">\r\n        <img src=\"@/assets/icons/refresh.svg\" alt=\"Оновити\">\r\n      </button>\r\n    </div>\r\n    <div class=\"search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Ім'я</th>\r\n          <th>Номер телефону</th>\r\n          <th>Прийняв згоду</th>\r\n          <th>Первинне оцінювання</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"client in clients\" :key=\"client.telegram_id\">\r\n          <td>{{ client.name }}</td>\r\n          <td>{{ client.phone }}</td>\r\n          <td>{{ client.was_agreed ? 'так' : 'ні' }}</td>\r\n          <td>{{ client.primary_poll_complete ? 'так' : 'ні' }}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\" data-tooltip=\"Надіслати повідомлення\">\r\n              <img src=\"@/assets/icons/send-template-white.svg\" alt=\"Надіслати повідомлення\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Переглянути\">\r\n              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Редагувати\">\r\n              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Видалити\">\r\n              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">\r\n            </button>\r\n          </td>\r\n\r\n        </tr>\r\n<!--        <tr>-->\r\n<!--          <td>Клієнт Іван</td>-->\r\n<!--          <td>+38095925237</td>-->\r\n<!--          <td>так</td>-->\r\n<!--          <td>так</td>-->\r\n<!--          <td class=\"all-butt-management\">-->\r\n<!--            <button class=\"btn-action\">-->\r\n<!--              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">-->\r\n<!--            </button>-->\r\n<!--            <button class=\"btn-action\">-->\r\n<!--              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">-->\r\n<!--            </button>-->\r\n<!--            <button class=\"btn-action\">-->\r\n<!--              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">-->\r\n<!--            </button>-->\r\n<!--          </td>-->\r\n<!--        </tr>-->\r\n\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport M from 'materialize-css';\r\nexport default {\r\n  name: \"AllClient\",\r\n  data() {\r\n    return {\r\n      clients: [], // Масив для зберігання даних клієнтів\r\n    };\r\n  },\r\n  async mounted() {\r\n    await this.fetchClients();\r\n  },\r\n  methods: {\r\n    async fetchClients() {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getClients(token);\r\n          if (response && response.data && response.data.data) {\r\n            this.clients = response.data.data; // Зберігання даних клієнтів у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n        M.toast({ html: `Увійдіть у систему` });\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n<style>\r\n.btn-action {\r\n  position: relative;\r\n}\r\n\r\n.btn-action[data-tooltip]:hover::after {\r\n  content: attr(data-tooltip);\r\n  position: absolute;\r\n  bottom: 100%;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  background-color: #333;\r\n  color: #fff;\r\n  padding: 5px 10px;\r\n  border-radius: 4px;\r\n  white-space: nowrap;\r\n  z-index: 1000;\r\n  /* Додайте наступні властивості для покращення візуального вигляду */\r\n  opacity: 0;\r\n  visibility: hidden;\r\n  transition: opacity 0.2s, visibility 0.2s;\r\n}\r\n\r\n.btn-action[data-tooltip]:hover::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 100%;\r\n  left: 50%;\r\n  transform: translateX(-50%) translateY(-5px);\r\n  border-width: 5px;\r\n  border-style: solid;\r\n  border-color: #333 transparent transparent transparent;\r\n  /* Додайте наступні властивості для покращення візуального вигляду */\r\n  transition: opacity 0.2s, visibility 0.2s;\r\n}\r\n\r\n.btn-action[data-tooltip]:hover::after,\r\n.btn-action[data-tooltip]:hover::before {\r\n  opacity: 1;\r\n  visibility: visible;\r\n}\r\n\r\n</style>"],"mappings":"AAgFA,OAAOA,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,EAAE,CAAE;IACf,CAAC;EACH,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACC,YAAY,CAAC,CAAC;EAC3B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAME,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;QAC7C,IAAIF,KAAK,EAAE;UACT,MAAMG,QAAO,GAAI,MAAMX,UAAU,CAACY,UAAU,CAACJ,KAAK,CAAC;UACnD,IAAIG,QAAO,IAAKA,QAAQ,CAACR,IAAG,IAAKQ,QAAQ,CAACR,IAAI,CAACA,IAAI,EAAE;YACnD,IAAI,CAACC,OAAM,GAAIO,QAAQ,CAACR,IAAI,CAACA,IAAI,EAAE;UACrC;QACF;MACF,EAAE,OAAOU,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;QAC/CZ,CAAC,CAACc,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAoB,CAAC,CAAC;MACzC;IACF;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}