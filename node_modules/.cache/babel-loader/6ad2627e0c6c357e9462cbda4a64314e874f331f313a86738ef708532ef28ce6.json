{"ast":null,"code":"import \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport apiService from \"@/services/apiService\";\nexport default {\n  data() {\n    return {\n      formFields: [],\n      clientId: null,\n      templateId: null\n    };\n  },\n  created() {\n    const queryParams = new URLSearchParams(window.location.search);\n    this.clientId = queryParams.get('client');\n    this.templateId = queryParams.get('template');\n    this.fetchFormData();\n  },\n  methods: {\n    async fetchFormData() {\n      if (this.templateId) {\n        try {\n          const response = await apiService.getCustomFormById(this.templateId);\n          console.log(response);\n        } catch (error) {\n          console.error('Error fetching form data:', error);\n          // Обробіть помилку\n        }\n      }\n    },\n    async submitForm() {\n      // Логіка для обробки надсилання форми\n      console.log('Форма надіслана:', this.formFields);\n      // Тут ви можете зробити запит POST до вашого API з даними форми\n    }\n  }\n};","map":{"version":3,"names":["apiService","data","formFields","clientId","templateId","created","queryParams","URLSearchParams","window","location","search","get","fetchFormData","methods","response","getCustomFormById","console","log","error","submitForm"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\form\\SendFormPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"send-form-page\">\r\n    <h1>Надіслати форму</h1>\r\n    <form v-if=\"formFields.length > 0\" @submit.prevent=\"submitForm\">\r\n      <div v-for=\"(field, index) in formFields\" :key=\"index\">\r\n        <label :for=\"`field-${index}`\">{{ field.field_name }}</label>\r\n        <input v-if=\"field.field_type !== 'boolean'\" :id=\"`field-${index}`\" type=\"text\" v-model=\"field.value\"/>\r\n        <label v-else :for=\"`field-${index}`\">\r\n          <input :id=\"`field-${index}`\" type=\"checkbox\" v-model=\"field.value\"> Так\r\n        </label>\r\n      </div>\r\n      <button type=\"submit\">Надіслати</button>\r\n    </form>\r\n    <div v-else>\r\n      <p>Завантаження форми...</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      formFields: [],\r\n      clientId: null,\r\n      templateId: null\r\n    };\r\n  },\r\n  created() {\r\n    const queryParams = new URLSearchParams(window.location.search);\r\n    this.clientId = queryParams.get('client');\r\n    this.templateId = queryParams.get('template');\r\n    this.fetchFormData();\r\n  },\r\n  methods: {\r\n    async fetchFormData() {\r\n      if (this.templateId) {\r\n        try {\r\n          const response = await apiService.getCustomFormById(this.templateId);\r\n          console.log(response)\r\n        } catch (error) {\r\n          console.error('Error fetching form data:', error);\r\n          // Обробіть помилку\r\n        }\r\n      }\r\n    },\r\n    async submitForm() {\r\n      // Логіка для обробки надсилання форми\r\n      console.log('Форма надіслана:', this.formFields);\r\n      // Тут ви можете зробити запит POST до вашого API з даними форми\r\n    }\r\n  }\r\n};\r\n</script>\r\n"],"mappings":";;;AAoBA,OAAOA,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,EAAE;MACdC,QAAQ,EAAE,IAAI;MACdC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAMC,WAAU,GAAI,IAAIC,eAAe,CAACC,MAAM,CAACC,QAAQ,CAACC,MAAM,CAAC;IAC/D,IAAI,CAACP,QAAO,GAAIG,WAAW,CAACK,GAAG,CAAC,QAAQ,CAAC;IACzC,IAAI,CAACP,UAAS,GAAIE,WAAW,CAACK,GAAG,CAAC,UAAU,CAAC;IAC7C,IAAI,CAACC,aAAa,CAAC,CAAC;EACtB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACpB,IAAI,IAAI,CAACR,UAAU,EAAE;QACnB,IAAI;UACF,MAAMU,QAAO,GAAI,MAAMd,UAAU,CAACe,iBAAiB,CAAC,IAAI,CAACX,UAAU,CAAC;UACpEY,OAAO,CAACC,GAAG,CAACH,Q