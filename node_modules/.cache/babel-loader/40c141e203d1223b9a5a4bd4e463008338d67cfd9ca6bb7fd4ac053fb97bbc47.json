{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { reactive, ref } from 'vue';\nimport apiService from '@/services/apiService';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\nimport M from 'materialize-css';\nexport default {\n  setup() {\n    // Реактивний об'єкт для форми\n    const form = reactive({\n      title: '',\n      primaryPollId: '',\n      formItems: [{\n        field_name: '',\n        field_type: 'text'\n      }]\n    });\n\n    // Правила валідації\n    const rules = {\n      title: {\n        required\n      },\n      formItems: {\n        $each: {\n          field_name: {\n            required\n          },\n          field_type: {}\n        }\n      }\n    };\n    // Правила валідації\n    // const rules = {\n    //   form: {\n    //     title: { required },\n    //     formItems: {\n    //       // Валідація кожного елемента форми\n    //       $each: {\n    //         field_name: { required },\n    //         field_type: { required },\n    //       }\n    //     }\n    //   }\n    // };\n\n    // Використання Vuelidate\n    const v$ = useVuelidate(rules, form);\n    const createdFormId = ref('');\n\n    // Методи\n    const addFormItem = () => {\n      form.formItems.push({\n        field_name: '',\n        field_type: 'text'\n      });\n    };\n    const removeFormItem = index => {\n      form.formItems.splice(index, 1);\n    };\n    const handleSubmit = async () => {\n      v$.value.$touch();\n      if (!v$.value.$invalid) {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          alert('Ви не авторизовані');\n          return;\n        }\n        try {\n          const response = await apiService.createCustomForm(token, form.title, form.primaryPollId);\n          createdFormId.value = response.data.data.id;\n          console.log(\"createdFormId.value\" + createdFormId.value);\n          console.log('Форма створена:', response.data);\n        } catch (error) {\n          console.error('Помилка при створенні форми:', error);\n        }\n      }\n    };\n    const submitFormItems = async () => {\n      const token = localStorage.getItem('token');\n      if (createdFormId.value && form.formItems.length) {\n        try {\n          const response = await apiService.createFormItem(token, createdFormId.value, form.formItems);\n          console.log('Елементи форми створені:', response.data.data);\n          M.toast({\n            html: `Форма успішно створена`\n          });\n        } catch (error) {\n          console.error('Помилка при створенні елементів форми:', error);\n          M.toast({\n            html: `Помилка під час створеня`\n          });\n        }\n      } else {\n        alert('Форма не створена або елементи форми відсутні');\n      }\n    };\n    return {\n      v$,\n      form,\n      addFormItem,\n      removeFormItem,\n      handleSubmit,\n      submitFormItems,\n      createdFormId\n    };\n  }\n};","map":{"version":3,"names":["reactive","ref","apiService","useVuelidate","required","M","setup","form","title","primaryPollId","formItems","field_name","field_type","rules","$each","v$","createdFormId","addFormItem","push","removeFormItem","index","splice","handleSubmit","value","$touch","$invalid","token","localStorage","getItem","alert","response","createCustomForm","data","id","console","log","error","submitFormItems","length","createFormItem","toast","html"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\TemplateForm.vue"],"sourcesContent":["<!--template form-->\r\n<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Створити нову форму\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"form-bank-info-container\">\r\n    <!-- Форма для створення шаблону -->\r\n    <form class=\"name-update-form\" @submit.prevent=\"handleSubmit\">\r\n      <div class=\"forms-name-add\">\r\n        <div class=\"container-input\">\r\n          <label for=\"title\">Назва шаблону</label>\r\n          <input\r\n              type=\"text\"\r\n              id=\"title\"\r\n              v-model=\"form.title\"\r\n              :class=\"{ 'is-invalid': v$.title.$dirty && v$.title.required.$invalid }\"\r\n              placeholder=\"Введіть назву шаблону\"\r\n          >\r\n        </div>\r\n        <span class=\"validate-error\" v-if=\"v$.title.$dirty && v$.title.required.$invalid\">Це поле не може бути пустим</span>\r\n      </div>\r\n\r\n      <!--      <button type=\"submit\" class=\"btn-submit\">Задати назву</button>-->\r\n      <div class=\"container-global-form-edit\">\r\n        <button class=\"global-form-edit\" type=\"submit\">\r\n          <img src=\"@/assets/icons/edit-form.svg\" alt=\"Send name form\">\r\n          <span class=\"edit-link\">Задати назву</span>\r\n        </button>\r\n      </div>\r\n    </form>\r\n\r\n    <!-- Умовний рендеринг для додавання елементів форми, якщо форма створена -->\r\n    <div v-if=\"createdFormId\">\r\n\r\n      <label>Додати елемент форми:</label>\r\n      <div class=\"form-items\">\r\n        <!-- Відображення динамічних полів форми -->\r\n        <div\r\n            v-for=\"(item, index) in form.formItems\"\r\n            :key=\"index\"\r\n            class=\"form-item\"\r\n        >\r\n          <div>\r\n            <div class=\"container-input\">\r\n              <label for=\"Namefield\">Назва поля</label>\r\n              <input\r\n                  id=\"Namefield\"\r\n                  type=\"text\"\r\n                  v-model=\"item.field_name\"\r\n                  :class=\"{ 'is-invalid': v$.formItems.$each[index].field_name.$dirty && v$.formItems.$each[index].field_name.$error }\"\r\n                  placeholder=\"Введіть назву для цього поля\"\r\n              >\r\n            </div>\r\n            <span class=\"validate-error\" v-if=\"v$.form.formItems[index].field_name.$dirty && v$.form.formItems[index].field_name.$error\">Це поле не може бути пустим</span>\r\n          </div>\r\n          <div class=\"container-input\">\r\n            <label for=\"Typefield\">Виберіть тип поля</label>\r\n            <select\r\n                id=\"Typefield\"\r\n                v-model=\"item.field_type\"\r\n            >\r\n              <option value=\"text\">Довгий текст</option>\r\n              <option value=\"string\">Короткий текст</option>\r\n              <option value=\"boolean\">Так / Ні</option>\r\n            </select>\r\n          </div>\r\n\r\n          <button type=\"button\" @click=\"removeFormItem(index)\">Remove</button>\r\n        </div>\r\n        <!-- Кнопка для додавання нового елементу форми -->\r\n        <button type=\"button\" @click=\"addFormItem\">Додати поле</button>\r\n      </div>\r\n      <!-- Кнопка для фінального створення шаблону форми -->\r\n      <button type=\"button\" @click=\"submitFormItems\" class=\"btn-submit\">Створити шаблон</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { reactive, ref } from 'vue';\r\nimport apiService from '@/services/apiService';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { required } from '@vuelidate/validators';\r\nimport M from 'materialize-css';\r\nexport default {\r\n  setup() {\r\n    // Реактивний об'єкт для форми\r\n    const form = reactive({\r\n      title: '',\r\n      primaryPollId: '',\r\n      formItems: [{ field_name: '', field_type: 'text' }],\r\n    });\r\n\r\n    // Правила валідації\r\n    const rules = {\r\n      title: { required },\r\n      formItems: {\r\n        $each: {\r\n          field_name: { required },\r\n          field_type: {}\r\n        },\r\n      },\r\n    };\r\n    // Правила валідації\r\n    // const rules = {\r\n    //   form: {\r\n    //     title: { required },\r\n    //     formItems: {\r\n    //       // Валідація кожного елемента форми\r\n    //       $each: {\r\n    //         field_name: { required },\r\n    //         field_type: { required },\r\n    //       }\r\n    //     }\r\n    //   }\r\n    // };\r\n\r\n    // Використання Vuelidate\r\n    const v$ = useVuelidate(rules, form);\r\n    const createdFormId = ref('');\r\n\r\n    // Методи\r\n    const addFormItem = () => {\r\n      form.formItems.push({ field_name: '', field_type: 'text' });\r\n    };\r\n\r\n    const removeFormItem = (index) => {\r\n      form.formItems.splice(index, 1);\r\n    };\r\n    const handleSubmit = async () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          alert('Ви не авторизовані');\r\n          return;\r\n        }\r\n\r\n        try {\r\n          const response = await apiService.createCustomForm(token, form.title, form.primaryPollId);\r\n          createdFormId.value = response.data.data.id;\r\n          console.log(\"createdFormId.value\" + createdFormId.value)\r\n          console.log('Форма створена:', response.data);\r\n        } catch (error) {\r\n          console.error('Помилка при створенні форми:', error);\r\n        }\r\n      }\r\n    };\r\n    const submitFormItems = async () =>  {\r\n      const token = localStorage.getItem('token');\r\n      if (createdFormId.value && form.formItems.length) {\r\n        try {\r\n          const response = await apiService.createFormItem(token, createdFormId.value, form.formItems);\r\n          console.log('Елементи форми створені:', response.data.data);\r\n          M.toast({ html: `Форма успішно створена` });\r\n\r\n        } catch (error) {\r\n          console.error('Помилка при створенні елементів форми:', error);\r\n          M.toast({ html: `Помилка під час створеня` });\r\n        }\r\n      } else {\r\n        alert('Форма не створена або елементи форми відсутні');\r\n      }\r\n    };\r\n\r\n    return {\r\n      v$,\r\n      form,\r\n      addFormItem,\r\n      removeFormItem,\r\n      handleSubmit,\r\n      submitFormItems,\r\n      createdFormId\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AAoFA,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAK;AACnC,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAO,QAAS,uBAAuB;AAChD,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN;IACA,MAAMC,IAAG,GAAIP,QAAQ,CAAC;MACpBQ,KAAK,EAAE,EAAE;MACTC,aAAa,EAAE,EAAE;MACjBC,SAAS,EAAE,CAAC;QAAEC,UAAU,EAAE,EAAE;QAAEC,UAAU,EAAE;MAAO,CAAC;IACpD,CAAC,CAAC;;IAEF;IACA,MAAMC,KAAI,GAAI;MACZL,KAAK,EAAE;QAAEJ;MAAS,CAAC;MACnBM,SAAS,EAAE;QACTI,KAAK,EAAE;UACLH,UAAU,EAAE;YAAEP;UAAS,CAAC;UACxBQ,UAAU,EAAE,CAAC;QACf;MACF;IACF,CAAC;IACD;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;IACA;;IAEA;IACA,MAAMG,EAAC,GAAIZ,YAAY,CAACU,KAAK,EAAEN,IAAI,CAAC;IACpC,MAAMS,aAAY,GAAIf,GAAG,CAAC,EAAE,CAAC;;IAE7B;IACA,MAAMgB,WAAU,GAAIA,CAAA,KAAM;MACxBV,IAAI,CAACG,SAAS,CAACQ,IAAI,CAAC;QAAEP,UAAU,EAAE,EAAE;QAAEC,UAAU,EAAE;MAAO,CAAC,CAAC;IAC7D,CAAC;IAED,MAAMO,cAAa,GAAKC,KAAK,IAAK;MAChCb,IAAI,CAACG,SAAS,CAACW,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IACjC,CAAC;IACD,MAAME,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/BP,EAAE,CAACQ,KAAK,CAACC,MAAM,CAAC,CAAC;MACjB,IAAI,CAACT,EAAE,CAACQ,KAAK,CAACE,QAAQ,EAAE;QACtB,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVG,KAAK,CAAC,oBAAoB,CAAC;UAC3B;QACF;QAEA,IAAI;UACF,MAAMC,QAAO,GAAI,MAAM5B,UAAU,CAAC6B,gBAAgB,CAACL,KAAK,EAAEnB,IAAI,CAACC,KAAK,EAAED,IAAI,CAACE,aAAa,CAAC;UACzFO,aAAa,CAACO,KAAI,GAAIO,QAAQ,CAACE,IAAI,CAACA,IAAI,CAACC,EAAE;UAC3CC,OAAO,CAACC,GAAG,CAAC,qBAAoB,GAAInB,aAAa,CAACO,KAAK;UACvDW,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAEL,QAAQ,CAACE,IAAI,CAAC;QAC/C,EAAE,OAAOI,KAAK,EAAE;UACdF,OAAO,CAACE,KAAK,CAAC,8BAA8B,EAAEA,KAAK,CAAC;QACtD;MACF;IACF,CAAC;IACD,MAAMC,eAAc,GAAI,MAAAA,CAAA,KAAa;MACnC,MAAMX,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;MAC3C,IAAIZ,aAAa,CAACO,KAAI,IAAKhB,IAAI,CAACG,SAAS,CAAC4B,MAAM,EAAE;QAChD,IAAI;UACF,MAAMR,QAAO,GAAI,MAAM5B,UAAU,CAACqC,cAAc,CAACb,KAAK,EAAEV,aAAa,CAACO,KAAK,EAAEhB,IAAI,CAACG,SAAS,CAAC;UAC5FwB,OAAO,CAACC,GAAG,CAAC,0BAA0B,EAAEL,QAAQ,CAACE,IAA