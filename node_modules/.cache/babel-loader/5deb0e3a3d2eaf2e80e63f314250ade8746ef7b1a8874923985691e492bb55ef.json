{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport useVuelidate from '@vuelidate/core';\nimport { required, email, minLength } from '@vuelidate/validators';\nimport { useRouter } from \"vue-router\";\nimport messages from \"@/utils/messages\";\nimport apiService from '@/services/apiService';\nimport M from 'materialize-css';\nexport default {\n  name: 'loginPage',\n  setup() {\n    const token = localStorage.removeItem('token');\n    console.log(\"token now \" + token);\n    const email = ref('');\n    const password = ref('');\n    const router = useRouter(); // Переміщено сюди з submitHandler\n    const v$ = useVuelidate(); // Визначено тут для спрощення\n    const submitHandler = async () => {\n      if (v$.value.$invalid) {\n        v$.value.$touch();\n        console.log(\"click to submitHandler\");\n        return;\n      }\n      try {\n        const response = await apiService.loginUser(email.value, password.value);\n        console.log(response.data.token);\n        // Додати перевірку на наявність response.data і response.data.data перед доступом до token\n        if (response.data && response.data.token) {\n          localStorage.setItem('token', response.data.token);\n          router.push('/');\n        }\n        console.log(response.error);\n      } catch (error) {\n        console.error(\"Помилка під час спроби входу:\", error);\n        if (error.response && error.response.status === 409) {\n          // Перевіряємо, чи помилка містить конкретне повідомлення\n          const isIncorrectCredentials = error.response.data.error.some(err => err.message === \"email or password is incorrect\");\n          if (isIncorrectCredentials) {\n            // Виводимо повідомлення про невірний логін або пароль\n            M.toast({\n              html: 'Введено невірно логін або пароль'\n            });\n          } else {\n            // Виводимо повідомлення про інші помилки, які можуть бути у відповіді\n            error.response.data.error.forEach(err => {\n              M.toast({\n                html: `[Помилка]: ${err.message || \"Невідома помилка\"}`\n              });\n            });\n          }\n        } else {\n          // Виводимо інші помилки, які не стосуються відповіді API\n          M.toast({\n            html: `[Помилка]: ${error.message || \"Невідома помилка\"}`\n          });\n        }\n      }\n    };\n\n    // Реактивний стан для перевірки видимості пароля\n    const isPasswordVisible = ref(false);\n    const passwordIconClass = ref('fas fa-eye-slash'); // Додано реактивний об'єкт для зміни іконки\n\n    // Функція переключення видимості пароля\n    const togglePassword = () => {\n      isPasswordVisible.value = !isPasswordVisible.value;\n      if (isPasswordVisible.value) {\n        passwordIconClass.value = 'fas fa-eye';\n      } else {\n        passwordIconClass.value = 'fas fa-eye-slash';\n      }\n    };\n    return {\n      v$,\n      submitHandler,\n      // Повертаємо функцію з setup\n      isPasswordVisible,\n      togglePassword,\n      passwordIconClass,\n      email,\n      password\n    };\n  },\n  validations() {\n    return {\n      email: {\n        required,\n        email\n      },\n      password: {\n        required,\n        minLength: minLength(6)\n      } // припустимо, мінімальна довжина пароля - 6 символів\n    };\n  },\n  mounted() {\n    //повідомлення про вихід з системи переться по ключу з get запиту\n    if (messages[this.$route.query.message]) {\n      this.$message(messages[this.$route.query.message]);\n    }\n  }\n};","map":{"version":3,"names":["ref","useVuelidate","required","email","minLength","useRouter","messages","apiService","M","name","setup","token","localStorage","removeItem","console","log","password","router","v$","submitHandler","value","$invalid","$touch","response","loginUser","data","setItem","push","error","status","isIncorrectCredentials","some","err","message","toast","html","forEach","isPasswordVisible","passwordIconClass","togglePassword","validations","mounted","$route","query","$message"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"background-login\">\r\n    <div class=\"empty-layout\">\r\n      <div class=\"elipse_login_1\"></div>\r\n      <div class=\"elipse_login_2\"></div>\r\n      <form class=\"card auth-card\" @submit.prevent=\"submitHandler\">\r\n        <div class=\"card-content\">\r\n          <span class=\"card-title\">Psy Assistant</span>\r\n          <div class=\"input-field\">\r\n            <!--            .trim видаляє лишні пробіли\r\n                            $dirty валідація буде якщо користувач вже шось роби в у полі\r\n            -->\r\n            <input\r\n                id=\"email\"\r\n                type=\"text\"\r\n                v-model.trim=\"email\"\r\n                :class=\"{\r\n                  invalid: (v$.email.$dirty && v$.email.required.$invalid) || (v$.email.$dirty && v$.email.email.$invalid),\r\n                  validate: v$.email.$dirty && !v$.email.required.$invalid && !v$.email.email.$invalid\r\n                }\"\r\n            >\r\n            <label for=\"email\">E-mail</label>\r\n            <small\r\n                class=\"helper-text invalid\"\r\n                v-if=\"v$.email.$dirty && v$.email.required.$invalid\"\r\n            >Поле E-mail не може бути пустим</small>\r\n            <small\r\n                class=\"helper-text invalid\"\r\n                v-else-if=\"v$.email.$dirty && v$.email.email.$invalid\"\r\n            >Введіть коректний E-mail</small>\r\n          </div>\r\n          <div class=\"input-field\">\r\n            <input\r\n                id=\"password\"\r\n                :type=\"isPasswordVisible ? 'text' : 'password'\"\r\n                v-model.trim=\"password\"\r\n                :class=\"{\r\n                  invalid: (v$.password.$dirty && v$.password.required.$invalid) || (v$.password.$dirty && !v$.password.minLength.$invalid),\r\n                  validate: v$.password.$dirty && !v$.password.required.$invalid && !v$.password.minLength.$invalid\r\n                }\"\r\n            >\r\n            <label for=\"password\">Пароль</label>\r\n            <small\r\n                class=\"helper-text invalid\"\r\n                v-if=\"v$.password.$dirty && v$.password.required.$invalid\"\r\n            >Введіть пароль</small>\r\n            <small\r\n                class=\"helper-text invalid\"\r\n                v-else-if=\"v$.password.$dirty && v$.password.minLength.$invalid\"\r\n            >Пароль повинен бути {{ v$.password.minLength.$params.min }} символів. Зараз він {{password.length}}</small>\r\n            <i class=\"toggle-password\" :class=\"passwordIconClass\" @click=\"togglePassword\"></i>\r\n          </div>\r\n        </div>\r\n        <div class=\"card-action\">\r\n          <div class=\"butt_login\">\r\n            <button\r\n                class=\"btn auth-submit\"\r\n                type=\"submit\"\r\n            >\r\n              Увійти\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n\r\n<script>\r\nimport { ref } from 'vue';\r\nimport useVuelidate from '@vuelidate/core'\r\nimport { required, email, minLength } from '@vuelidate/validators'\r\nimport {useRouter} from \"vue-router\";\r\nimport messages from \"@/utils/messages\";\r\nimport apiService from '@/services/apiService';\r\nimport M from 'materialize-css';\r\n\r\nexport default {\r\n  name: 'loginPage',\r\n  setup () {\r\n    const token = localStorage.removeItem('token');\r\n    console.log(\"token now \" + token);\r\n\r\n    const email = ref('');\r\n    const password = ref('');\r\n    const router = useRouter(); // Переміщено сюди з submitHandler\r\n    const v$ = useVuelidate(); // Визначено тут для спрощення\r\n    const submitHandler = async () => {\r\n      if (v$.value.$invalid) {\r\n        v$.value.$touch();\r\n        console.log(\"click to submitHandler\")\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await apiService.loginUser(email.value, password.value);\r\n        console.log(response.data.token);\r\n        // Додати перевірку на наявність response.data і response.data.data перед доступом до token\r\n        if (response.data && response.data.token) {\r\n          localStorage.setItem('token', response.data.token);\r\n          router.push('/');\r\n        }\r\n        console.log(response.error)\r\n      } catch (error) {\r\n        console.error(\"Помилка під час спроби входу:\", error);\r\n\r\n        if (error.response && error.response.status === 409) {\r\n          // Перевіряємо, чи помилка містить конкретне повідомлення\r\n          const isIncorrectCredentials = error.response.data.error.some(\r\n              (err) => err.message === \"email or password is incorrect\"\r\n          );\r\n\r\n          if (isIncorrectCredentials) {\r\n            // Виводимо повідомлення про невірний логін або пароль\r\n            M.toast({html: 'Введено невірно логін або пароль'});\r\n          } else {\r\n            // Виводимо повідомлення про інші помилки, які можуть бути у відповіді\r\n            error.response.data.error.forEach((err) => {\r\n              M.toast({html: `[Помилка]: ${err.message || \"Невідома помилка\"}`});\r\n            });\r\n          }\r\n        } else {\r\n          // Виводимо інші помилки, які не стосуються відповіді API\r\n          M.toast({html: `[Помилка]: ${error.message || \"Невідома помилка\"}`});\r\n        }\r\n      }\r\n    }\r\n\r\n    // Реактивний стан для перевірки видимості пароля\r\n    const isPasswordVisible = ref(false);\r\n\r\n    const passwordIconClass = ref('fas fa-eye-slash'); // Додано реактивний об'єкт для зміни іконки\r\n\r\n    // Функція переключення видимості пароля\r\n    const togglePassword = () => {\r\n      isPasswordVisible.value = !isPasswordVisible.value;\r\n      if (isPasswordVisible.value) {\r\n        passwordIconClass.value = 'fas fa-eye';\r\n      } else {\r\n        passwordIconClass.value = 'fas fa-eye-slash';\r\n      }\r\n    }\r\n\r\n    return {\r\n      v$,\r\n      submitHandler, // Повертаємо функцію з setup\r\n      isPasswordVisible,\r\n      togglePassword,\r\n      passwordIconClass,\r\n      email,\r\n      password,\r\n    }\r\n  },\r\n  validations () {\r\n    return {\r\n      email: { required, email },\r\n      password: { required, minLength: minLength(6) } // припустимо, мінімальна довжина пароля - 6 символів\r\n    }\r\n  },\r\n  mounted() {\r\n    //повідомлення про вихід з системи переться по ключу з get запиту\r\n    if (messages[this.$route.query.message]) {\r\n      this.$message(messages[this.$route.query.message])\r\n    }\r\n  }\r\n}\r\n\r\n</script>"],"mappings":";AAsEA,SAASA,GAAE,QAAS,KAAK;AACzB,OAAOC,YAAW,MAAO,iBAAgB;AACzC,SAASC,QAAQ,EAAEC,KAAK,EAAEC,SAAQ,QAAS,uBAAsB;AACjE,SAAQC,SAAS,QAAO,YAAY;AACpC,OAAOC,QAAO,MAAO,kBAAkB;AACvC,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,CAAA,MAAO,iBAAiB;AAE/B,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAIA,CAAA,EAAK;IACP,MAAMC,KAAI,GAAIC,YAAY,CAACC,UAAU,CAAC,OAAO,CAAC;IAC9CC,OAAO,CAACC,GAAG,CAAC,YAAW,GAAIJ,KAAK,CAAC;IAEjC,MAAMR,KAAI,GAAIH,GAAG,CAAC,EAAE,CAAC;IACrB,MAAMgB,QAAO,GAAIhB,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMiB,MAAK,GAAIZ,SAAS,CAAC,CAAC,EAAE;IAC5B,MAAMa,EAAC,GAAIjB,YAAY,CAAC,CAAC,EAAE;IAC3B,MAAMkB,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAID,EAAE,CAACE,KAAK,CAACC,QAAQ,EAAE;QACrBH,EAAE,CAACE,KAAK,CAACE,MAAM,CAAC,CAAC;QACjBR,OAAO,CAACC,GAAG,CAAC,wBAAwB;QACpC;MACF;MAEA,IAAI;QACF,MAAMQ,QAAO,GAAI,MAAMhB,UAAU,CAACiB,SAAS,CAACrB,KAAK,CAACiB,KAAK,EAAEJ,QAAQ,CAACI,KAAK,CAAC;QACxEN,OAAO,CAACC,GAAG,CAACQ,QAAQ,CAACE,IAAI,CAACd,KAAK,CAAC;QAChC;QACA,IAAIY,QAAQ,CAACE,IAAG,IAAKF,QAAQ,CAACE,IAAI,CAACd,KAAK,EAAE;UACxCC,YAAY,CAACc,OAAO,CAAC,OAAO,EAAEH,QAAQ,CAACE,IAAI,CAACd,KAAK,CAAC;UAClDM,MAAM,CAACU,IAAI,CAAC,GAAG,CAAC;QAClB;QACAb,OAAO,CAACC,