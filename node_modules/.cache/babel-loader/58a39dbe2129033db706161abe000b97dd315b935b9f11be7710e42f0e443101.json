{"ast":null,"code":"import calendarIcon from '@/assets/icons/calendar.svg';\nimport mySessionIcon from '@/assets/icons/checklist.svg';\nimport clientsIcon from '@/assets/icons/users-avatar.svg';\nimport supportIcon from '@/assets/icons/handshake.svg';\nimport bankInformationIcon from '@/assets/icons/info.svg';\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\nexport default {\n  name: 'SideBar',\n  data: () => ({\n    links: [{\n      title: 'Календар',\n      url: '/',\n      icon: calendarIcon\n    }, {\n      title: 'Мої сесії',\n      url: '/allpodcast',\n      exact: true,\n      icon: mySessionIcon\n    }, {\n      title: 'Клієнти',\n      url: '/podcast',\n      exact: true,\n      icon: clientsIcon\n    }, {\n      title: 'Підтримка',\n      url: '/saved',\n      exact: true,\n      icon: supportIcon\n    }, {\n      title: 'Банк інфомації',\n      url: '/categories',\n      exact: true,\n      icon: bankInformationIcon\n    }]\n  })\n};","map":{"version":3,"names":["calendarIcon","mySessionIcon","clientsIcon","supportIcon","bankInformationIcon","ref","computed","onMounted","onUnmounted","name","data","links","title","url","icon","exact"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\app\\SideBar.vue"],"sourcesContent":["<template>\r\n  <div class=\"sidebar\">\r\n    <div class=\"upper-block\">\r\n      <div class=\"clock-block\">\r\n        <div class=\"flip-clock\">\r\n          <div class=\"number number-hours\">{{ formattedTime.hours }}</div>\r\n          <div class=\"divider\">:</div>\r\n          <div class=\"number number-minutes\">{{ formattedTime.minutes }}</div>\r\n        </div>\r\n        <div class=\"timezone\">Timezone: {{ timezone }}</div>\r\n      </div>\r\n      <div class=\"block-navigation\">\r\n        <div class=\"title-navigation\">\r\n          <img class=\"menu-icon\" src=\"@/assets/icons/House%20With%20Garden.svg\" alt=\"icon Home\">\r\n          <span>Навігація</span>\r\n        </div>\r\n        <nav>\r\n          <ul class=\"menu ul\">\r\n            <router-link\r\n                v-for=\"link in links\"\r\n                :key=\"link.url\"\r\n                :to=\"link.url\"\r\n\r\n                active-class=\"active\"\r\n                custom\r\n                v-slot=\"{ navigate, isActive }\"\r\n            >\r\n              <li\r\n                  class=\"menu-item\"\r\n                  :class=\"{ 'active': isActive }\"\r\n                  @click=\"navigate\"\r\n              >\r\n                <img :src=\"link.icon\" :alt=\"`${link.title} icon`\">\r\n                <span>{{ link.title }}</span>\r\n              </li>\r\n            </router-link>\r\n          </ul>\r\n        </nav>\r\n      </div>\r\n    </div>\r\n    <div class=\"under-block\">\r\n      <div class=\"title-notification\">\r\n        <img class=\"menu-icon\" src=\"@/assets/icons/Speech%20Balloon.svg\" alt=\"icon Notification\">\r\n        <span>Примітка</span>\r\n      </div>\r\n      <div class=\"button-add-notf\">\r\n        <button class=\"btn\">\r\n          <img src=\"@/assets/icons/more.svg\" alt=\"icon add\">\r\n          <span>Додати примітку</span>\r\n        </button>\r\n      </div>\r\n      <div class=\"block-notification\">\r\n        <div class=\"notification-text\">\r\n          <img src=\"@/assets/icons/edit.svg\" alt=\"icon edit\">\r\n          <span>Не забути перевірити нові оновлення в розділі \"Календар\"!</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport calendarIcon from '@/assets/icons/calendar.svg';\r\nimport mySessionIcon from '@/assets/icons/checklist.svg';\r\nimport clientsIcon from '@/assets/icons/users-avatar.svg';\r\nimport supportIcon from '@/assets/icons/handshake.svg';\r\nimport bankInformationIcon from '@/assets/icons/info.svg';\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\r\nexport default {\r\n  name: 'SideBar',\r\n  data: () => ({\r\n    links: [\r\n      { title: 'Календар', url: '/', icon: calendarIcon },\r\n      { title: 'Мої сесії', url: '/allpodcast', exact: true, icon: mySessionIcon },\r\n      { title: 'Клієнти', url: '/podcast', exact: true, icon: clientsIcon },\r\n      { title: 'Підтримка', url: '/saved', exact: true, icon: supportIcon },\r\n      { title: 'Банк інфомації', url: '/categories', exact: true, icon: bankInformationIcon },\r\n    ],\r\n  }),\r\n\r\n}\r\n</script>"],"mappings":"AA6DA,OAAOA,YAAW,MAAO,6BAA6B;AACtD,OAAOC,aAAY,MAAO,8BAA8B;AACxD,OAAOC,WAAU,MAAO,iCAAiC;AACzD,OAAOC,WAAU,MAAO,8BAA8B;AACtD,OAAOC,mBAAkB,MAAO,yBAAyB;AACzD,SAASC,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AAC3D,eAAe;EACbC,IAAI,EAAE,SAAS;EACfC,IAAI,EAAEA,CAAA,MAAO;IACXC,KAAK,EAAE,CACL;MAAEC,KAAK,EAAE,UAAU;MAAEC,GAAG,EAAE,GAAG;MAAEC,IAAI,EAAEd;IAAa,CAAC,EACnD;MAAEY,KAAK,EAAE,WAAW;MAAEC,GAAG,EAAE,aAAa;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEb;IAAc,CAAC,EAC5E;MAAEW,KAAK,EAAE,SAAS;MAAEC,GAAG,EAAE,UAAU;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEZ;IAAY,CAAC,EACrE;MAAEU,KAAK,EAAE,WAAW;MAAEC,GAAG,EAAE,QAAQ;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEX;IAAY,CAAC,EACrE;MAAES,KAAK,EAAE,gBAAgB;MAAEC,GAAG,EAAE,aAAa;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEV;IAAoB,CAAC;EAE3F,CAAC;AAEH"},"metadata":{},"sourceType":"module","externalDependencies":[]}