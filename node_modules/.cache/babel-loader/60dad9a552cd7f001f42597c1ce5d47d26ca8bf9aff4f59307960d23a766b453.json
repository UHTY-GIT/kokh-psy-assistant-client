{"ast":null,"code":"import M from 'materialize-css';\nexport default {\n  props: {\n    templates: Array,\n    showModal: Boolean,\n    selectedClientId: Number\n  },\n  data() {\n    return {\n      selectedTemplateId: '' // Додано змінну для зберігання вибраного ID шаблону\n    };\n  },\n  methods: {\n    closeModal() {\n      this.$emit('close'); // Емітуйте подію 'close'\n    },\n    sendTemplate() {\n      if (this.selectedTemplateId && this.selectedClientId) {\n        M.toast({\n          html: `Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.`\n        });\n        M.toast({\n          html: `Шаблон надіслано.`\n        });\n        console.log(`Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.`);\n\n        // Створюємо унікальне посилання\n        const uniqueLink = `http://localhost:8080/send-form?client=${this.selectedClientId}&template=${this.selectedTemplateId}`;\n        console.log('Посилання для відправки:', uniqueLink);\n        // Відкриваємо посилання у новій вкладці\n        window.open(uniqueLink, '_blank');\n        this.closeModal(); // Закриття модального вікна після відправки\n      } else {\n        alert('Будь ласка, виберіть шаблон для відправки.');\n      }\n    }\n  }\n};","map":{"version":3,"names":["M","props","templates","Array","showModal","Boolean","selectedClientId","Number","data","selectedTemplateId","methods","closeModal","$emit","sendTemplate","toast","html","console","log","uniqueLink","window","open","alert"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\modal\\ModalTemplates.vue"],"sourcesContent":["<!--src/components/modal/ModalTemplates.vue-->\r\n<template>\r\n  <div :class=\"{ 'modal-window': true, 'is-active': showModal }\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-close-butt\">\r\n        <img src=\"@/assets/icons/close-modal.svg\" alt=\"close\" @click=\"closeModal\">\r\n      </div>\r\n      <div class=\"modal-content-all\">\r\n        <p>Виберіть шаблон для відправки</p>\r\n        <div class=\"chosen-templates select-field\">\r\n          <div class=\"container-input\">\r\n            <select v-model=\"selectedTemplateId\">\r\n              <option disabled value=\"\">Будь ласка, виберіть шаблон</option>\r\n              <option v-for=\"template in templates\" :value=\"template.id\" :key=\"template.id\">{{ template.title }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"modal-btn\">\r\n            <button class=\"btn-send-templates\" @click=\"sendTemplate\">Надіслати</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport M from 'materialize-css';\r\nexport default {\r\n  props: {\r\n    templates: Array,\r\n    showModal: Boolean,\r\n    selectedClientId: Number,\r\n  },\r\n  data() {\r\n    return {\r\n      selectedTemplateId: '' // Додано змінну для зберігання вибраного ID шаблону\r\n    };\r\n  },\r\n  methods: {\r\n    closeModal() {\r\n      this.$emit('close'); // Емітуйте подію 'close'\r\n    },\r\n    sendTemplate() {\r\n      if (this.selectedTemplateId && this.selectedClientId) {\r\n\r\n        M.toast({ html: `Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.` });\r\n        M.toast({ html: `Шаблон надіслано.` });\r\n        console.log(`Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.`);\r\n\r\n        // Створюємо унікальне посилання\r\n        const uniqueLink = `http://localhost:8080/send-form?client=${this.selectedClientId}&template=${this.selectedTemplateId}`;\r\n        console.log('Посилання для відправки:', uniqueLink);\r\n        // Відкриваємо посилання у новій вкладці\r\n        window.open(uniqueLink, '_blank');\r\n\r\n        this.closeModal(); // Закриття модального вікна після відправки\r\n      } else {\r\n        alert('Будь ласка, виберіть шаблон для відправки.');\r\n      }\r\n    }\r\n  },\r\n};\r\n</script>\r\n<style>\r\n.modal-window {\r\n  position: fixed;\r\n  z-index: 1;\r\n  left: 0;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  overflow: auto;\r\n  background-color: rgb(56 94 108 / 43%);\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: #FDF8F3;\r\n  margin: auto;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  width: 600px;\r\n  color: #494B55;\r\n}\r\n.modal-content-all p {\r\n  font-family: \"Nunito\", sans-serif;\r\n  font-style: normal;\r\n  font-weight: 700;\r\n  font-size: 20px;\r\n  margin: 10px 0 20px;\r\n  text-align: center;\r\n}\r\n.modal-close-butt {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n.modal-close-butt img {\r\n  cursor: pointer;\r\n}\r\n.modal-window.is-active {\r\n  display: flex;\r\n}\r\n.chosen-templates .container-input select {\r\n  width: 100%;\r\n  height: auto !important;\r\n  margin: 0;\r\n  line-height: normal;\r\n  max-width: none;\r\n}\r\n</style>"],"mappings":"AAyBA,OAAOA,CAAA,MAAO,iBAAiB;AAC/B,eAAe;EACbC,KAAK,EAAE;IACLC,SAAS,EAAEC,KAAK;IAChBC,SAAS,EAAEC,OAAO;IAClBC,gBAAgB,EAAEC;EACpB,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,kBAAkB,EAAE,EAAC,CAAE;IACzB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX,IAAI,CAACC,KAAK,CAAC,OAAO,CAAC,EAAE;IACvB,CAAC;IACDC,YAAYA,CAAA,EAAG;MACb,IAAI,IAAI,CAACJ,kBAAiB,IAAK,IAAI,CAACH,gBAAgB,EAAE;QAEpDN,CAAC,CAACc,KAAK,CAAC;UAAEC,IAAI,EAAG,gBAAe,IAAI,CAACN,kBAAkB,yBAAyB,IAAI,CAACH,gBAAiB;QAAG,CAAC,CAAC;QAC3GN,CAAC,CAACc,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAmB,CAAC,CAAC;QACtCC,OAAO,CAACC,GAAG,CAAE,gBAAe,IAAI,CAACR,kBAAkB,yBAAyB,IAAI,CAACH,gBAAiB,GAAE,CAAC;;QAErG;QACA,MAAMY,UAAS,GAAK,0CAAyC,IAAI,CAACZ,gBAAiB,aAAY,IAAI,CAACG,kBAAmB,EAAC;QACxHO,OAAO,CAACC,GAAG,CAAC,0BAA0B,EAAEC,UAAU,CAAC;QACnD;QACAC,MAAM,CAACC,IAAI,CAACF,UAAU,EAAE,QAAQ,CAAC;QAEjC,IAAI,CAACP,UAAU,CAAC,CAAC,EAAE;MACrB,OAAO;QACLU,KAAK,CAAC,4CAA4C,CAAC;MACrD;IACF;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}