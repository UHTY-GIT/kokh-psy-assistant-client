{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport apiService from '@/services/apiService';\nexport default {\n  data() {\n    return {\n      form: {\n        title: '',\n        primaryPollId: '' // Ідентифікатор для первинного опитування, якщо він є\n      },\n      createdFormId: '',\n      // ID створеної форми\n      formItems: [{\n        name: '',\n        type: 'text'\n      }] // Початкове поле форми\n    };\n  },\n  methods: {\n    async handleSubmit() {\n      const token = localStorage.getItem('token');\n      if (!token) {\n        alert('Ви не авторизовані');\n        return;\n      }\n      try {\n        const response = await apiService.createCustomForm(token, this.form.title, this.form.primaryPollId);\n        this.createdFormId = response.data.data.id; // Оновлено, щоб відповідати формату відповіді API\n        console.log(this.createdFormId);\n        console.log('Форма створена:', response.data);\n      } catch (error) {\n        console.error('Помилка при створенні форми:', error);\n      }\n    },\n    addFormItem() {\n      this.formItems.push({\n        field_name: '',\n        field_type: 'text'\n      });\n    },\n    removeFormItem(index) {\n      this.formItems.splice(index, 1);\n    },\n    async submitFormItems() {\n      const token = localStorage.getItem('token');\n      if (this.createdFormId && this.formItems.length) {\n        try {\n          const response = await apiService.createFormItem(token, this.createdFormId, this.formItems);\n          console.log('Елементи форми створені:', response.data.data);\n          // Тут можна обробити успішне створення (наприклад, редірект або вивід повідомлення)\n        } catch (error) {\n          console.error('Помилка при створенні елементів форми:', error);\n          // Тут можна обробити помилку (наприклад, вивід повідомлення користувачеві)\n        }\n      } else {\n        alert('Форма не створена або елементи форми відсутні');\n      }\n    }\n  }\n};","map":{"version":3,"names":["apiService","data","form","title","primaryPollId","createdFormId","formItems","name","type","methods","handleSubmit","token","localStorage","getItem","alert","response","createCustomForm","id","console","log","error","addFormItem","push","field_name","field_type","removeFormItem","index","splice","submitFormItems","length","createFormItem"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\TemplateForm.vue"],"sourcesContent":["<!--template form-->\r\n<template>\r\n  <div class=\"form-container\">\r\n    <!-- Форма для створення шаблону -->\r\n    <form @submit.prevent=\"handleSubmit\">\r\n      <div class=\"form-group\">\r\n        <label for=\"title\">Назва шаблону</label>\r\n        <input type=\"text\" id=\"title\" v-model=\"form.title\" required>\r\n      </div>\r\n      <button type=\"submit\" class=\"btn-submit\">Задати назву</button>\r\n    </form>\r\n\r\n    <!-- Умовний рендеринг для додавання елементів форми, якщо форма створена -->\r\n    <div v-if=\"createdFormId\">\r\n      <label>Додати елемент форми:</label>\r\n      <div class=\"form-items\">\r\n        <!-- Відображення динамічних полів форми -->\r\n        <div v-for=\"(item, index) in formItems\" :key=\"index\" class=\"form-item\">\r\n          <input type=\"text\" v-model=\"item.name\" placeholder=\"Field name\">\r\n          <select v-model=\"item.type\">\r\n            <option value=\"text\">Text</option>\r\n            <option value=\"string\">String</option>\r\n            <option value=\"boolean\">Boolean</option>\r\n          </select>\r\n          <button type=\"button\" @click=\"removeFormItem(index)\">Remove</button>\r\n        </div>\r\n        <!-- Кнопка для додавання нового елементу форми -->\r\n        <button type=\"button\" @click=\"addFormItem\">+</button>\r\n      </div>\r\n      <!-- Кнопка для фінального створення шаблону форми -->\r\n      <button type=\"button\" @click=\"submitFormItems\" class=\"btn-submit\">Створити шаблон</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport apiService from '@/services/apiService';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      form: {\r\n        title: '',\r\n        primaryPollId: '', // Ідентифікатор для первинного опитування, якщо він є\r\n      },\r\n      createdFormId: '', // ID створеної форми\r\n      formItems: [{ name: '', type: 'text' }], // Початкове поле форми\r\n    };\r\n  },\r\n  methods: {\r\n    async handleSubmit() {\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        alert('Ви не авторизовані');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await apiService.createCustomForm(token, this.form.title, this.form.primaryPollId);\r\n        this.createdFormId = response.data.data.id; // Оновлено, щоб відповідати формату відповіді API\r\n        console.log(this.createdFormId)\r\n        console.log('Форма створена:', response.data);\r\n      } catch (error) {\r\n        console.error('Помилка при створенні форми:', error);\r\n      }\r\n    },\r\n    addFormItem() {\r\n      this.formItems.push({ field_name: '', field_type: 'text' });\r\n    },\r\n    removeFormItem(index) {\r\n      this.formItems.splice(index, 1);\r\n    },\r\n    async submitFormItems() {\r\n      const token = localStorage.getItem('token');\r\n      if (this.createdFormId && this.formItems.length) {\r\n        try {\r\n          const response = await apiService.createFormItem(token, this.createdFormId, this.formItems);\r\n          console.log('Елементи форми створені:', response.data.data);\r\n          // Тут можна обробити успішне створення (наприклад, редірект або вивід повідомлення)\r\n        } catch (error) {\r\n          console.error('Помилка при створенні елементів форми:', error);\r\n          // Тут можна обробити помилку (наприклад, вивід повідомлення користувачеві)\r\n        }\r\n      } else {\r\n        alert('Форма не створена або елементи форми відсутні');\r\n      }\r\n    },\r\n\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";AAoCA,OAAOA,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,KAAK,EAAE,EAAE;QACTC,aAAa,EAAE,EAAE,CAAE;MACrB,CAAC;MACDC,aAAa,EAAE,EAAE;MAAE;MACnBC,SAAS,EAAE,CAAC;QAAEC,IAAI,EAAE,EAAE;QAAEC,IAAI,EAAE;MAAO,CAAC,CAAC,CAAE;IAC3C,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,YAAYA,CAAA,EAAG;MACnB,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;MAC3C,IAAI,CAACF,KAAK,EAAE;QACVG,KAAK,CAAC,oBAAoB,CAAC;QAC3B;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMf,UAAU,CAACgB,gBAAgB,CAACL,KAAK,EAAE,IAAI,CAACT,IAAI,CAACC,KAAK,EAAE,IAAI,CAACD,IAAI,CAACE,aAAa,CAAC;QACnG,IAAI,CAACC,aAAY,GAAIU,QAAQ,CAACd,IAAI,CAACA,IAAI,CAACgB,EAAE,EAAE;QAC5CC,OAAO,CAACC,GAAG,CAAC,IAAI,CAACd,aAAa;QAC9Ba,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAEJ,QAAQ,CAACd,IAAI,CAAC;MAC/C,EAAE,OAAOmB,KAAK,EAAE;QACdF,OAAO,CAACE,KAAK,CAAC,8BAA8B,EAAEA,KAAK,CAAC;MACtD;IACF,CAAC;IACDC,WAAWA,CAAA,EAAG;MACZ,IAAI,CAACf,SAAS,CAACgB,IAAI,CAAC;QAAEC,UAAU,EAAE,EAAE;QAAEC,UAAU,EAAE;MAAO,CAAC,CAAC;IAC7D,CAAC;IACDC,cAAcA,CAACC,KAAK,EAAE;MACpB,IAAI,CAACpB,SAAS,CAACqB,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IACjC,CAAC;IACD,MAAME,eAAeA,CAAA,EAAG;MACtB,MAAMjB,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;MAC3C,IAAI,IAAI,CAACR,aAAY,IAAK,IAAI,CAACC,SAAS,CAACuB,MAAM,EAAE;QAC/C,IAAI;UACF,MAAMd,QAAO,GAAI,MAAMf,UAAU,CAAC8B,cAAc,CAACnB,KAAK,EAAE,IAAI,CAACN,aAAa,EAAE,IAAI,CAACC,SAAS,CAAC;UAC3FY,OAAO,CAACC,GAAG,CAAC,0BAA0B,EAAEJ,QAAQ,CAACd,IAAI,CAACA,IAAI,CAAC;UAC3D;QACF,EAAE,OAAOmB,KAAK,EAAE;UACdF,OAAO,CAACE,KAAK,CAAC,wCAAwC,EAAEA,KAAK,CAAC;UAC9D;QACF;MACF,OAAO;QACLN,KAAK,CAAC,+CAA+C,CAAC;MACxD;IACF;EAEF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}