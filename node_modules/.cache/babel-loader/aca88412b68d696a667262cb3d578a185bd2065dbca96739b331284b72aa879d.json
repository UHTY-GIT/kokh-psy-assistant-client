{"ast":null,"code":"export default {\n  props: {\n    templates: Array,\n    showModal: Boolean\n  },\n  methods: {\n    closeModal() {\n      this.$emit('close'); // Емітуйте подію 'close'\n    }\n  }\n};","map":{"version":3,"names":["props","templates","Array","showModal","Boolean","methods","closeModal","$emit"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\modal\\ModalTemplates.vue"],"sourcesContent":["<!--src/components/modal/ModalTemplates.vue-->\r\n<template>\r\n  <div :class=\"{ 'modal-window': true }\">\r\n    <div class=\"modal-content\">\r\n      <img src=\"\" alt=\"close\" @click=\"closeModal\">\r\n      <p>Виберіть шаблон для відправки</p>\r\n      <div v-for=\"template in templates\" :key=\"template.id\">\r\n        <button @click=\"sendTemplate(template.id)\">{{ template.title }}</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  props: {\r\n    templates: Array,\r\n    showModal: Boolean\r\n  },\r\n  methods: {\r\n    closeModal() {\r\n      this.$emit('close'); // Емітуйте подію 'close'\r\n    },\r\n  },\r\n};\r\n</script>\r\n<style>\r\n.modal-window {\r\n  display: flex;\r\n  position: fixed;\r\n  z-index: 1;\r\n  left: 0;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  overflow: auto;\r\n  background-color: rgb(56 94 108 / 43%);\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: #FDF8F3;\r\n  margin: auto;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  width: 600px;\r\n}\r\n.modal-content p {\r\n  font-family: \"Nunito\", sans-serif;\r\n  font-style: normal;\r\n  font-weight: 700;\r\n  font-size: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.modal-window.is-active {\r\n  display: block;\r\n}\r\n</style>"],"mappings":"AAaA,eAAe;EACbA,KAAK,EAAE;IACLC,SAAS,EAAEC,KAAK;IAChBC,SAAS,EAAEC;EACb,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX,IAAI,CAACC,KAAK,CAAC,OAAO,CAAC,EAAE;IACvB;EACF;AACF,C