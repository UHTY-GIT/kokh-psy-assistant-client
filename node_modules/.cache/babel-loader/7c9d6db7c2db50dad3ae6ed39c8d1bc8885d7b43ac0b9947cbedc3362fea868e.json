{"ast":null,"code":"import \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { ref, onMounted } from 'vue';\nimport apiService from \"@/services/apiService\";\nexport default {\n  setup() {\n    const formFields = ref([]);\n    const formType = ref([]);\n    const clientId = ref(null);\n    const templateId = ref(null);\n    onMounted(async () => {\n      const queryParams = new URLSearchParams(window.location.search);\n      clientId.value = queryParams.get('client');\n      templateId.value = queryParams.get('template');\n      await fetchFormData();\n    });\n    const fetchFormData = async () => {\n      if (templateId.value) {\n        try {\n          const response = await apiService.getCustomFormById(templateId.value);\n          formFields.value = response.data.data.form_items;\n          formType.value = response.data.data.form_type;\n          console.log(formFields.value);\n          console.log(response.data);\n        } catch (error) {\n          console.error('Error fetching form data:', error);\n          // Обробіть помилку\n        }\n      }\n    };\n    const submitForm = async () => {\n      // Логіка для обробки надсилання форми\n      console.log('Форма надіслана:', formFields.value);\n      // Тут ви можете зробити запит POST до вашого API з даними форми\n    };\n    return {\n      formFields,\n      formType,\n      clientId,\n      templateId,\n      submitForm\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","apiService","setup","formFields","formType","clientId","templateId","queryParams","URLSearchParams","window","location","search","value","get","fetchFormData","response","getCustomFormById","data","form_items","form_type","console","log","error","submitForm"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\form\\SendFormPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"send-form-page\">\r\n    <!-- Рендеринг для типу форми \"primary_poll_individual\" -->\r\n    <div v-if=\"formType === 'primary_poll_individual'\">\r\n      <div class=\"title_form_from_user\">\r\n        <p>\r\n          Інформована  згода клієнта на отримання послуги індивідуального психологічного консультування онлайн\r\n        </p>\r\n      </div>\r\n\r\n\r\n      <!-- спеціальна розмітка для форми пар -->\r\n      <form v-if=\"formFields.length > 0\" @submit.prevent=\"submitForm\">\r\n\r\n        <div class=\"container-text-for-form\">\r\n          <div class=\"title_n_text\">\r\n            <b>Інформована згода психологічного консультування</b>\r\n            <p>\r\n              Цей документ інформує людину, що шукає допомоги у вирішенні психологічних або життєвих труднощів, іменована надалі як «Клієнт / ка», про особливості психологічного консультування та умови надання послуг.\r\n            </p>\r\n          </div>\r\n          <div class=\"content_user_form\">\r\n            <span>Інформація про психолога</span>\r\n            <p>\r\n              Кох Катерина <br>\r\n              Проводжу індивідуальні та парні психологічні консультації, а також індивідуальну та парну терапію. Створюю психологічні ігри для пар. Тренер психологічних курсів, проектів та груп (очно та онлайн)\r\n            </p>\r\n            <span>\r\n              Кваліфікація\r\n            </span>\r\n            <p>\r\n              Бакалавр Практичної  психології, спеціалізація кафедри «Медична психологія та Психофізіологія» (диплом бакалавра з відзнакою)<br>\r\n              Магістр  Практичної психології (диплом магістра з відзнакою)<br>\r\n              Член міжнародної асоціації ICEEFT - International Centre for Excellence in Emotionally Focused Therapy (Канада)<br>\r\n            </p>\r\n            <p>\r\n              Додаткова кваліфікація: перинатальне та сімейне консультування; психосоматика: тілесно орієнтована психотерапія; емоційно-фокусована психотерапія (ICCEFT)\r\n            </p>\r\n            <span>\r\n              Досвід роботи\r\n            </span>\r\n            <p>\r\n              Консультування клієнтів і психотерапія з 2016 року. <br>\r\n              Працюю в емоційно-фокусованому клієнтцентрованому підході.\r\n            </p>\r\n            <span>\r\n              Психологічне консультування\r\n            </span>\r\n            <p>\r\n              Психологічне консультування  - це спеціально організовані відносини, в яких окремі люди, сім'ї (пари) і групи досягають психічного, соціального і загального здоров'я, отримують нові знання і навички. Консультації засновані на ідеї, що зцілення відбувається в безпечних, та таких, що підтримують довірливі відносини, де неефективна поведінка і мислення людини змінюються на більш адаптивне (більш життєздатне). Мета психологічної консультації  - допомога клієнтам досягти їх цілей, поліпшити їх функціонування, особисті відносини, і запропонувати можливість росту та розвитку.\r\n            </p>\r\n            <span>\r\n              Зміст послуги\r\n            </span>\r\n            <p>\r\n              Катерина Кох (іменована далі як Психолог) бере на себе відповідальність допомогти клієнту /тці розібратися з ситуацією, в якій той /та  опинилися, і допомогти знайти внутрішні і зовнішні ресурси для її подолання. Психолог використовує професійні інструменти (методи і способи, якими вона навчалася) для допомоги клієнту /тці, пояснює клієнту /тці їх суть, інформує про їх особливості та можливі наслідки. Клієнт /тка може  не давати згоди на використання того чи іншого методу. Психолог не нав'язує свої духовні і світоглядні погляди клієнту /тці, не критикує і не оцінює клієнта / ку.\r\n            </p>\r\n            <span>\r\n              Терапевтичні зустрічі (сесії/ серія психологічних консультацій)\r\n            </span>\r\n            <p>\r\n              Частота зустрічей терапевта і клієнта / ки визначається за особистою домовленістю. Тривалість однієї зустрічі складає 60 хв (для індивідуального консультування) та 90 хв (для парного консультування). Винятки (наприклад, збільшення часу сесії при травматерапії) обговорюються додатково.\r\n            </p>\r\n            <p>\r\n              Клієнт / ка бере на себе відповідальність приходити або виходити на зв'язок онлайн вчасно. У разі запізнення клієнта / ки, час сесії скорочується (психолог працює з клієнтом / кою той час, що залишився), і сесія/консультація  оплачується повністю.\r\n            </p>\r\n            <p>\r\n              У разі неможливості прийти в призначений час клієнт / ка зобов'язується повідомити про це психолога <b>не менше ніж за 24 години</b> до призначеного йому / їй часу. Тоді психолог зможе віддати цей час іншій людині.\r\n            </p>\r\n            <p>\r\n              Якщо клієнт / ка повідомляє про скасування сесії/ консультації менш, ніж за 24 години або пропускає сесію без попередження, то пропущена (скасований) сесія оплачується повністю, тому що ви зайняли в розкладі місце, яке міг би отримати хтось інший.\r\n            </p>\r\n            <span>\r\n              Зв'язок з психологом\r\n            </span>\r\n            <p>\r\n              Клієнт / ка може писати психологу для узгодження часу наступної зустрічі або роз'яснення домашнього завдання (при його наявності) в\r\n            </p>\r\n          </div>\r\n\r\n        </div>\r\n\r\n        <div v-for=\"(field, index) in formFields\" :key=\"index\">\r\n\r\n          <!-- Для не-boolean типів поля -->\r\n          <div v-if=\"field.field_type !== 'boolean'\" class=\"input-field-text\">\r\n            <div class=\"container-input_froms_user\">\r\n              <label :for=\"`field-${index}`\">{{ field.field_name }}</label>\r\n              <input :id=\"`field-${index}`\" type=\"text\" v-model=\"field.value\" placeholder=\"Ваша відповідь\"/>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Для boolean типів поля -->\r\n          <div v-if=\"field.field_type === 'boolean'\" class=\"checkbox-field\">\r\n            <div class=\"container-input center_group\">\r\n              <div class=\"checkbox-group width-input-1200\">\r\n                <label class=\"custom-checkbox\" :for=\"`field-${index}`\">\r\n                  <input :id=\"`field-${index}`\" type=\"checkbox\" v-model=\"field.value\">\r\n                  <span class=\"checkmark\">\r\n                    <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                      <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                    </svg>\r\n                  </span>\r\n                  <p>{{ field.field_name }}</p>\r\n                </label>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n        </div>\r\n        <div class=\"container-global-form-edit width-container_for_butt\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <span class=\"edit-link\">Надіслати</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n      <div v-else>\r\n        <p>Завантаження форми...</p>\r\n      </div>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n    <!-- Рендеринг для типу форми \"primary_poll_couple\" -->\r\n    <div v-if=\"formType === 'primary_poll_couple'\">\r\n      <!-- спеціальна розмітка для індивідуальної форми -->\r\n      <form v-if=\"formFields.length > 0\" @submit.prevent=\"submitForm\">\r\n        <div v-for=\"(field, index) in formFields\" :key=\"index\">\r\n          <label :for=\"`field-${index}`\">{{ field.field_name }}</label>\r\n          <input v-if=\"field.field_type !== 'boolean'\" :id=\"`field-${index}`\" type=\"text\" v-model=\"field.value\"/>\r\n          <label v-else :for=\"`field-${index}`\">\r\n            <input :id=\"`field-${index}`\" type=\"checkbox\" v-model=\"field.value\"> Так\r\n          </label>\r\n        </div>\r\n        <button type=\"submit\">Надіслати</button>\r\n      </form>\r\n      <div v-else>\r\n        <p>Завантаження форми...</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Рендеринг, коли тип форми не відповідає жодному визначеному варіанту -->\r\n    <div v-if=\"formType !== 'primary_poll_couple' && formType !== 'primary_poll_individual'\">\r\n      <p>Неідентифікований тип форми</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  setup() {\r\n    const formFields = ref([]);\r\n    const formType = ref([]);\r\n    const clientId = ref(null);\r\n    const templateId = ref(null);\r\n\r\n    onMounted(async () => {\r\n      const queryParams = new URLSearchParams(window.location.search);\r\n      clientId.value = queryParams.get('client');\r\n      templateId.value = queryParams.get('template');\r\n      await fetchFormData();\r\n    });\r\n\r\n    const fetchFormData = async () => {\r\n      if (templateId.value) {\r\n        try {\r\n          const response = await apiService.getCustomFormById(templateId.value);\r\n          formFields.value = response.data.data.form_items;\r\n          formType.value = response.data.data.form_type;\r\n          console.log(formFields.value);\r\n          console.log(response.data);\r\n        } catch (error) {\r\n          console.error('Error fetching form data:', error);\r\n          // Обробіть помилку\r\n        }\r\n      }\r\n    };\r\n\r\n    const submitForm = async () => {\r\n      // Логіка для обробки надсилання форми\r\n      console.log('Форма надіслана:', formFields.value);\r\n      // Тут ви можете зробити запит POST до вашого API з даними форми\r\n    };\r\n\r\n    return {\r\n      formFields,\r\n      formType,\r\n      clientId,\r\n      templateId,\r\n      submitForm,\r\n    };\r\n  }\r\n};\r\n</script>"],"mappings":";;;AA8JA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,UAAS,GAAIJ,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMK,QAAO,GAAIL,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMM,QAAO,GAAIN,GAAG,CAAC,IAAI,CAAC;IAC1B,MAAMO,UAAS,GAAIP,GAAG,CAAC,IAAI,CAAC;IAE5BC,SAAS,CAAC,YAAY;MACpB,MAAMO,WAAU,GAAI,IAAIC,eAAe,CAACC,MAAM,CAACC,QAAQ,CAACC,MAAM,CAAC;MAC/DN,QAAQ,CAACO,KAAI,GAAIL,WAAW,CAACM,GAAG,CAAC,QAAQ,CAAC;MAC1CP,UAAU,CAACM,KAAI,GAAIL,WAAW,CAACM,GAAG,CAAC,UAAU,CAAC;MAC9C,MAAMC,aAAa,CAAC,CAAC;IACvB,CAAC,CAAC;IAEF,MAAMA,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAIR,UAAU,CAACM,KAAK,EAAE;QACpB,IAAI;UACF,MAAMG,QAAO,GAAI,MAAMd,UAAU,CAACe,iBAAiB,CAACV,UAAU,CAACM,KAAK,CAAC;UACrET,UAAU,CAACS,KAAI,GAAIG,QAAQ,CAACE,IAAI,CAACA,IAAI,CAACC,UAAU;UAChDd,QAAQ,CAACQ,KAAI,GAAIG,QAAQ,CAACE,IAAI,CAACA,IAAI,CAACE,SAAS;UAC7CC,OAAO,CAACC,GAAG,CAAClB,UAAU,CAACS,KAAK,CAAC;UAC7BQ,OAAO,CAACC,GAAG,CAACN,QAAQ,CAACE,IAAI,CAAC;QAC5B,EAAE,OAAOK,KAAK,EAAE;UACdF,OAAO,CAACE,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;UACjD;QACF;MACF;IACF,CAAC;IAED,MAAMC,UAAS,GAAI,MAAAA,CAAA,KAAY;MAC7B;MACAH,OAAO,CAACC,GAAG,CAAC,kBAAkB,EAAElB,UAAU,CAACS,KAAK,CAAC;MACjD;IACF,CAAC;IAED,OAAO;MACLT,UAAU;MACVC,QAAQ;MACRC,QAAQ;MACRC,UAAU;MACViB;IACF,CAAC;EACH;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}