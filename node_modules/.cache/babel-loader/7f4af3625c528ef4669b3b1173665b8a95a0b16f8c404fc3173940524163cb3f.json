{"ast":null,"code":"import { ref, onMounted } from \"vue\";\nimport apiService from \"@/services/apiService\";\nexport default {\n  setup() {\n    const consultations = ref([]);\n    const fetchConsultations = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          M.toast({\n            html: 'Будь ласка, увійдіть у систему'\n          });\n          return;\n        }\n        const response = await apiService.getConsultations(token);\n        consultations.value = response.data;\n      } catch (error) {\n        console.error('Error fetching consultations:', error);\n        M.toast({\n          html: 'Помилка завантаження консультацій'\n        });\n      }\n    };\n    const formatDateTime = dateTime => {\n      const options = {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit'\n      };\n      return new Date(dateTime).toLocaleString('uk-UA', options);\n    };\n    onMounted(fetchConsultations);\n    return {\n      consultations,\n      formatDateTime\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","apiService","setup","consultations","fetchConsultations","token","localStorage","getItem","M","toast","html","response","getConsultations","value","data","error","console","formatDateTime","dateTime","options","year","month","day","hour","minute","Date","toLocaleString"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\MySessionPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"search margin-search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Номер сесії</th>\r\n          <th>Дата сесії</th>\r\n          <th>Ім'я клієнта</th>\r\n          <th>Дії</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"(consultation, index) in consultations\" :key=\"consultation.id\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ formatDateTime(consultation.date) }}</td>\r\n          <td>{{ consultation.client.first_name }}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/status.svg\" alt=\"Статус\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/share.svg\" alt=\"Почати сесію\">\r\n            </button>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from \"vue\";\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  setup() {\r\n    const consultations = ref([]);\r\n\r\n    const fetchConsultations = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          M.toast({ html: 'Будь ласка, увійдіть у систему' });\r\n          return;\r\n        }\r\n        const response = await apiService.getConsultations(token);\r\n        consultations.value = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching consultations:', error);\r\n        M.toast({ html: 'Помилка завантаження консультацій' });\r\n      }\r\n    };\r\n\r\n    const formatDateTime = (dateTime) => {\r\n      const options = {\r\n        year: 'numeric', month: '2-digit', day: '2-digit',\r\n        hour: '2-digit', minute: '2-digit'\r\n      };\r\n      return new Date(dateTime).toLocaleString('uk-UA', options);\r\n    };\r\n\r\n    onMounted(fetchConsultations);\r\n\r\n    return {\r\n      consultations,\r\n      formatDateTime\r\n    };\r\n  }\r\n}\r\n</script>"],"mappings":"AA+CA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,aAAY,GAAIJ,GAAG,CAAC,EAAE,CAAC;IAE7B,MAAMK,kBAAiB,GAAI,MAAAA,CAAA,KAAY;MACrC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVG,CAAC,CAACC,KAAK,CAAC;YAAEC,IAAI,EAAE;UAAiC,CAAC,CAAC;UACnD;QACF;QACA,MAAMC,QAAO,GAAI,MAAMV,UAAU,CAACW,gBAAgB,CAACP,KAAK,CAAC;QACzDF,aAAa,CAACU,KAAI,GAAIF,QAAQ,CAACG,IAAI;MACrC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,+BAA+B,EAAEA,KAAK,CAAC;QACrDP,CAAC,CAACC,KAAK,CAAC;UAAEC,IAAI,EAAE;QAAoC,CAAC,CAAC;MACxD;IACF,CAAC;IAED,MAAMO,cAAa,GAAKC,QAAQ,IAAK;MACnC,MAAMC,OAAM,GAAI;QACdC,IAAI,EAAE,SAAS;QAAEC,KAAK,EAAE,SAAS;QAAEC,GAAG,EAAE,SAAS;QACjDC,IAAI,EAAE,SAAS;QAAEC,MAAM,EAAE;MAC3B,CAAC;MACD,OAAO,IAAIC,IAAI,CAACP,QAAQ,CAAC,CAACQ,cAAc,CAAC,OAAO,EAAEP,OAAO,CAAC;IAC5D,CAAC;IAEDnB,SAAS,CAACI,kBAAkB,CAAC;IAE7B,OAAO;MACLD,aAAa;MACbc;IACF,CAAC;EACH;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}