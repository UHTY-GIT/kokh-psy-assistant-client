{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport apiService from '@/services/apiService';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\nexport default {\n  setup() {\n    // Реактивний об'єкт для форми\n    const form = reactive({\n      title: '',\n      primaryPollId: '',\n      formItems: [{\n        field_name: '',\n        field_type: 'text'\n      }]\n    });\n\n    // Правила валідації\n    const rules = {\n      form: {\n        title: {\n          required\n        },\n        formItems: {\n          // Валідація кожного елемента форми\n          $each: {\n            field_name: {\n              required\n            },\n            field_type: {\n              required\n            }\n          }\n        }\n      }\n    };\n\n    // Використання Vuelidate\n    const v$ = useVuelidate(rules, form);\n\n    // Методи\n    const addFormItem = () => {\n      form.formItems.push({\n        field_name: '',\n        field_type: 'text'\n      });\n    };\n    const removeFormItem = index => {\n      form.formItems.splice(index, 1);\n    };\n\n    // async handleSubmit() {\n    //   const token = localStorage.getItem('token');\n    //   if (!token) {\n    //     alert('Ви не авторизовані');\n    //     return;\n    //   }\n    //\n    //   try {\n    //     const response = await apiService.createCustomForm(token, this.form.title, this.form.primaryPollId);\n    //     this.createdFormId = response.data.data.id; // Оновлено, щоб відповідати формату відповіді API\n    //     console.log(this.createdFormId)\n    //     console.log('Форма створена:', response.data);\n    //   } catch (error) {\n    //     console.error('Помилка при створенні форми:', error);\n    //   }\n    // },\n    // addFormItem() {\n    //   this.formItems.push({ field_name: '', field_type: 'text' });\n    // },\n    // removeFormItem(index) {\n    //   this.formItems.splice(index, 1);\n    // },\n    // async submitFormItems() {\n    //   const token = localStorage.getItem('token');\n    //   if (this.createdFormId && this.formItems.length) {\n    //     try {\n    //       const response = await apiService.createFormItem(token, this.createdFormId, this.formItems);\n    //       console.log('Елементи форми створені:', response.data.data);\n    //       // Тут можна обробити успішне створення (наприклад, редірект або вивід повідомлення)\n    //     } catch (error) {\n    //       console.error('Помилка при створенні елементів форми:', error);\n    //       // Тут можна обробити помилку (наприклад, вивід повідомлення користувачеві)\n    //     }\n    //   } else {\n    //     alert('Форма не створена або елементи форми відсутні');\n    //   }\n    // },\n    return {\n      form,\n      v$,\n      addFormItem,\n      removeFormItem,\n      handleSubmit\n    };\n  }\n};","map":{"version":3,"names":["apiService","useVuelidate","required","setup","form","reactive","title","primaryPollId","formItems","field_name","field_type","rules","$each","v$","addFormItem","push","removeFormItem","index","splice","handleSubmit"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\TemplateForm.vue"],"sourcesContent":["<!--template form-->\r\n<template>\r\n  <div class=\"form-container\">\r\n    <!-- Форма для створення шаблону -->\r\n    <form class=\"name-update-form\" @submit.prevent=\"handleSubmit\">\r\n      <div class=\"container-input\">\r\n        <label for=\"title\">Назва шаблону</label>\r\n        <input\r\n            type=\"text\"\r\n            id=\"title\"\r\n            v-model=\"form.title\"\r\n            :class=\"{ 'is-invalid': v$.form.title.$dirty && v$.form.title.required.$invalid }\"\r\n            placeholder=\"Введіть назву шаблону\"\r\n        >\r\n      </div>\r\n      <span class=\"validate-error\" v-if=\"v$.form.title.$dirty && v$.form.title.required.$invalid\">Це поле не може бути пустим</span>\r\n<!--      <button type=\"submit\" class=\"btn-submit\">Задати назву</button>-->\r\n      <div class=\"container-global-form-edit\">\r\n        <button class=\"global-form-edit\" type=\"submit\">\r\n          <img src=\"@/assets/icons/edit-form.svg\" alt=\"Edit Button\">\r\n          <span class=\"edit-link\">Задати назву</span>\r\n        </button>\r\n      </div>\r\n    </form>\r\n\r\n    <!-- Умовний рендеринг для додавання елементів форми, якщо форма створена -->\r\n    <div v-if=\"createdFormId\">\r\n      <label>Додати елемент форми:</label>\r\n      <div class=\"form-items\">\r\n        <!-- Відображення динамічних полів форми -->\r\n        <div v-for=\"(item, index) in formItems\" :key=\"index\" class=\"form-item\">\r\n          <input type=\"text\" v-model=\"item.field_name\" placeholder=\"Field name\">\r\n          <select v-model=\"item.field_type\">\r\n            <option value=\"text\">Text</option>\r\n            <option value=\"string\">String</option>\r\n            <option value=\"boolean\">Boolean</option>\r\n          </select>\r\n          <button type=\"button\" @click=\"removeFormItem(index)\">Remove</button>\r\n        </div>\r\n        <!-- Кнопка для додавання нового елементу форми -->\r\n        <button type=\"button\" @click=\"addFormItem\">+</button>\r\n      </div>\r\n      <!-- Кнопка для фінального створення шаблону форми -->\r\n      <button type=\"button\" @click=\"submitFormItems\" class=\"btn-submit\">Створити шаблон</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { required } from '@vuelidate/validators';\r\nexport default {\r\n  setup() {\r\n    // Реактивний об'єкт для форми\r\n    const form = reactive({\r\n      title: '',\r\n      primaryPollId: '',\r\n      formItems: [{ field_name: '', field_type: 'text' }],\r\n    });\r\n\r\n    // Правила валідації\r\n    const rules = {\r\n      form: {\r\n        title: { required },\r\n        formItems: {\r\n          // Валідація кожного елемента форми\r\n          $each: {\r\n            field_name: { required },\r\n            field_type: { required },\r\n          }\r\n        }\r\n      }\r\n    };\r\n\r\n    // Використання Vuelidate\r\n    const v$ = useVuelidate(rules, form);\r\n\r\n    // Методи\r\n    const addFormItem = () => {\r\n      form.formItems.push({ field_name: '', field_type: 'text' });\r\n    };\r\n\r\n    const removeFormItem = (index) => {\r\n      form.formItems.splice(index, 1);\r\n    };\r\n\r\n    // async handleSubmit() {\r\n    //   const token = localStorage.getItem('token');\r\n    //   if (!token) {\r\n    //     alert('Ви не авторизовані');\r\n    //     return;\r\n    //   }\r\n    //\r\n    //   try {\r\n    //     const response = await apiService.createCustomForm(token, this.form.title, this.form.primaryPollId);\r\n    //     this.createdFormId = response.data.data.id; // Оновлено, щоб відповідати формату відповіді API\r\n    //     console.log(this.createdFormId)\r\n    //     console.log('Форма створена:', response.data);\r\n    //   } catch (error) {\r\n    //     console.error('Помилка при створенні форми:', error);\r\n    //   }\r\n    // },\r\n    // addFormItem() {\r\n    //   this.formItems.push({ field_name: '', field_type: 'text' });\r\n    // },\r\n    // removeFormItem(index) {\r\n    //   this.formItems.splice(index, 1);\r\n    // },\r\n    // async submitFormItems() {\r\n    //   const token = localStorage.getItem('token');\r\n    //   if (this.createdFormId && this.formItems.length) {\r\n    //     try {\r\n    //       const response = await apiService.createFormItem(token, this.createdFormId, this.formItems);\r\n    //       console.log('Елементи форми створені:', response.data.data);\r\n    //       // Тут можна обробити успішне створення (наприклад, редірект або вивід повідомлення)\r\n    //     } catch (error) {\r\n    //       console.error('Помилка при створенні елементів форми:', error);\r\n   