{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted } from 'vue';\nimport apiService from \"@/services/apiService\";\nimport { useRouter } from 'vue-router';\nimport M from \"materialize-css\";\nimport ModalStartSession from \"@/components/modal/ModalStartSession.vue\";\nexport default {\n  components: {\n    ModalStartSession\n  },\n  setup() {\n    const consultations = ref([]);\n    const showModal = ref(false);\n    const selectedConsultation = ref(null);\n    const router = useRouter();\n    const fetchConsultations = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          M.toast({\n            html: 'Будь ласка, увійдіть у систему'\n          });\n          return;\n        }\n        const response = await apiService.getConsultations(token);\n        consultations.value = response.data;\n      } catch (error) {\n        console.error('Error fetching consultations:', error);\n        M.toast({\n          html: 'Помилка завантаження консультацій'\n        });\n      }\n    };\n    const formatDate = date => {\n      if (!date) return '';\n      const d = new Date(date);\n      return d.toLocaleDateString('uk-UA', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit'\n      });\n    };\n    const formatTime = date => {\n      if (!date) return '';\n      const d = new Date(date);\n      return d.toLocaleTimeString('uk-UA', {\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    };\n    const openModal = consultation => {\n      selectedConsultation.value = consultation;\n      showModal.value = true;\n    };\n    const startSession = consultation => {\n      showModal.value = false;\n      router.push({\n        name: 'ActiveSession',\n        query: {\n          clientId: consultation.client.id,\n          clientName: consultation.client.first_name,\n          customFormId: consultation.custom_form.id,\n          customFormTitle: consultation.custom_form.title,\n          sessionNumber: consultation.number,\n          IDconsultation: consultation.id\n        }\n      });\n    };\n    onMounted(fetchConsultations);\n    return {\n      consultations,\n      formatDate,\n      formatTime,\n      openModal,\n      startSession,\n      showModal,\n      selectedConsultation\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","apiService","useRouter","M","ModalStartSession","components","setup","consultations","showModal","selectedConsultation","router","fetchConsultations","token","localStorage","getItem","toast","html","response","getConsultations","value","data","error","console","formatDate","date","d","Date","toLocaleDateString","year","month","day","formatTime","toLocaleTimeString","hour","minute","openModal","consultation","startSession","push","name","query","clientId","client","id","clientName","first_name","customFormId","custom_form","customFormTitle","title","sessionNumber","number","IDconsultation"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\MySessionPage.vue"],"sourcesContent":["<!--src/views/MySessionPage.vue-->\r\n<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"search margin-search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Номер сесії</th>\r\n          <th>Час початку сесії</th>\r\n          <th>Дата сесії</th>\r\n          <th>Ім'я клієнта</th>\r\n<!--          <th>Дії</th>-->\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"consultation in consultations\" :key=\"consultation.id\">\r\n          <td>{{ consultation.number }}</td>\r\n          <td>{{ formatTime(consultation.consultation_date) }}</td>\r\n          <td>{{ formatDate(consultation.consultation_date) }}</td>\r\n          <td>{{ consultation.client.first_name }}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\" data-tooltip=\"Статус сесії\">\r\n              <img src=\"@/assets/icons/status.svg\" alt=\"Статус\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Перейти до сесії\" @click=\"openModal(consultation)\">\r\n              <img src=\"@/assets/icons/share.svg\" alt=\"Почати сесію\">\r\n            </button>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <!-- Модальне вікно для початку сесії -->\r\n  <ModalStartSession\r\n      v-if=\"showModal\"\r\n      :showModal=\"showModal\"\r\n      :consultation=\"selectedConsultation\"\r\n      @close=\"showModal = false\"\r\n      @confirm=\"startSession\"\r\n  />\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport apiService from \"@/services/apiService\";\r\nimport { useRouter } from 'vue-router';\r\nimport M from \"materialize-css\";\r\nimport ModalStartSession from \"@/components/modal/ModalStartSession.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    ModalStartSession\r\n  },\r\n  setup() {\r\n    const consultations = ref([]);\r\n    const showModal = ref(false);\r\n    const selectedConsultation = ref(null);\r\n    const router = useRouter();\r\n\r\n    const fetchConsultations = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          M.toast({html: 'Будь ласка, увійдіть у систему'});\r\n          return;\r\n        }\r\n        const response = await apiService.getConsultations(token);\r\n        consultations.value = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching consultations:', error);\r\n        M.toast({html: 'Помилка завантаження консультацій'});\r\n      }\r\n    };\r\n\r\n    const formatDate = (date) => {\r\n      if (!date) return '';\r\n      const d = new Date(date);\r\n      return d.toLocaleDateString('uk-UA', {year: 'numeric', month: '2-digit', day: '2-digit'});\r\n    };\r\n\r\n    const formatTime = (date) => {\r\n      if (!date) return '';\r\n      const d = new Date(date);\r\n      return d.toLocaleTimeString('uk-UA', {hour: '2-digit', minute: '2-digit'});\r\n    };\r\n\r\n    const openModal = (consultation) => {\r\n      selectedConsultation.value = consultation;\r\n      showModal.value = true;\r\n    };\r\n\r\n    const startSession = (consultation) => {\r\n      showModal.value = false;\r\n      router.push({\r\n        name: 'ActiveSession',\r\n        query: {\r\n          clientId: consultation.client.id,\r\n          clientName: consultation.client.first_name,\r\n          customFormId: consultation.custom_form.id,\r\n          customFormTitle: consultation.custom_form.title,\r\n          sessionNumber: consultation.number,\r\n          IDconsultation: consultation.id\r\n        }\r\n      });\r\n    };\r\n\r\n    onMounted(fetchConsultations);\r\n\r\n    return {\r\n      consultations,\r\n      formatDate,\r\n      formatTime,\r\n      openModal,\r\n      startSession,\r\n      showModal,\r\n      selectedConsultation\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";AA2DA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,OAAOC,iBAAgB,MAAO,0CAA0C;AAExE,eAAe;EACbC,UAAU,EAAE;IACVD;EACF,CAAC;EACDE,KAAKA,CAAA,EAAG;IACN,MAAMC,aAAY,GAAIR,GAAG,CAAC,EAAE,CAAC;IAC7B,MAAMS,SAAQ,GAAIT,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMU,oBAAmB,GAAIV,GAAG,CAAC,IAAI,CAAC;IACtC,MAAMW,MAAK,GAAIR,SAAS,CAAC,CAAC;IAE1B,MAAMS,kBA