{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport apiService from \"@/services/apiService\";\nexport default {\n  name: 'ActiveSession',\n  props: {\n    clientId: Number,\n    clientName: String,\n    customFormId: Number,\n    customFormTitle: String,\n    sessionNumber: Number\n  },\n  setup(props) {\n    const formData = ref({\n      fields: []\n    });\n    const fetchFormData = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          throw new Error('No authentication token found');\n        }\n        const response = await apiService.getCustomFormById(props.customFormId);\n        console.log(response);\n        //formData.value.fields = response.data.fields; // Assuming the response contains fields data\n      } catch (error) {\n        console.error('Error fetching form data:', error);\n      }\n    };\n    onMounted(fetchFormData);\n    return {\n      formData,\n      ...props\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","apiService","name","props","clientId","Number","clientName","String","customFormId","customFormTitle","sessionNumber","setup","formData","fields","fetchFormData","token","localStorage","getItem","Error","response","getCustomFormById","console","log","error"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\ActiveSessionPage.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Сесія №{{ sessionNumber }}, клієнт {{ clientName }}\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"block_active_session\">\r\n    <div class=\"titte_field\">\r\n      <p>\r\n        Базові поля\r\n      </p>\r\n    </div>\r\n    <div class=\"block_input_field\">\r\n      <form>\r\n        <div class=\"forms-name-add\">\r\n          <div class=\"container-input\">\r\n            <label for=\"main-points-of-the-session\">Основні думки сесії</label>\r\n            <input\r\n                type=\"text\"\r\n                id=\"main-points-of-the-session\"\r\n                placeholder=\"Введіть основні думки по цій сесії\"\r\n            >\r\n          </div>\r\n        </div>\r\n        <div v-for=\"field in formData.fields\" :key=\"field.id\" class=\"forms-name-add\">\r\n          <div class=\"container-input\">\r\n            <label :for=\"field.id\">{{ field.label }}</label>\r\n            <input\r\n                :type=\"field.type\"\r\n                :id=\"field.id\"\r\n                v-model=\"field.value\"\r\n                :placeholder=\"field.placeholder\"\r\n            >\r\n          </div>\r\n        </div>\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/share.svg\" alt=\"Send name form\">\r\n            <span class=\"edit-link\">Завершити сесію</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  name: 'ActiveSession',\r\n  props: {\r\n    clientId: Number,\r\n    clientName: String,\r\n    customFormId: Number,\r\n    customFormTitle: String,\r\n    sessionNumber: Number\r\n  },\r\n  setup(props) {\r\n    const formData = ref({\r\n      fields: [],\r\n    });\r\n\r\n    const fetchFormData = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          throw new Error('No authentication token found');\r\n        }\r\n        const response = await apiService.getCustomFormById(props.customFormId);\r\n        console.log(response)\r\n        //formData.value.fields = response.data.fields; // Assuming the response contains fields data\r\n      } catch (error) {\r\n        console.error('Error fetching form data:', error);\r\n      }\r\n    };\r\n\r\n    onMounted(fetchFormData);\r\n\r\n    return {\r\n      formData,\r\n      ...props\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAkDA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IACLC,QAAQ,EAAEC,MAAM;IAChBC,UAAU,EAAEC,MAAM;IAClBC,YAAY,EAAEH,MAAM;IACpBI,eAAe,EAAEF,MAAM;IACvBG,aAAa,EAAEL;EACjB,CAAC;EACDM,KAAKA,CAACR,KAAK,EAAE;IACX,MAAMS,QAAO,GAAIb,GAAG,CAAC;MACnBc,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACV,MAAM,IAAIG,KAAK,CAAC,+BAA+B,CAAC;QAClD;QACA,MAAMC,QAAO,GAAI,MAAMlB,UAAU,CAACmB,iBAAiB,CAACjB,KAAK,CAACK,YAAY,CAAC;QACvEa,OAAO,CAACC,GAAG,CAACH,QAAQ;QACpB;MACF,EAAE,OAAOI,KAAK,EAAE;QACdF,OAAO,CAACE,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;MACnD;IACF,CAAC;IAEDvB,SAAS,CAACc,aAAa,CAAC;IAExB,OAAO;MACLF,QAAQ;MACR,GAAGT;IACL,CAAC;EACH;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}