{"ast":null,"code":"import { ref } from 'vue';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\nexport default {\n  setup() {\n    const profile = ref({\n      name: '',\n      avatar: null,\n      image: null,\n      country: '',\n      timezone: '',\n      birthdate: '',\n      workType: [],\n      qualification: ''\n    });\n    const v$ = useVuelidate(); // Визначено тут для спрощення\n    const fileChosen = ref(null); // Додано реф для тексту файлу, який був вибраний\n\n    const submitUserProfile = () => {\n      v$.value.$touch();\n      if (!v$.value.$invalid) {\n        console.log('Profile data:', profile.value);\n        // Тут може бути логіка для відправки даних на сервер\n      }\n      const formData = {\n        // name: name.value // Додайте ім'я користувача в дані форми\n      };\n      console.log(formData);\n    };\n    const handleFileUpload = (event, field) => {\n      profile.value[field] = event.target.files[0];\n      fileChosen.value = event.target.files[0].name; // Оновлюємо назву файлу у реф\n    };\n    const triggerFileInput = () => {\n      fileInput.value.click(); // Використовуємо реф для активації кліку на input\n    };\n    return {\n      profile,\n      v$,\n      submitUserProfile,\n      handleFileUpload,\n      fileChosen,\n      triggerFileInput\n    };\n  },\n  validations() {\n    return {\n      profile: {\n        // Тепер використовуємо profile як реактивне джерело для валідацій\n        name: {\n          required\n        },\n        avatar: {\n          required\n        },\n        image: {\n          required\n        },\n        country: {\n          required\n        },\n        timezone: {\n          required\n        },\n        birthdate: {\n          required\n        },\n        workType: {\n          required\n        },\n        qualification: {\n          required\n        }\n      }\n    };\n  }\n};","map":{"version":3,"names":["ref","useVuelidate","required","setup","profile","name","avatar","image","country","timezone","birthdate","workType","qualification","v$","fileChosen","submitUserProfile","value","$touch","$invalid","console","log","formData","handleFileUpload","event","field","target","files","triggerFileInput","fileInput","click","validations"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\profile\\ProfilePsycologistForm.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"update_profile_tittle\">\r\n      <p>\r\n        Оновити дані профілю\r\n      </p>\r\n    </div>\r\n    <div>\r\n      <form class=\"form name-update-form\" @submit.prevent=\"submitUserProfile\">\r\n<!--        <div class=\"input-field\">-->\r\n<!--          <input-->\r\n<!--              id=\"name\"-->\r\n<!--              type=\"text\"-->\r\n<!--              v-model.trim=\"name\"-->\r\n<!--              :class=\"{-->\r\n<!--              invalid: v$.name.$dirty && v$.name.required.$invalid,-->\r\n<!--              validate: v$.name.$dirty && !v$.name.required.$invalid-->\r\n<!--            }\"-->\r\n<!--          >-->\r\n<!--          <label for=\"name\">Ім'я</label>-->\r\n<!--          <small-->\r\n<!--              class=\"helper-text invalid\"-->\r\n<!--              v-if=\"v$.name.$dirty && v$.name.required.$invalid\"-->\r\n<!--          >Введіть ваше ім'я</small>-->\r\n<!--        </div>-->\r\n        <!-- Поле для введення імені -->\r\n        <div class=\"input-field-text\">\r\n          <div class=\"container-input\">\r\n            <label for=\"name\">Введіть ім’я</label>\r\n            <input\r\n                id=\"name\"\r\n                type=\"text\"\r\n                v-model.trim=\"profile.name\"\r\n                :class=\"{ 'is-invalid': v$.profile.name.$dirty }\"\r\n                placeholder=\"Введіть ваше повне ім'я\"\r\n            >\r\n          </div>\r\n          <span v-if=\"v$.profile.name.$dirty\">Введіть ваше повне ім'я</span>\r\n        </div>\r\n\r\n        <!-- Поля для завантаження файлів -->\r\n        <div class=\"file-upload-field\">\r\n          <div class=\"container-input\">\r\n            <label for=\"avatar\">Встановити аватар</label>\r\n            <input\r\n                id=\"avatar\"\r\n                type=\"file\"\r\n                @change=\"handleFileUpload($event, 'avatar')\"\r\n                style=\"display: none;\"\r\n            >\r\n            <span class=\"file-chosen\" @click=\"triggerFileInput\">{{ fileChosen ? fileChosen : \"Натисніть щоб вибрати файл\" }}</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"file-upload-field\">\r\n          <label for=\"image\">Встановити зображення</label>\r\n          <input\r\n              id=\"image\"\r\n              type=\"file\"\r\n              @change=\"handleFileUpload($event, 'image')\"\r\n          >\r\n        </div>\r\n\r\n        <!-- Випадаючі списки з пошуком -->\r\n        <div class=\"select-field\">\r\n          <label for=\"country\">Встановити країну</label>\r\n          <select id=\"country\" v-model=\"profile.country\">\r\n            <!-- Тут будуть опції для країн -->\r\n          </select>\r\n        </div>\r\n\r\n        <div class=\"select-field\">\r\n          <label for=\"timezone\">Встановити тайм-зону</label>\r\n          <select id=\"timezone\" v-model=\"profile.timezone\">\r\n            <!-- Тут будуть опції для тайм-зон -->\r\n          </select>\r\n        </div>\r\n\r\n        <!-- Поле для вибору дати -->\r\n        <div class=\"date-field\">\r\n          <label for=\"birthdate\">Дата народження</label>\r\n          <input\r\n              id=\"birthdate\"\r\n              type=\"date\"\r\n              v-model=\"profile.birthdate\"\r\n          >\r\n        </div>\r\n\r\n        <!-- Чекбокси для типу роботи -->\r\n        <div class=\"checkbox-field\">\r\n          <label>Тип роботи:</label>\r\n          <div class=\"checkbox-group\">\r\n            <label><input type=\"checkbox\" v-model=\"profile.workType\" value=\"individual\"> Індивідуальна</label>\r\n            <label><input type=\"checkbox\" v-model=\"profile.workType\" value=\"couple\"> Парна</label>\r\n            <label><input type=\"checkbox\" v-model=\"profile.workType\" value=\"family\"> Сімейна</label>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Текстове поле для кваліфікації -->\r\n        <div class=\"input-field-text\">\r\n          <label for=\"qualification\">Кваліфікація</label>\r\n          <input\r\n              id=\"qualification\"\r\n              type=\"text\"\r\n              v-model=\"profile.qualification\"\r\n              required\r\n          >\r\n        </div>\r\n\r\n        <button class=\"name-edit\" type=\"submit\">\r\n<!--          <img src=\"@/assets/icons/edit-button-1.png\" alt=\"Edit Button\">-->\r\n          <span class=\"edit-link\">Оновити</span>\r\n        </button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { ref } from 'vue';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { required } from '@vuelidate/validators'\r\n\r\nexport default {\r\n  setup() {\r\n    const profile = ref({\r\n      name: '',\r\n      avatar: null,\r\n      image: null,\r\n      country: '',\r\n      timezone: '',\r\n      birthdate: '',\r\n      workType: [],\r\n      qualification: '',\r\n    });\r\n    const v$ = useVuelidate(); // Визначено тут для спрощення\r\n    const fileChosen = ref(null); // Додано реф для тексту файлу, який був вибраний\r\n\r\n    const submitUserProfile = () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        console.log('Profile data:', profile.value);\r\n        // Тут може бути логіка для відправки даних на сервер\r\n      }\r\n      const formData = {\r\n        // name: name.value // Додайте ім'я користувача в дані форми\r\n      };\r\n      console.log(formData);\r\n    }\r\n    const handleFileUpload = (event, field) => {\r\n      profile.value[field] = event.target.files[0];\r\n      fileChosen.value = event.target.files[0].name; // Оновлюємо назву файлу у реф\r\n    }\r\n    const triggerFileInput = () => {\r\n      fileInput.value.click(); // Використовуємо реф для активації кліку на input\r\n    }\r\n    return {\r\n      profile,\r\n      v$,\r\n      submitUserProfile,\r\n      handleFileUpload,\r\n      fileChosen,\r\n      triggerFileInput\r\n    };\r\n  },\r\n  validations() {\r\n    return {\r\n      profile: { // Тепер використовуємо profile як реактивне джерело для валідацій\r\n        name: {required},\r\n        avatar: {required},\r\n        image: {required},\r\n        country: {required},\r\n        timezone: {required},\r\n        birthdate: {required},\r\n        workType: {required},\r\n        qualification: {required},\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":"AAsHA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAO,QAAS,uBAAsB;AAE/C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIJ,GAAG,CAAC;MAClBK,IAAI,EAAE,EAAE;MACRC,MAAM,EAAE,IAAI;MACZC,KAAK,EAAE,IAAI;MACXC,OAAO,EAAE,EAAE;MACXC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,QAAQ,EAAE,EAAE;MACZC,aAAa,EAAE;IACjB,CAAC,CAAC;IACF,MAAMC,EAAC,GAAIZ,YAAY,CAAC,CAAC,EAAE;IAC3B,MAAMa,UAAS,GAAId,GAAG,CAAC,IAAI,CAAC,EAAE;;IAE9B,MAAMe,iBAAgB,GAAIA,CAAA,KAAM;MAC9BF,EAAE,CAACG,KAAK,CAACC,MAAM,CAAC,CAAC;MACjB,IAAI,CAACJ,EAAE,CAACG,KAAK,CAACE,QAAQ,EAAE;QACtBC,OAAO,CAACC,GAAG,CAAC,eAAe,EAAEhB,OAAO,CAACY,KAAK,CAAC;QAC3C;MACF;MACA,MAAMK,QAAO,GAAI;QACf;MAAA,CACD;MACDF,OAAO,CAACC,GAAG,CAACC,QAAQ,CAAC;IACvB;IACA,MAAMC,gBAAe,GAAIA,CAACC,KAAK,EAAEC,KAAK,KAAK;MACzCpB,OAAO,CAACY,KAAK,CAACQ,KAAK,IAAID,KAAK,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC,CAAC;MAC5CZ,UAAU,CAACE,KAAI,GAAIO,KAAK,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC,CAAC,CAACrB,IAAI,EAAE;IACjD;IACA,MAAMsB,gBAAe,GAAIA,CAAA,KAAM;MAC7BC,SAAS,CAACZ,KAAK,CAACa,KAAK,CAAC,CAAC,EAAE;IAC3B;IACA,OAAO;MACLzB,OAAO;MACPS,EAAE;MACFE,iBAAiB;MACjBO,gBAAgB;MAChBR,UAAU;MACVa;IACF,CAAC;EACH,CAAC;EACDG,WAA