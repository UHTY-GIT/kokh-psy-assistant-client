{"ast":null,"code":"export default {\n  props: {\n    templates: Array,\n    showModal: Boolean\n  },\n  methods: {\n    closeModal() {\n      this.$emit('close'); // Емітуйте подію 'close'\n    }\n  }\n};","map":{"version":3,"names":["props","templates","Array","showModal","Boolean","methods","closeModal","$emit"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\modal\\ModalTemplates.vue"],"sourcesContent":["<!--src/components/modal/ModalTemplates.vue-->\r\n<template>\r\n  <div :class=\"{ 'modal-window': true, 'is-active': showModal }\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-close-butt\">\r\n        <img src=\"@/assets/icons/close-modal.svg\" alt=\"close\" @click=\"closeModal\">\r\n      </div>\r\n      <div class=\"modal-content-all\">\r\n        <p>Виберіть шаблон для відправки</p>\r\n        <div class=\"chosen-templates select-field\">\r\n<!--          <div v-for=\"template in templates\" :key=\"template.id\">-->\r\n<!--            <button @click=\"sendTemplate(template.id)\">{{ template.title }}</button>-->\r\n<!--          </div>-->\r\n          <div class=\"container-input\">\r\n            <select>\r\n              <option disabled value=\"\">Будь ласка, виберіть шаблон</option>\r\n              <option v-for=\"template in templates\" :key=\"template.id\">{{ template.title }}</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  props: {\r\n    templates: Array,\r\n    showModal: Boolean\r\n  },\r\n  methods: {\r\n    closeModal() {\r\n      this.$emit('close'); // Емітуйте подію 'close'\r\n    },\r\n  },\r\n};\r\n</script>\r\n<style>\r\n.modal-window {\r\n  position: fixed;\r\n  z-index: 1;\r\n  left: 0;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  overflow: auto;\r\n  background-color: rgb(56 94 108 / 43%);\r\n  align-items: center;\r\n  justify-content: center;\r\n}