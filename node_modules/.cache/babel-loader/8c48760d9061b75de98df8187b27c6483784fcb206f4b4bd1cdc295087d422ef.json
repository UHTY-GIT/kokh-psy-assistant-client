rkingDays.wednesday\"\r\n                />\r\n                <span class=\"checkmark\">\r\n                  <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                    <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                  </svg>\r\n                </span>\r\n                <p>\r\n                  Ср\r\n                </p>\r\n              </label>\r\n              <label class=\"custom-checkbox\">\r\n                <input type=\"checkbox\"\r\n                       v-model=\"workingDays.thursday\"\r\n                />\r\n                <span class=\"checkmark\">\r\n                  <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                    <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                  </svg>\r\n                </span>\r\n                <p>\r\n                  Чт\r\n                </p>\r\n              </label>\r\n              <label class=\"custom-checkbox\">\r\n                <input type=\"checkbox\"\r\n                       v-model=\"workingDays.friday\"\r\n                />\r\n                <span class=\"checkmark\">\r\n                  <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                    <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                  </svg>\r\n                </span>\r\n                <p>\r\n                  Пт\r\n                </p>\r\n              </label>\r\n              <label class=\"custom-checkbox\">\r\n                <input type=\"checkbox\"\r\n                       v-model=\"workingDays.saturday\"\r\n                />\r\n                <span class=\"checkmark\">\r\n                  <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                    <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                  </svg>\r\n                </span>\r\n                <p>\r\n                  Сб\r\n                </p>\r\n              </label>\r\n            </div>\r\n            <!-- Відображення повідомлення про помилку -->\r\n            <span\r\n                v-if=\"v$.workingDays.atLeastOneDaySelected.$error\"\r\n                class=\"error-message\"\r\n            >\r\n              Будь ласка, виберіть хоча б один робочий день.\r\n            </span>\r\n          </div>\r\n        </div>\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/edit-form.svg\" alt=\"Edit Button\">\r\n            <span class=\"edit-link\">Вибрати</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { ref } from 'vue';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { helpers } from \"@vuelidate/validators\";\r\n\r\n// Кастомний валідатор\r\nconst atLeastOneDaySelected = (value) => {\r\n  return Object.values(value).some(v => v); // Перевіряємо, чи є хоча б один день з true\r\n};\r\nexport default {\r\n  setup() {\r\n    // Ініціалізація стану форми\r\n    const workingDays = ref({\r\n      monday: false,\r\n      tuesday: false,\r\n      wednesday: false,\r\n      thursday: false,\r\n      friday: false,\r\n      saturday: false,\r\n    });\r\n\r\n    // // Кастомний валідатор для перевірки, що хоча б один день вибрано\r\n    // const atLeastOneDaySelected = helpers.withMessage(\r\n    //     'Будь ласка, виберіть хоча б один робочий день.',\r\n    //     () => {\r\n    //       return Object.values(workingDays.value).some(value => value);\r\n    //     }\r\n    // );\r\n\r\n\r\n    // const rules = {\r\n    //   workingDays: { atLeastOneDaySelected },\r\n    // };\r\n    //\r\n    // const v$ = useVuelidate(rules, { workingDays });\r\n    const v$ = useVuelidate();\r\n\r\n    const submitDaysProfile = () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        console.log('Обрані робочі дні:', Object.keys(workingDays.value).filter(day => workingDays.value[day]));\r\n        // Тут може бути логіка для відправки даних на сервер\r\n      }\r\n    };\r\n\r\n    return {\r\n      v$,\r\n      workingDays,\r\n      submitDaysProfile,\r\n    }\r\n  }\r\n}\r\n\r\n</script>"],"mappings":"AAiHA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,OAAM,QAAS,uBAAuB;;AAE/C;AACA,MAAMC,qBAAoB,GAAKC,KAAK,IAAK;EACvC,OAAOC,MAAM,CAACC,MAAM,CAACF,KAAK,CAAC,CAACG,IAAI,CAACC,CAAA,IAAKA,CAAC,CAAC,EAAE;AAC5C,CAAC;AACD,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN;IACA,MAAMC,WAAU,GAAIV,GAAG,CAAC;MACtBW,MAAM,EAAE,KAAK;MACbC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,KAAK;MAChBC,QAAQ,EAAE,KAAK;MACfC,MAAM,EAAE,KAAK;MACbC,QAAQ,EAAE;IACZ,CAAC,CAAC;;IAEF;IACA;IACA;IACA;IACA;IACA;IACA;;IAGA;IACA;IACA;IACA;IACA;IACA,MAAMC,EAAC,GAAIhB,YAAY,CAAC,CAAC;IAEzB,MAAMiB,iBAAgB,GAAIA,CAAA,KAAM;MAC9BD,EAAE,CAACb,KAAK,CAACe,MAAM,CAAC,CAAC;MACjB,IAAI,CAACF,EAAE,CAACb,KAAK,CAACgB,QAAQ,EAAE;QACtBC,OAAO,CAACC,GAAG,CAAC,oBAAoB,EAAEjB,MAAM,CAACkB,IAAI,CAACb,WAAW,CAACN,KAAK,CAAC,