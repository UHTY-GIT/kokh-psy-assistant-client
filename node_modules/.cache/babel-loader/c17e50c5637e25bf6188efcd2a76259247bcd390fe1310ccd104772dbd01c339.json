{"ast":null,"code":"import { ref } from 'vue';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\n\n// Ініціалізація стану форми\n\nexport default {\n  __name: 'ProfileWorkDayForm',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const workingDays = ref({\n      monday: false,\n      tuesday: false,\n      wednesday: false,\n      thursday: false,\n      friday: false,\n      saturday: false\n    });\n\n    // Кастомний валідатор\n    const atLeastOneDaySelected = value => {\n      return Object.values(value).some(day => day);\n    };\n\n    // Валідація\n    const v$ = useVuelidate({\n      workingDays: {\n        atLeastOneDaySelected\n      }\n    }, {\n      workingDays\n    });\n\n    // Функція для відправки даних\n    const submitForm = async () => {\n      if (!v$.$validate()) {\n        alert('Будь ласка, виберіть хоча б один робочий день.');\n        return;\n      }\n\n      // Припустимо, що API очікує дані у форматі масиву з назвами днів\n      const selectedDays = Object.entries(workingDays.value).filter(([day, isSelected]) => isSelected).map(([day]) => day);\n\n      // Тут викликаємо API, використовуючи axios чи іншу бібліотеку для HTTP-запитів\n      // Приклад: await axios.post('URL_АПІ', { days: selectedDays });\n\n      console.log('Відправлено дні: ', selectedDays);\n    };\n    const __returned__ = {\n      workingDays,\n      atLeastOneDaySelected,\n      v$,\n      submitForm,\n      ref,\n      get useVuelidate() {\n        return useVuelidate;\n      },\n      get required() {\n        return required;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","useVuelidate","required","workingDays","monday","tuesday","wednesday","thursday","friday","saturday","atLeastOneDaySelected","value","Object","values","some","day","v$"