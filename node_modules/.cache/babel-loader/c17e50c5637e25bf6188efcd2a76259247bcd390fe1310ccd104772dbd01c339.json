обочий день.');\r\n    return;\r\n  }\r\n\r\n  // Припустимо, що API очікує дані у форматі масиву з назвами днів\r\n  const selectedDays = Object.entries(workingDays.value).filter(([day, isSelected]) => isSelected).map(([day]) => day);\r\n\r\n  // Тут викликаємо API, використовуючи axios чи іншу бібліотеку для HTTP-запитів\r\n  // Приклад: await axios.post('URL_АПІ', { days: selectedDays });\r\n\r\n  console.log('Відправлено дні: ', selectedDays);\r\n};\r\n\r\n</script>"],"mappings":"AA8FA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,YAAY,QAAQ,iBAAiB;AAC9C,SAASC,QAAQ,QAAQ,uBAAuB;;AAEhD;;;;;;;;IACA,MAAMC,WAAW,GAAGH,GAAG,CAAC;MACtBI,MAAM,EAAE,KAAK;MACbC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,KAAK;MAChBC,QAAQ,EAAE,KAAK;MACfC,MAAM,EAAE,KAAK;MACbC,QAAQ,EAAE;IACZ,CAAC,CAAC;;IAEF;IACA,MAAMC,qBAAqB,GAAIC,KAAK,IAAK;MACvC,OAAOC,MAAM,CAACC,MAAM,CAACF,KAAK,CAAC,CAACG,IAAI,CAAEC,GAAG,IAAKA,GAAG,CAAC;IAChD,CAAC;;IAED;IACA,MAAMC,EAAE,GAAGf,YAAY,CAAC;MACtBE,WAAW,EAAE;QAAEO;MAAsB;IACvC,CAAC,EAAE;MAAEP;IAAY,CAAC,CAAC;;IAEnB;IACA,MAAMc,UAAU,GAAG,MAAAA,CAAA,KAAY;MAC7B,IAAI,CAACD,EAAE,CAACE,SAAS,CAAC,CAAC,EAAE;QACnBC,KAAK,CAAC,gDAAgD,CAAC;QACvD;MACF;;MAEA;MACA,MAAMC,YAAY,GAAGR,MAAM,CAACS,OAAO,CAAClB,WAAW,CAACQ,KAAK,CAAC,CAACW,MAAM,CAAC,CAAC,CAACP,GAAG,EAAEQ,UAAU,CAAC,KAAKA,UAAU,CAAC,CAACC,GAAG,CAAC,CAAC,CAACT,GAAG,CAAC,KAAKA,GAAG,CAAC;;MAEpH;MACA;;MAEAU,OAAO,CAACC,GAAG,CAAC,mBAAmB,EAAEN,YAAY,CAAC;IAChD,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}