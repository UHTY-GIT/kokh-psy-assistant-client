{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport apiService from '@/services/apiService';\nimport M from 'materialize-css';\nimport { ref } from 'vue';\nimport ModalTemplates from \"@/components/modal/ModalTemplates.vue\";\nimport { useRouter } from \"vue-router\";\nexport default {\n  name: \"AllClient\",\n  components: {\n    ModalTemplates\n  },\n  setup() {\n    const showModal = ref(false);\n    const clients = ref([]);\n    const templates = ref([]);\n    const selectedClientId = ref(null); // зберігання ID вибраного клієнта\n    const clientWasAgreedConsent = ref(false);\n    const clientPrimaryPollComplete = ref(false);\n    const router = useRouter();\n    const fetchClients = async () => {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getClients(token);\n          if (response && response.data && response.data.data) {\n            clients.value = response.data.data; // Зберігання даних клієнтів у масив\n          }\n        }\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n        M.toast({\n          html: `Увійдіть у систему`\n        });\n      }\n    };\n    const fetchTemplates = async () => {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getForms(token);\n          if (response && response.data && response.data.data) {\n            templates.value = response.data.data; // Зберігання даних форм у масив\n          }\n        }\n      } catch (error) {\n        // console.error('Error fetching clients:', error);\n        M.toast({\n          html: `Увійдіть у систему`\n        });\n        router.push('/login');\n      }\n    };\n    const openModal = (clientId, clientConsent, clientPrimaryPoll) => {\n      showModal.value = true;\n      selectedClientId.value = clientId;\n      console.log(`ID клієнта для відправки ${selectedClientId.value}`);\n      clientWasAgreedConsent.value = clientConsent;\n      console.log(`Клієнт прийняв інформовану згоду ${clientWasAgreedConsent.value}`);\n      clientPrimaryPollComplete.value = clientPrimaryPoll;\n      console.log(`Клієнт пройшов первинне опитування ${clientPrimaryPollComplete.value}`);\n      fetchTemplates();\n    };\n\n    // Перенесіть логіку з mounted сюди, якщо потрібно запустити щось при створенні компонента\n    fetchClients();\n    return {\n      clients,\n      showModal,\n      openModal,\n      templates,\n      selectedClientId,\n      clientWasAgreedConsent,\n      clientPrimaryPollComplete\n    };\n  }\n};","map":{"version":3,"names":["apiService","M","ref","ModalTemplates","useRouter","name","components","setup","showModal","clients","templates","selectedClientId","clientWasAgreedConsent","clientPrimaryPollComplete","router","fetchClients","token","localStorage","getItem","response","getClients","data","value","error","console","toast","html","fetchTemplates","getForms","push","openModal","clientId","clientConsent","clientPrimaryPoll","log"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\AllClientPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"client-header\">\r\n      <button class=\"btn-add-client\">\r\n        Додати клієнта\r\n      </button>\r\n      <button class=\"btn-refresh\">\r\n        <img src=\"@/assets/icons/refresh.svg\" alt=\"Оновити\">\r\n      </button>\r\n    </div>\r\n    <div class=\"search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Ім'я</th>\r\n          <th>Номер телефону</th>\r\n          <th>Інформована згода</th>\r\n          <th>Первинне оцінювання</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"client in clients\" :key=\"client.telegram_id\">\r\n<!--          Якщо змінити ключ на client.id тоді зміниться порядок клієнтів-->\r\n          <td>{{ client.name }}</td>\r\n          <td>{{ client.phone }}</td>\r\n          <td>{{ client.was_agreed ? 'так' : 'ні' }}</td>\r\n          <td>{{ client.primary_poll_complete ? 'так' : 'ні' }}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\" data-tooltip=\"Надіслати повідомлення\" @click=\"openModal(client.id, client.was_agreed, client.primary_poll_complete)\">\r\n              <img src=\"@/assets/icons/send-template-white.svg\" alt=\"Надіслати повідомлення\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Переглянути\">\r\n              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Редагувати\">\r\n              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Видалити\">\r\n              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">\r\n            </button>\r\n          </td>\r\n\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n<!--  Модальне вікно-->\r\n  <modal-templates\r\n      v-if=\"showModal\"\r\n      :templates=\"templates\"\r\n      :showModal=\"showModal\"\r\n      :selectedClientId=\"selectedClientId\"\r\n      :clientWasAgreed=\"clientWasAgreedConsent\"\r\n      :clientPrimaryPollComplete=\"clientPrimaryPollComplete\"\r\n      @close=\"showModal = false\"\r\n  />\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport M from 'materialize-css';\r\nimport { ref } from 'vue';\r\nimport ModalTemplates from \"@/components/modal/ModalTemplates.vue\";\r\nimport {useRouter} from \"vue-router\";\r\nexport default {\r\n  name: \"AllClient\",\r\n  components: {\r\n    ModalTemplates\r\n  },\r\n  setup() {\r\n    const showModal = ref(false);\r\n    const clients = ref([]);\r\n    const templates = ref([]);\r\n    const selectedClientId = ref(null); // зберігання ID вибраного клієнта\r\n    const clientWasAgreedConsent = ref(false);\r\n    const clientPrimaryPollComplete = ref(false);\r\n    const router = useRouter();\r\n\r\n    const fetchClients = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getClients(token);\r\n          if (response && response.data && response.data.data) {\r\n            clients.value = response.data.data; // Зберігання даних клієнтів у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n        M.toast({ html: `Увійдіть у систему` });\r\n      }\r\n    };\r\n\r\n    const fetchTemplates = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getForms(token);\r\n          if (response && response.data && response.data.data) {\r\n            templates.value = response.data.data; // Зберігання даних форм у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        // console.error('Error fetching clients:', error);\r\n        M.toast({ html: `Увійдіть у систему` });\r\n        router.push('/login');\r\n      }\r\n    };\r\n\r\n    const openModal = (clientId, clientConsent, clientPrimaryPoll) => {\r\n      showModal.value = true;\r\n      selectedClientId.value = clientId;\r\n      console.log(`ID клієнта для відправки ${selectedClientId.value}`);\r\n      clientWasAgreedConsent.value = clientConsent;\r\n      console.log(`Клієнт прийняв інформовану згоду ${clientWasAgreedConsent.value}`);\r\n      clientPrimaryPollComplete.value = clientPrimaryPoll;\r\n      console.log(`Клієнт пройшов первинне опитування ${clientPrimaryPollComplete.value}`);\r\n      fetchTemplates();\r\n    };\r\n\r\n    // Перенесіть логіку з mounted сюди, якщо потрібно запустити щось при створенні компонента\r\n    fetchClients();\r\n\r\n    return {\r\n      clients,\r\n      showModal,\r\n      openModal,\r\n      templates,\r\n      selectedClientId,\r\n      clientWasAgreedConsent,\r\n      clientPrimaryPollComplete\r\n    }\r\n  }\r\n};\r\n</script>"],"mappings":";AAyEA,OAAOA,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,SAASC,GAAE,QAAS,KAAK;AACzB,OAAOC,cAAa,MAAO,uCAAuC;AAClE,SAAQC,SAAS,QAAO,YAAY;AACpC,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVH;EACF,CAAC;EACDI,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIN,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMO,OAAM,GAAIP,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMQ,SAAQ,GAAIR,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMS,gBAAe,GAAIT,GAAG,CAAC,IAAI,CAAC,EAAE;IACpC,MAAMU,sBAAqB,GAAIV,GAAG,CAAC,KAAK,CAAC;IACzC,MAAMW,yBAAwB,GAAIX,GAAG,CAAC,KAAK,CAAC;IAC5C,MAAMY,MAAK,GAAIV,SAAS,CAAC,CAAC;IAE1B,MAAMW,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;QAC7C,IAAIF,KAAK,EAAE;UACT,MAAMG,QAAO,GAAI,MAAMnB,UAAU,CAACoB,UAAU,CAACJ,KAAK,CAAC;UACnD,IAAIG,QAAO,IAAKA,QAAQ,CAACE,IAAG,IAAKF,QAAQ,CAACE,IAAI,CAACA,IAAI,EAAE;YACnDZ,OAAO,CAACa,KAAI,GAAIH,QAAQ,CAACE,IAAI,CAACA,IAAI,EAAE;UACtC;QACF;MACF,EAAE,OAAOE,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;QAC/CtB,CAAC,CAACwB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAoB,CAAC,CAAC;MACzC;IACF,CAAC;IAED,MAAMC,cAAa,GAAI,MAA