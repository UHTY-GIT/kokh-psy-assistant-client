{"ast":null,"code":"import { toDisplayString as _toDisplayString, createElementVNode as _createElementVNode, createCommentVNode as _createCommentVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", null, [_createElementVNode(\"h1\", null, \"Активна сесія для \" + _toDisplayString($setup.clientName), 1 /* TEXT */), _createCommentVNode(\" Display form data here \")]);\n}","map":{"version":3,"names":["_createElementBlock","_createElementVNode","_toDisplayString","$setup","clientName","_createCommentVNode"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\ActiveSessionPage.vue"],"sourcesContent":["<!--src/views/ActiveSession.vue-->\r\n<template>\r\n  <div>\r\n    <h1>Активна сесія для {{ clientName }}</h1>\r\n    <!-- Display form data here -->\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  setup() {\r\n    const route = useRoute();\r\n    const clientId = ref(route.params.clientId);\r\n    const clientName = ref(route.params.clientName);\r\n    const customFormId = ref(route.params.customFormId);\r\n    const customFormTitle = ref(route.params.customFormTitle);\r\n    const formData = ref([]);\r\n\r\n    const fetchFormData = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          return;\r\n        }\r\n        const response = await apiService.getCustomFormById(customFormId.value);\r\n        formData.value = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching form data:', error);\r\n      }\r\n    };\r\n\r\n    onMounted(fetchFormData);\r\n\r\n    return {\r\n      clientId,\r\n      clientName,\r\n      customFormId,\r\n      customFormTitle,\r\n      formData\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;uBAEEA,mBAAA,CAGM,cAFJC,mBAAA,CAA2C,YAAvC,oBAAkB,GAAAC,gBAAA,CAAGC,MAAA,CAAAC,UAAU,kBACnCC,mBAAA,4BAA+B,C"},"metadata":{},"sourceType":"module","externalDependencies":[]}