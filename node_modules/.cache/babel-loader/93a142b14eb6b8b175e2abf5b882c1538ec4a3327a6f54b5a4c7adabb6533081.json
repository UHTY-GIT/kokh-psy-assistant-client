{"ast":null,"code":"import apiService from '@/services/apiService';\nimport defaultUserPhoto from '@/assets/photo/Potted Plant.svg';\nimport defaultBackgroundImage from '@/assets/photo/back-users-1.png';\n//import { mapState } from 'vuex';\nexport default {\n  name: 'NavBar',\n  data() {\n    return {\n      userPhoto: defaultUserPhoto,\n      userName: '',\n      backgroundImage: defaultBackgroundImage\n    };\n  },\n  async mounted() {\n    try {\n      const token = localStorage.getItem('token');\n      console.log(token);\n      if (token) {\n        const userProfile = await apiService.getUserProfile(token);\n        if (userProfile && userProfile.data) {\n          this.userName = userProfile.data.name || 'Unknown'; // Використовуйте значення за замовчуванням, якщо ім'я недоступне\n          this.userPhoto = userProfile.data.avatar || defaultUserPhoto;\n          this.backgroundImage = userProfile.data.backgroundImage || defaultBackgroundImage;\n        }\n      }\n    } catch (error) {\n      console.error('Error fetching user profile:', error);\n    }\n  }\n};","map":{"version":3,"names":["apiService","defaultUserPhoto","defaultBackgroundImage","name","data","userPhoto","userName","backgroundImage","mounted","token","localStorage","getItem","console","log","userProfile","getUserProfile","avatar","error"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\app\\NavBar.vue"],"sourcesContent":["<template>\r\n  <div :style=\"{ backgroundImage: `url(${backgroundImage})` }\" class=\"background-navbar\">\r\n    <div class=\"container-user-photo\">\r\n      <router-link to=\"/profile\">\r\n        <div class=\"user-photo\">\r\n          <img :src=\"userPhoto\" alt=\"user photo\">\r\n        </div>\r\n        <span class=\"container-user-name\">\r\n          {{ userName }}\r\n        </span>\r\n      </router-link>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport 