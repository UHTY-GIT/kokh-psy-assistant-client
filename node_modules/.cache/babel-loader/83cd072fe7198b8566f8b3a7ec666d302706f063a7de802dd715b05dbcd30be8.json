ta);\r\n\r\n    return {\r\n      formData,\r\n      clientId,\r\n      clientName,\r\n      customFormId,\r\n      customFormTitle,\r\n      sessionNumber\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAiDA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIH,QAAQ,CAAC,CAAC;IAGxB,MAAMI,QAAO,GAAID,KAAK,CAACE,KAAK,CAACD,QAAQ;IACrC,MAAME,UAAS,GAAIH,KAAK,CAACE,KAAK,CAACC,UAAU;IACzC,MAAMC,YAAW,GAAIJ,KAAK,CAACE,KAAK,CAACE,YAAY;IAC7C,MAAMC,eAAc,GAAIL,KAAK,CAACE,KAAK,CAACG,eAAe;IACnD,MAAMC,aAAY,GAAIN,KAAK,CAACE,KAAK,CAACI,aAAa;IAE/C,MAAMC,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACV,MAAM,IAAIG,KAAK,CAAC,+BAA+B,CAAC;QAClD;QACA,MAAMC,QAAO,GAAI,MAAMd,UAAU,CAACe,iBAAiB,CAACT,YAAY,CAAC;QACjEU,OAAO,CAACC,GAAG,CAACH,QAAQ;MACtB,EAAE,OAAOI,KAAK,EAAE;QACdF,OAAO,CAACE,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;MACnD;IACF,CAAC;IAEDpB,SAAS,CAACW,aAAa,CAAC;IAExB,OAAO;MACLU,QAAQ;MACRhB,QAAQ;MACRE,UAAU;MACVC,YAAY;MACZC,eAAe;MACfC;IACF,CAAC;EACH;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}