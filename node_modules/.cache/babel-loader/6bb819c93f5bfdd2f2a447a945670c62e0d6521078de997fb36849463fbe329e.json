{"ast":null,"code":"import calendarIcon from '@/assets/icons/calendar.svg';\nimport mySessionIcon from '@/assets/icons/checklist.svg';\nimport clientsIcon from '@/assets/icons/users-avatar.svg';\nimport supportIcon from '@/assets/icons/handshake.svg';\nimport bankInformationIcon from '@/assets/icons/info.svg';\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\nexport default {\n  name: 'SideBar',\n  data: () => ({\n    links: [{\n      title: 'Календар',\n      url: '/',\n      icon: calendarIcon\n    }, {\n      title: 'Мої сесії',\n      url: '/allpodcast',\n      exact: true,\n      icon: mySessionIcon\n    }, {\n      title: 'Клієнти',\n      url: '/podcast',\n      exact: true,\n      icon: clientsIcon\n    }, {\n      title: 'Підтримка',\n      url: '/saved',\n      exact: true,\n      icon: supportIcon\n    }, {\n      title: 'Банк інфомації',\n      url: '/categories',\n      exact: true,\n      icon: bankInformationIcon\n    }]\n  }),\n  setup() {\n    const timezone = ref('Europe/Kiev'); // Default timezone\n    const currentTime = ref(new Date());\n    const updateCurrentTime = () => {\n      currentTime.value = new Date();\n    };\n    const formattedTime = computed(() => {\n      const options = {\n        timeZone: timezone.value,\n        hour: '2-digit',\n        minute: '2-digit',\n        hour12: false\n      };\n      const formatter = new Intl.DateTimeFormat('en-US', options);\n      const [hours, minutes] = formatter.format(currentTime.value).split(':');\n      return {\n        hours,\n        minutes\n      };\n    });\n    let intervalId;\n    onMounted(() => {\n      intervalId = setInterval(updateCurrentTime, 1000);\n    });\n    onUnmounted(() => {\n      clearInterval(intervalId);\n    });\n    return {\n      currentTime,\n      formattedTime,\n      timezone\n    };\n  }\n};","map":{"version":3,"names":["calendarIcon","mySessionIcon","clientsIcon","supportIcon","bankInformationIcon","ref","computed","onMounted","onUnmounted","name","data","links","title","url","icon","exact","setup","timezone","currentTime","Date","updateCurrentTime","value","formattedTime","options","timeZone","hour","minute","hour12","formatter","Intl","DateTimeFormat","hours","minutes","format","split","intervalId","setInterval","clearInterval"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\app\\SideBar.vue"],"sourcesContent":["<template>\r\n  <div class=\"sidebar\">\r\n    <div class=\"upper-block\">\r\n      <div class=\"clock-block\">\r\n        <div class=\"flip-clock\">\r\n          <div class=\"number number-hours\">{{ formattedTime.hours }}</div>\r\n          <div class=\"divider\">:</div>\r\n          <div class=\"number number-minutes\">{{ formattedTime.minutes }}</div>\r\n        </div>\r\n        <div class=\"timezone\">Timezone: {{ timezone }}</div>\r\n      </div>\r\n      <div class=\"block-navigation\">\r\n        <div class=\"title-navigation\">\r\n          <img class=\"menu-icon\" src=\"@/assets/icons/House%20With%20Garden.svg\" alt=\"icon Home\">\r\n          <span>Навігація</span>\r\n        </div>\r\n        <nav>\r\n          <ul class=\"menu ul\">\r\n            <router-link\r\n                v-for=\"link in links\"\r\n                :key=\"link.url\"\r\n                :to=\"link.url\"\r\n\r\n                active-class=\"active\"\r\n                custom\r\n                v-slot=\"{ navigate, isActive }\"\r\n            >\r\n              <li\r\n                  class=\"menu-item\"\r\n                  :class=\"{ 'active': isActive }\"\r\n                  @click=\"navigate\"\r\n              >\r\n                <img :src=\"link.icon\" :alt=\"`${link.title} icon`\">\r\n                <span>{{ link.title }}</span>\r\n              </li>\r\n            </router-link>\r\n          </ul>\r\n        </nav>\r\n      </div>\r\n    </div>\r\n    <div class=\"under-block\">\r\n      <div class=\"title-notification\">\r\n        <img class=\"menu-icon\" src=\"@/assets/icons/Speech%20Balloon.svg\" alt=\"icon Notification\">\r\n        <span>Примітка</span>\r\n      </div>\r\n      <div class=\"button-add-notf\">\r\n        <button class=\"btn\">\r\n          <img src=\"@/assets/icons/more.svg\" alt=\"icon add\">\r\n          <span>Додати примітку</span>\r\n        </button>\r\n      </div>\r\n      <div class=\"block-notification\">\r\n        <div class=\"notification-text\">\r\n          <img src=\"@/assets/icons/edit.svg\" alt=\"icon edit\">\r\n          <span>Не забути перевірити нові оновлення в розділі \"Календар\"!</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport calendarIcon from '@/assets/icons/calendar.svg';\r\nimport mySessionIcon from '@/assets/icons/checklist.svg';\r\nimport clientsIcon from '@/assets/icons/users-avatar.svg';\r\nimport supportIcon from '@/assets/icons/handshake.svg';\r\nimport bankInformationIcon from '@/assets/icons/info.svg';\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\r\nexport default {\r\n  name: 'SideBar',\r\n  data: () => ({\r\n    links: [\r\n      { title: 'Календар', url: '/', icon: calendarIcon },\r\n      { title: 'Мої сесії', url: '/allpodcast', exact: true, icon: mySessionIcon },\r\n      { title: 'Клієнти', url: '/podcast', exact: true, icon: clientsIcon },\r\n      { title: 'Підтримка', url: '/saved', exact: true, icon: supportIcon },\r\n      { title: 'Банк інфомації', url: '/categories', exact: true, icon: bankInformationIcon },\r\n    ],\r\n  }),\r\n  setup() {\r\n    const timezone = ref('Europe/Kiev'); // Default timezone\r\n    const currentTime = ref(new Date());\r\n\r\n    const updateCurrentTime = () => {\r\n      currentTime.value = new Date();\r\n    };\r\n\r\n    const formattedTime = computed(() => {\r\n      const options = {\r\n        timeZone: timezone.value,\r\n        hour: '2-digit',\r\n        minute: '2-digit',\r\n        hour12: false,\r\n      };\r\n      const formatter = new Intl.DateTimeFormat('en-US', options);\r\n      const [hours, minutes] = formatter.format(currentTime.value).split(':');\r\n      return { hours, minutes };\r\n    });\r\n\r\n    let intervalId;\r\n    onMounted(() => {\r\n      intervalId = setInterval(updateCurrentTime, 1000);\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      clearInterval(intervalId);\r\n    });\r\n\r\n    return {\r\n      currentTime,\r\n      formattedTime,\r\n      timezone,\r\n    };\r\n  },\r\n}\r\n</script>\r\n<style scoped>\r\n.flip-clock {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background-color: #60A0C0;\r\n  border-radius: 10px;\r\n  font-family: 'Helvetica Neue', sans-serif;\r\n  color: #fff;\r\n  padding: 10px;\r\n}\r\n\r\n.number {\r\n  background-color: #72A8BA;\r\n  border-radius: 5px;\r\n  padding: 10px 20px;\r\n  margin: 0 10px;\r\n  font-size: 2rem;\r\n}\r\n\r\n.divider {\r\n  font-size: 2rem;\r\n}\r\n\r\n.timezone {\r\n  margin-top: 10px;\r\n  text-align: center;\r\n  color: #fff;\r\n}\r\n</style>"],"mappings":"AA6DA,OAAOA,YAAW,MAAO,6BAA6B;AACtD,OAAOC,aAAY,MAAO,8BAA8B;AACxD,OAAOC,WAAU,MAAO,iCAAiC;AACzD,OAAOC,WAAU,MAAO,8BAA8B;AACtD,OAAOC,mBAAkB,MAAO,yBAAyB;AACzD,SAASC,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,WAAU,QAAS,KAAK;AAC3D,eAAe;EACbC,IAAI,EAAE,SAAS;EACfC,IAAI,EAAEA,CAAA,MAAO;IACXC,KAAK,EAAE,CACL;MAAEC,KAAK,EAAE,UAAU;MAAEC,GAAG,EAAE,GAAG;MAAEC,IAAI,EAAEd;IAAa,CAAC,EACnD;MAAEY,KAAK,EAAE,WAAW;MAAEC,GAAG,EAAE,aAAa;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEb;IAAc,CAAC,EAC5E;MAAEW,KAAK,EAAE,SAAS;MAAEC,GAAG,EAAE,UAAU;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEZ;IAAY,CAAC,EACrE;MAAEU,KAAK,EAAE,WAAW;MAAEC,GAAG,EAAE,QAAQ;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEX;IAAY,CAAC,EACrE;MAAES,KAAK,EAAE,gBAAgB;MAAEC,GAAG,EAAE,aAAa;MAAEE,KAAK,EAAE,IAAI;MAAED,IAAI,EAAEV;IAAoB,CAAC;EAE3F,CAAC,CAAC;EACFY,KAAKA,CAAA,EAAG;IACN,MAAMC,QAAO,GAAIZ,GAAG,CAAC,aAAa,CAAC,EAAE;IACrC,MAAMa,WAAU,GAAIb,GAAG,CAAC,IAAIc,IAAI,CAAC,CAAC,CAAC;IAEnC,MAAMC,iBAAgB,GAAIA,CAAA,KAAM;MAC9BF,WAA