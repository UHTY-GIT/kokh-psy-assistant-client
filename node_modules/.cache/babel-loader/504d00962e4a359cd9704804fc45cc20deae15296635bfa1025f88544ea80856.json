{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref, onMounted } from 'vue';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\nimport { timezoneNames } from '@progress/kendo-date-math';\nimport '@progress/kendo-date-math/tz/all';\nimport apiService from \"@/services/apiService\";\nexport default {\n  setup() {\n    const profile = ref({\n      name: '',\n      avatar: null,\n      background_photo: null,\n      country: '',\n      timezone: '',\n      birthdate: '',\n      workType: [],\n      qualification: ''\n    });\n    const v$ = useVuelidate(); // Визначено тут для спрощення\n    const fileInputAvatar = ref(null);\n    const fileInputBackPhoto = ref(null);\n    const timezones = ref([]);\n\n    // Отримую дані профілю користувача та заповніть форму\n    const fetchUserProfile = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        const userProfile = await apiService.getUserProfile(token);\n        profile.value = {\n          name: userProfile.name,\n          avatar: userProfile.avatar_url,\n          background_photo: userProfile.background_photo_url,\n          country: userProfile.country,\n          timezone: userProfile.timezone,\n          birthdate: userProfile.birth_date,\n          workType: [],\n          // Assuming this needs to be mapped from userProfile\n          qualification: userProfile.qualification\n        };\n        fileNameAvatar.value = userProfile.avatar_url ? userProfile.avatar_url.split('/').pop() : \"Натисніть щоб вибрати файл\";\n        fileNameImage.value = userProfile.background_photo_url ? userProfile.background_photo_url.split('/').pop() : \"Натисніть щоб вибрати файл\";\n      } catch (error) {\n        console.error('Error fetching user profile:', error);\n      }\n    };\n\n    //Надсилання даних з форми на апі\n    const submitUserProfile = () => {\n      v$.value.$touch();\n      if (!v$.value.$invalid) {\n        console.log('Profile data:', profile.value);\n        // Тут може бути логіка для відправки даних на сервер\n      }\n      const formData = {\n        // name: name.value // Додайте ім'я користувача в дані форми\n      };\n      console.log(formData);\n    };\n    // Створюємо дві реф-змінні для назв файлів\n    const fileNameAvatar = ref(\"Натисніть щоб вибрати файл\");\n    const fileNameImage = ref(\"Натисніть щоб вибрати файл\");\n\n    // Завантаження файлів з компютера (відображення необхідних полів у прелодері)\n    const handleFileUpload = (event, field) => {\n      if (event.target.files.length > 0) {\n        profile.value[field] = event.target.files[0];\n\n        // Оновлюємо назву файлу залежно від поля\n        if (field === 'avatar') {\n          fileNameAvatar.value = event.target.files[0].name;\n        } else if (field === 'background_photo') {\n          fileNameImage.value = event.target.files[0].name;\n        }\n      } else {\n        console.error('Файл не був вибраний');\n      }\n    };\n    const triggerFileInputAvatar = () => {\n      fileInputAvatar.value.click(); // Використовуємо реф для активації кліку на input\n    };\n    const triggerFileInputBackPhoto = () => {\n      fileInputBackPhoto.value.click(); // Використовуємо реф для активації кліку на input\n    };\n\n    // Функція для перемикання типу роботи\n    const toggleWorkType = value => {\n      const index = profile.value.workType.indexOf(value);\n      if (index === -1) {\n        // Якщо значення не знайдено у масиві, додаємо його\n        profile.value.workType.push(value);\n      } else {\n        // Якщо значення знайдено, видаляємо його\n        profile.value.workType.splice(index, 1);\n      }\n    };\n\n    // Завантажуємо часові пояси і налаштовуємо метод натискання\n    onMounted(() => {\n      timezones.value = timezoneNames().filter(zone => zone.includes('/')).sort((a, b) => a.localeCompare(b));\n\n      // часовий пояс за умовчанням\n      profile.value.timezone = timezones.value.includes(profile.value.timezone) ? profile.value.timezone : 'Europe/Kyiv'; // дефолтна тайм-зона\n    });\n    return {\n      profile,\n      v$,\n      submitUserProfile,\n      handleFileUpload,\n      fileNameAvatar,\n      fileNameImage,\n      fileInputAvatar,\n      fileInputBackPhoto,\n      triggerFileInputAvatar,\n      triggerFileInputBackPhoto,\n      timezones,\n      toggleWorkType\n    };\n  },\n  validations() {\n    return {\n      profile: {\n        // Тепер використовуємо profile як реактивне джерело для валідацій\n        name: {\n          required\n        },\n        avatar: {\n          required\n        },\n        background_photo: {\n          required\n        },\n        country: {\n          required\n        },\n        timezone: {\n          required\n        },\n        birthdate: {\n          required\n        },\n        workType: {\n          required\n        },\n        qualification: {\n          required\n        }\n      }\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useVuelidate","required","timezoneNames","apiService","setup","profile","name","avatar","background_photo","country","timezone","birthdate","workType","qualification","v$","fileInputAvatar","fileInputBackPhoto","timezones","fetchUserProfile","token","localStorage","getItem","userProfile","getUserProfile","value","avatar_url","background_photo_url","birth_date","fileNameAvatar","split","pop","fileNameImage","error","console","submitUserProfile","$touch","$invalid","log","formData","handleFileUpload","event","field","target","files","length","triggerFileInputAvatar","click","triggerFileInputBackPhoto","toggleWorkType","index","indexOf","push","splice","filter","zone","includes","sort","a","b","localeCompare","validations"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\profile\\ProfilePsycologistForm.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"update_profile_tittle\">\r\n      <p>\r\n        Оновити дані профілю\r\n      </p>\r\n    </div>\r\n    <div>\r\n      <form class=\"name-update-form\" @submit.prevent=\"submitUserProfile\">\r\n<!--        <div class=\"input-field\">-->\r\n<!--          <input-->\r\n<!--              id=\"name\"-->\r\n<!--              type=\"text\"-->\r\n<!--              v-model.trim=\"name\"-->\r\n<!--              :class=\"{-->\r\n<!--              invalid: v$.name.$dirty && v$.name.required.$invalid,-->\r\n<!--              validate: v$.name.$dirty && !v$.name.required.$invalid-->\r\n<!--            }\"-->\r\n<!--          >-->\r\n<!--          <label for=\"name\">Ім'я</label>-->\r\n<!--          <small-->\r\n<!--              class=\"helper-text invalid\"-->\r\n<!--              v-if=\"v$.name.$dirty && v$.name.required.$invalid\"-->\r\n<!--          >Введіть ваше ім'я</small>-->\r\n<!--        </div>-->\r\n        <!-- Поле для введення імені -->\r\n        <div class=\"input-field-text\">\r\n          <div class=\"container-input\">\r\n            <label for=\"name\">Введіть ім’я</label>\r\n            <input\r\n                id=\"name\"\r\n                type=\"text\"\r\n                v-model.trim=\"profile.name\"\r\n                :class=\"{ 'is-invalid': v$.profile.name.$dirty && v$.profile.name.required.$invalid }\"\r\n                placeholder=\"Введіть ваше повне ім'я\"\r\n            >\r\n          </div>\r\n          <span class=\"validate-error\" v-if=\"v$.profile.name.$dirty && v$.profile.name.required.$invalid\">Це поле не може бути пустим</span>\r\n        </div>\r\n\r\n        <!-- Поля для завантаження файлів -->\r\n        <div class=\"file-upload-field\">\r\n          <div class=\"container-input\">\r\n            <label>Встановити аватар</label>\r\n            <input\r\n                type=\"file\"\r\n                ref=\"fileInputAvatar\"\r\n                @change=\"handleFileUpload($event, 'avatar')\"\r\n                style=\"display: none;\"\r\n            >\r\n            <span class=\"file-chosen\" @click=\"triggerFileInputAvatar\">{{ fileNameAvatar ? fileNameAvatar : \"Натисніть щоб вибрати файл\" }}</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"file-upload-field\">\r\n          <div class=\"container-input\">\r\n            <label>Встановити зображення</label>\r\n            <input\r\n                type=\"file\"\r\n                ref=\"fileInputBackPhoto\"\r\n                @change=\"handleFileUpload($event, 'background_photo')\"\r\n            >\r\n            <span class=\"file-chosen\" @click=\"triggerFileInputBackPhoto\">{{ fileNameImage ? fileNameImage : \"Натисніть щоб вибрати файл\" }}</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"select-field\">\r\n          <div class=\"container-input\">\r\n            <label for=\"timezone\">Встановити тайм-зону</label>\r\n            <select id=\"timezone\" v-model=\"profile.timezone\">\r\n              <option v-for=\"zone in timezones\" :key=\"zone\" :value=\"zone\">{{ zone }}</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Поле для вибору дати -->\r\n        <div class=\"date-field\">\r\n          <div class=\"container-input\">\r\n            <label for=\"birthdate\">Дата народження</label>\r\n            <input\r\n                id=\"birthdate\"\r\n                type=\"date\"\r\n                v-model=\"profile.birthdate\"\r\n            >\r\n          </div>\r\n          <span class=\"validate-error\" v-if=\"v$.profile.birthdate.$dirty && v$.profile.birthdate.required.$invalid\">Це поле не може бути пустим</span>\r\n        </div>\r\n\r\n        <!-- Чекбокси для типу роботи -->\r\n        <div class=\"checkbox-field\">\r\n          <div class=\"container-input\">\r\n            <label>Тип роботи</label>\r\n            <div class=\"checkbox-group\">\r\n              <label class=\"custom-checkbox\">\r\n                <input type=\"checkbox\" v-model=\"profile.workType\" value=\"individual\" />\r\n                <span class=\"checkmark\" @click=\"toggleWorkType('individual')\">\r\n                  <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                    <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                  </svg>\r\n                </span>\r\n                <p>\r\n                  Індивідуальна\r\n                </p>\r\n              </label>\r\n              <label class=\"custom-checkbox\">\r\n                <input type=\"checkbox\" v-model=\"profile.workType\" value=\"couple\"/>\r\n                <span class=\"checkmark\" @click=\"toggleWorkType('couple')\">\r\n                  <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                    <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                  </svg>\r\n                </span>\r\n                <p>\r\n                  Парна\r\n                </p>\r\n              </label>\r\n              <label class=\"custom-checkbox\">\r\n                <input type=\"checkbox\" v-model=\"profile.workType\" value=\"family\" />\r\n                <span class=\"checkmark\" @click=\"toggleWorkType('family')\">\r\n                  <svg class=\"svg-checkmark\" xmlns=\"http://www.w3.org/2000/svg\" width=\"35\" height=\"35\" viewBox=\"0 0 35 35\" fill=\"none\">\r\n                    <path class=\"checkmark-path\" d=\"M5.83301 18.9585L13.1247 26.2502L29.1663 10.2085\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-dasharray=\"32.99833297729492\" stroke-dashoffset=\"32.99833297729492\"/>\r\n                  </svg>\r\n                </span>\r\n                <p>\r\n                  Сімейна\r\n                </p>\r\n              </label>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Текстове поле для кваліфікації -->\r\n        <div class=\"input-field-text\">\r\n          <div class=\"container-input\">\r\n            <label for=\"qualification\">Кваліфікація</label>\r\n            <input\r\n                id=\"qualification\"\r\n                type=\"text\"\r\n                v-model=\"profile.qualification\"\r\n                placeholder=\"Введіть вашу кваліфікацію\"\r\n            >\r\n          </div>\r\n          <span class=\"validate-error\" v-if=\"v$.profile.qualification.$dirty && v$.profile.qualification.required.$invalid\">Це поле не може бути пустим</span>\r\n        </div>\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/edit-form.svg\" alt=\"Edit Button\">\r\n            <span class=\"edit-link\">Оновити</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { required } from '@vuelidate/validators';\r\nimport { timezoneNames } from '@progress/kendo-date-math';\r\nimport '@progress/kendo-date-math/tz/all';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  setup() {\r\n    const profile = ref({\r\n      name: '',\r\n      avatar: null,\r\n      background_photo: null,\r\n      country: '',\r\n      timezone: '',\r\n      birthdate: '',\r\n      workType: [],\r\n      qualification: '',\r\n    });\r\n    const v$ = useVuelidate(); // Визначено тут для спрощення\r\n    const fileInputAvatar = ref(null);\r\n    const fileInputBackPhoto = ref(null);\r\n    const timezones = ref([]);\r\n\r\n\r\n    // Отримую дані профілю користувача та заповніть форму\r\n    const fetchUserProfile = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        const userProfile = await apiService.getUserProfile(token);\r\n        profile.value = {\r\n          name: userProfile.name,\r\n          avatar: userProfile.avatar_url,\r\n          background_photo: userProfile.background_photo_url,\r\n          country: userProfile.country,\r\n          timezone: userProfile.timezone,\r\n          birthdate: userProfile.birth_date,\r\n          workType: [], // Assuming this needs to be mapped from userProfile\r\n          qualification: userProfile.qualification,\r\n        };\r\n        fileNameAvatar.value = userProfile.avatar_url ? userProfile.avatar_url.split('/').pop() : \"Натисніть щоб вибрати файл\";\r\n        fileNameImage.value = userProfile.background_photo_url ? userProfile.background_photo_url.split('/').pop() : \"Натисніть щоб вибрати файл\";\r\n      } catch (error) {\r\n        console.error('Error fetching user profile:', error);\r\n      }\r\n    };\r\n\r\n    //Надсилання даних з форми на апі\r\n    const submitUserProfile = () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        console.log('Profile data:', profile.value);\r\n        // Тут може бути логіка для відправки даних на сервер\r\n      }\r\n      const formData = {\r\n        // name: name.value // Додайте ім'я користувача в дані форми\r\n      };\r\n      console.log(formData);\r\n    }\r\n    // Створюємо дві реф-змінні для назв файлів\r\n    const fileNameAvatar = ref(\"Натисніть щоб вибрати файл\");\r\n    const fileNameImage = ref(\"Натисніть щоб вибрати файл\");\r\n\r\n    // Завантаження файлів з компютера (відображення необхідних полів у прелодері)\r\n    const handleFileUpload = (event, field) => {\r\n      if (event.target.files.length > 0) {\r\n        profile.value[field] = event.target.files[0];\r\n\r\n        // Оновлюємо назву файлу залежно від поля\r\n        if(field === 'avatar') {\r\n          fileNameAvatar.value = event.target.files[0].name;\r\n        } else if(field === 'background_photo') {\r\n          fileNameImage.value = event.target.files[0].name;\r\n        }\r\n      } else {\r\n        console.error('Файл не був вибраний');\r\n      }\r\n    }\r\n    const triggerFileInputAvatar = () => {\r\n      fileInputAvatar.value.click(); // Використовуємо реф для активації кліку на input\r\n    }\r\n    const triggerFileInputBackPhoto = () => {\r\n      fileInputBackPhoto.value.click(); // Використовуємо реф для активації кліку на input\r\n    }\r\n\r\n    // Функція для перемикання типу роботи\r\n    const toggleWorkType = (value) => {\r\n      const index = profile.value.workType.indexOf(value);\r\n      if (index === -1) {\r\n        // Якщо значення не знайдено у масиві, додаємо його\r\n        profile.value.workType.push(value);\r\n      } else {\r\n        // Якщо значення знайдено, видаляємо його\r\n        profile.value.workType.splice(index, 1);\r\n      }\r\n    };\r\n\r\n    // Завантажуємо часові пояси і налаштовуємо метод натискання\r\n    onMounted(() => {\r\n      timezones.value = timezoneNames()\r\n          .filter(zone => zone.includes('/'))\r\n          .sort((a, b) => a.localeCompare(b));\r\n\r\n      // часовий пояс за умовчанням\r\n      profile.value.timezone = timezones.value.includes(profile.value.timezone)\r\n          ? profile.value.timezone\r\n          : 'Europe/Kyiv'; // дефолтна тайм-зона\r\n    });\r\n\r\n    return {\r\n      profile,\r\n      v$,\r\n      submitUserProfile,\r\n      handleFileUpload,\r\n      fileNameAvatar,\r\n      fileNameImage,\r\n      fileInputAvatar,\r\n      fileInputBackPhoto,\r\n      triggerFileInputAvatar,\r\n      triggerFileInputBackPhoto,\r\n      timezones,\r\n      toggleWorkType,\r\n    };\r\n  },\r\n  validations() {\r\n    return {\r\n      profile: { // Тепер використовуємо profile як реактивне джерело для валідацій\r\n        name: {required},\r\n        avatar: {required},\r\n        background_photo: {required},\r\n        country: {required},\r\n        timezone: {required},\r\n        birthdate: {required},\r\n        workType: {required},\r\n        qualification: {required},\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>"],"mappings":";AA0JA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAO,QAAS,uBAAuB;AAChD,SAASC,aAAY,QAAS,2BAA2B;AACzD,OAAO,kCAAkC;AACzC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIP,GAAG,CAAC;MAClBQ,IAAI,EAAE,EAAE;MACRC,MAAM,EAAE,IAAI;MACZC,gBAAgB,EAAE,IAAI;MACtBC,OAAO,EAAE,EAAE;MACXC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,QAAQ,EAAE,EAAE;MACZC,aAAa,EAAE;IACjB,CAAC,CAAC;IACF,MAAMC,EAAC,GAAId,YAAY,CAAC,CAAC,EAAE;IAC3B,MAAMe,eAAc,GAAIjB,GAAG,CAAC,IAAI,CAAC;IACjC,MAAMkB,kBAAiB,GAAIlB,GAAG,CAAC,IAAI,CAAC;IACpC,MAAMmB,SAAQ,GAAInB,GAAG,CAAC,EAAE,CAAC;;IAGzB;IACA,MAAMoB,gBAAe,GAAI,MAAAA,CAAA,KAAY;MACnC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMC,WAAU,GAAI,MAAMnB,UAAU,CAACoB,cAAc,CAACJ,KAAK,CAAC;QAC1Dd,OAAO,CAACmB,KAAI,GAAI;UACdlB,IAAI,EAAEgB,WAAW,CAAChB,IAAI;UACtBC,MAAM,EAAEe,WAAW,CAACG,UAAU;UAC9BjB,gBAAgB,EAAEc,WAAW,CAACI,oBAAoB;UAClDjB,OAAO,EAAEa,WAAW,CAACb,OAAO;UAC5BC,QAAQ,EAAEY,WAAW,CAACZ,QAAQ;UAC9BC,SAAS,EAAEW,WAAW,CAACK,UAAU;UACjCf,QAAQ,EAAE,EAAE;UAAE;UACdC,aAAa,EAAES,WAAW,CAACT;QAC7B,CAAC;QACDe,cAAc,CAACJ,KAAI,GAAIF,WAAW,CAACG,UAAS,GAAIH,WAAW,CAACG,UAAU,CAACI,KAAK,CAAC,GAAG,CAAC,CAACC,GAAG,CAAC,IAAI,4BAA4B;QACtHC,aAAa,CAACP,KAAI,GAAIF,WAAW,CAACI,oBAAmB,GAAIJ,WAAW,CAACI,oBAAoB,CAACG,KAAK,CAAC,GAAG,CAAC,CAACC,GAAG,CAAC,IAAI,4BAA4B;MAC3I,EAAE,OAAOE,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,8BAA8B,EAAEA,KAAK,CAAC;MACtD;IACF,CAAC;;IAED;IACA,MAAME,iBAAgB,GAAIA,CAAA,KAAM;MAC9BpB,EAAE,CAACU,KAAK,CAACW,MAAM,CAAC,CAAC;MACjB,IAAI,CAACrB,EAAE,CAACU,KAAK,CAACY,QAAQ,EAAE;QAC