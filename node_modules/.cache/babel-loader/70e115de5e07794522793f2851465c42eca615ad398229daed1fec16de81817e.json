{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport apiService from \"@/services/apiService\";\nimport M from \"materialize-css\";\nexport default {\n  setup() {\n    const consultations = ref([]);\n    const fetchConsultations = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          M.toast({\n            html: 'Будь ласка, увійдіть у систему'\n          });\n          return;\n        }\n        const response = await apiService.getConsultations(token);\n        consultations.value = response.data;\n      } catch (error) {\n        console.error('Error fetching consultations:', error);\n        M.toast({\n          html: 'Помилка завантаження консультацій'\n        });\n      }\n    };\n    const formatDate = date => {\n      if (!date) return '';\n      const d = new Date(date);\n      return d.toLocaleDateString('uk-UA', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit'\n      });\n    };\n    const formatTime = date => {\n      if (!date) return '';\n      const d = new Date(date);\n      return d.toLocaleTimeString('uk-UA', {\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    };\n    onMounted(fetchConsultations);\n    return {\n      consultations,\n      formatDate,\n      formatTime\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","apiService","M","setup","consultations","fetchConsultations","token","localStorage","getItem","toast","html","response","getConsultations","value","data","error","console","formatDate","date","d","Date","toLocaleDateString","year","month","day","formatTime","toLocaleTimeString","hour","minute"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\MySessionPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"search margin-search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Номер сесії</th>\r\n          <th>Час початку сесії</th>\r\n          <th>Дата сесії</th>\r\n          <th>Ім'я клієнта</th>\r\n          <th>Дії</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"consultation in consultations\" :key=\"consultation.id\">\r\n          <td>{{ consultation.number }}</td>\r\n          <td>{{ formatTime(consultation.consultation_date) }}</td>\r\n          <td>{{ formatDate(consultation.consultation_date) }}</td>\r\n          <td>{{ consultation.client.first_name }}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/status.svg\" alt=\"Статус\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/share.svg\" alt=\"Почати сесію\">\r\n            </button>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport apiService from \"@/services/apiService\";\r\nimport M from \"materialize-css\";\r\n\r\nexport default {\r\n  setup() {\r\n    const consultations = ref([]);\r\n\r\n    const fetchConsultations = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          M.toast({html: 'Будь ласка, увійдіть у систему'});\r\n          return;\r\n        }\r\n        const response = await apiService.getConsultations(token);\r\n        consultations.value = response.data;\r\n      } catch (error) {\r\n        console.error('Error fetching consultations:', error);\r\n        M.toast({html: 'Помилка завантаження консультацій'});\r\n      }\r\n    };\r\n\r\n    const formatDate = (date) => {\r\n      if (!date) return '';\r\n      const d = new Date(date);\r\n      return d.toLocaleDateString('uk-UA', {year: 'numeric', month: '2-digit', day: '2-digit'});\r\n    };\r\n\r\n    const formatTime = (date) => {\r\n      if (!date) return '';\r\n      const d = new Date(date);\r\n      return d.toLocaleTimeString('uk-UA', {hour: '2-digit', minute: '2-digit'});\r\n    };\r\n\r\n    onMounted(fetchConsultations);\r\n\r\n    return {\r\n      consultations,\r\n      formatDate,\r\n      formatTime\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAiDA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,CAAA,MAAO,iBAAiB;AAE/B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,aAAY,GAAIL,GAAG,CAAC,EAAE,CAAC;IAE7B,MAAMM,kBAAiB,GAAI,MAAAA,CAAA,KAAY;MACrC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVJ,CAAC,CAACO,KAAK,CAAC;YAACC,IAAI,EAAE;UAAgC,CAAC,CAAC;UACjD;QACF;QACA,MAAMC,QAAO,GAAI,MAAMV,UAAU,CAACW,gBAAgB,CAACN,KAAK,CAAC;QACzDF,aAAa,CAACS,KAAI,GAAIF,QAAQ,CAACG,IAAI;MACrC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,+BAA+B,EAAEA,KAAK,CAAC;QACrDb,CAAC,CAACO,KAAK,CAAC;UAACC,IAAI,EAAE;QAAmC,CAAC,CAAC;MACtD;IACF,CAAC;IAED,MAAMO,UAAS,GAAKC,IAAI,IAAK;MAC3B,IAAI,CAACA,IAAI,EAAE,OAAO,EAAE;MACpB,MAAMC,CAAA,GAAI,IAAIC,IAAI,CAACF,IAAI,CAAC;MACxB,OAAOC,CAAC,CAACE,kBAAkB,CAAC,OAAO,EAAE;QAACC,IAAI,EAAE,SAAS;QAAEC,KAAK,EAAE,SAAS;QAAEC,GAAG,EAAE;MAAS,CAAC,CAAC;IAC3F,CAAC;IAED,MAAMC,UAAS,GAAKP,IAAI,IAAK;MAC3B,IAAI,CAACA,IAAI,EAAE,OAAO,EAAE;MACpB,MAAMC,CAAA,GAAI,IAAIC,IAAI,CAACF,IAAI,CAAC;MACxB,OAAOC,CAAC,CAACO,kBAAkB,CAAC,OAAO,EAAE;QAACC,IAAI,EAAE,SAAS;QAAEC,MAAM,EAAE;MAAS,CAAC,CAAC;IAC5E,CAAC;IAED5B,SAAS,CAACK,kBAAkB,CAAC;IAE7B,OAAO;MACLD,aAAa;MACba,UAAU;MACVQ;IACF,CA