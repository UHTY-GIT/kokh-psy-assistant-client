{"ast":null,"code":"import M from 'materialize-css';\nexport default {\n  props: {\n    templates: Array,\n    showModal: Boolean,\n    selectedClientId: Number,\n    clientWasAgreed: Boolean,\n    clientPrimaryPollComplete: Boolean\n  },\n  data() {\n    return {\n      selectedTemplateId: '' // Додано змінну для зберігання вибраного ID шаблону\n    };\n  },\n  methods: {\n    closeModal() {\n      this.$emit('close'); // Емітуйте подію 'close'\n    },\n    sendTemplate() {\n      if (this.selectedTemplateId && this.selectedClientId) {\n        // M.toast({ html: `Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.` });\n        M.toast({\n          html: `Шаблон надіслано.`\n        });\n        // console.log(`Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.`);\n\n        // Створюємо унікальне посилання\n        const uniqueLink = `http://localhost:8080/send-form?client=${this.selectedClientId}&template=${this.selectedTemplateId}`;\n        // console.log('Посилання для відправки:', uniqueLink);\n        // Відкриваємо посилання у новій вкладці\n        window.open(uniqueLink, '_blank');\n        this.closeModal(); // Закриття модального вікна після відправки\n      } else {\n        M.toast({\n          html: `Будь ласка, виберіть шаблон для відправки.`\n        });\n      }\n    }\n  },\n  computed: {\n    filteredTemplates() {\n      // Якщо клієнт дав згоду, виключаємо шаблони з типом 'consent_individual' та 'consent_couple'\n      // Якщо клієнт пройшов первинне опитування, виключаємо 'primary_poll_individual' та 'primary_poll_couple'\n      return this.templates.filter(template => {\n        const isConsentType = ['consent_individual', 'consent_couple'].includes(template.form_type);\n        const isPrimaryPollType = ['primary_poll_individual', 'primary_poll_couple'].includes(template.form_type);\n        if (this.clientWasAgreed && isConsentType) {\n          return false;\n        }\n        if (this.clientPrimaryPollComplete && isPrimaryPollType) {\n          return false;\n        }\n        return true;\n      });\n    }\n  }\n};","map":{"version":3,"names":["M","props","templates","Array","showModal","Boolean","selectedClientId","Number","clientWasAgreed","clientPrimaryPollComplete","data","selectedTemplateId","methods","closeModal","$emit","sendTemplate","toast","html","uniqueLink","window","open","computed","filteredTemplates","filter","template","isConsentType","includes","form_type","isPrimaryPollType"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\modal\\ModalTemplates.vue"],"sourcesContent":["<!--src/components/modal/ModalTemplates.vue-->\r\n<template>\r\n  <div :class=\"{ 'modal-window': true, 'is-active': showModal }\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-close-butt\">\r\n        <img src=\"@/assets/icons/close-modal.svg\" alt=\"close\" @click=\"closeModal\">\r\n      </div>\r\n      <div class=\"modal-content-all\">\r\n        <p>Виберіть шаблон для відправки</p>\r\n        <div class=\"chosen-templates select-field\">\r\n          <div class=\"container-input\">\r\n            <select v-model=\"selectedTemplateId\">\r\n              <option disabled value=\"\">Будь ласка, виберіть шаблон</option>\r\n              <option v-for=\"template in templates\" :value=\"template.id\" :key=\"template.id\">{{ template.title }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"modal-btn\">\r\n            <button class=\"btn-send-templates\" @click=\"sendTemplate\">Надіслати</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport M from 'materialize-css';\r\nexport default {\r\n  props: {\r\n    templates: Array,\r\n    showModal: Boolean,\r\n    selectedClientId: Number,\r\n    clientWasAgreed: Boolean,\r\n    clientPrimaryPollComplete: Boolean\r\n  },\r\n  data() {\r\n    return {\r\n      selectedTemplateId: '' // Додано змінну для зберігання вибраного ID шаблону\r\n    };\r\n  },\r\n  methods: {\r\n    closeModal() {\r\n      this.$emit('close'); // Емітуйте подію 'close'\r\n    },\r\n    sendTemplate() {\r\n      if (this.selectedTemplateId && this.selectedClientId) {\r\n\r\n        // M.toast({ html: `Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.` });\r\n        M.toast({ html: `Шаблон надіслано.` });\r\n        // console.log(`Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.`);\r\n\r\n        // Створюємо унікальне посилання\r\n        const uniqueLink = `http://localhost:8080/send-form?client=${this.selectedClientId}&template=${this.selectedTemplateId}`;\r\n        // console.log('Посилання для відправки:', uniqueLink);\r\n        // Відкриваємо посилання у новій вкладці\r\n        window.open(uniqueLink, '_blank');\r\n\r\n        this.closeModal(); // Закриття модального вікна після відправки\r\n      } else {\r\n        M.toast({ html: `Будь ласка, виберіть шаблон для відправки.` });\r\n      }\r\n    }\r\n  },\r\n  computed: {\r\n    filteredTemplates() {\r\n      // Якщо клієнт дав згоду, виключаємо шаблони з типом 'consent_individual' та 'consent_couple'\r\n      // Якщо клієнт пройшов первинне опитування, виключаємо 'primary_poll_individual' та 'primary_poll_couple'\r\n      return this.templates.filter(template => {\r\n        const isConsentType = ['consent_individual', 'consent_couple'].includes(template.form_type);\r\n        const isPrimaryPollType = ['primary_poll_individual', 'primary_poll_couple'].includes(template.form_type);\r\n        if (this.clientWasAgreed && isConsentType) {\r\n          return false;\r\n        }\r\n        if (this.clientPrimaryPollComplete && isPrimaryPollType) {\r\n          return false;\r\n        }\r\n        return true;\r\n      });\r\n    }\r\n  },\r\n};\r\n</script>\r\n<style>\r\n.modal-window {\r\n  position: fixed;\r\n  z-index: 1;\r\n  left: 0;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  overflow: auto;\r\n  background-color: rgb(56 94 108 / 43%);\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: #FDF8F3;\r\n  margin: auto;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  width: 600px;\r\n  color: #494B55;\r\n}\r\n.modal-content-all p {\r\n  font-family: \"Nunito\", sans-serif;\r\n  font-style: normal;\r\n  font-weight: 700;\r\n  font-size: 20px;\r\n  margin: 10px 0 20px;\r\n  text-align: center;\r\n}\r\n.modal-close-butt {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n.modal-close-butt img {\r\n  cursor: pointer;\r\n}\r\n.modal-window.is-active {\r\n  display: flex;\r\n}\r\n.chosen-templates .container-input select {\r\n  width: 100%;\r\n  height: auto !important;\r\n  margin: 0;\r\n  line-height: normal;\r\n  max-width: none;\r\n}\r\n</style>"],"mappings":"AAyBA,OAAOA,CAAA,MAAO,iBAAiB;AAC/B,eAAe;EACbC,KAAK,EAAE;IACLC,SAAS,EAAEC,KAAK;IAChBC,SAAS,EAAEC,OAAO;IAClBC,gBAAgB,EAAEC,MAAM;IACxBC,eAAe,EAAEH,OAAO;IACxBI,yBAAyB,EAAEJ;EAC7B,CAAC;EACDK,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,kBAAkB,EAAE,EAAC,CAAE;IACzB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACX,IAAI,CAACC,KAAK,CAAC,OAAO,CAAC,EAAE;IACvB,CAAC;IACDC,YAAYA,CAAA,EAAG;MACb,IAAI,IAAI,CAACJ,kBAAiB,IAAK,IAAI,CAACL,gBAAgB,EAAE;QAEpD;QACAN,CAAC,CAACgB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAmB,CAAC,CAAC;QACtC;;QAEA;QACA,MAAMC,UAAS,GAAK,0CAAyC,IAAI,CAACZ,gBAAiB,aAAY,IAAI,CAACK,kBAAmB,EAAC;QACxH;QACA;QACAQ,MAAM,CAACC,IAAI,CAACF,UAAU,EAAE,QAAQ,CAAC;QAEjC,IAAI,CAACL,UAAU,CAAC,CAAC,EAAE;MACrB,OAAO;QACLb,CAAC,CAACgB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAA4C,CAAC,CAAC;MACjE;IACF;EACF,CAAC;EACDI,QAAQ,EAAE;IACRC,iBAAiBA,CAAA,EAAG;MAClB;MACA;MACA,OAAO,IAAI,CAACpB,SAAS,CAACqB,MAAM,CAACC,QAAO,IAAK;QACvC,MAAMC,aAAY,GAAI,CAAC,oBAAoB,EAAE,gBAAgB,CAAC,CAACC,QAAQ,CAACF,QAAQ,CAACG,SAAS,CAAC;QAC3F,MAAMC,iBAAgB,GAAI,CAAC,yBAAyB,EAAE,qBAAqB,CAAC,CAACF,QAAQ,CAACF,QAAQ,CAACG,SAAS,CAAC;QACzG,IAAI,IAAI,CAACnB,eAAc,IAAKiB,aAAa,EAAE;UACzC,OAAO,KAAK;QACd;QACA,IAAI,IAAI,CAAChB,yBAAwB,IAAKmB,iBAAiB,EAAE;UACvD,OAAO,KAAK;QACd;QACA,OAAO,IAAI;MACb,CAAC,CAAC;IACJ;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}