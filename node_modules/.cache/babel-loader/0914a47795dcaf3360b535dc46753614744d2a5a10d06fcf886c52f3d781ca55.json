  <label><input type=\"checkbox\" v-model=\"profile.workType\" value=\"family\"> Сімейна</label>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Текстове поле для кваліфікації -->\r\n        <div class=\"input-field\">\r\n          <label for=\"qualification\">Кваліфікація</label>\r\n          <input\r\n              id=\"qualification\"\r\n              type=\"text\"\r\n              v-model=\"profile.qualification\"\r\n              required\r\n          >\r\n        </div>\r\n\r\n        <button class=\"name-edit\" type=\"submit\">\r\n<!--          <img src=\"@/assets/icons/edit-button-1.png\" alt=\"Edit Button\">-->\r\n          <span class=\"edit-link\">Оновити</span>\r\n        </button>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { ref } from 'vue';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { required } from '@vuelidate/validators'\r\n\r\nexport default {\r\n  setup() {\r\n    const profile = ref({\r\n      name: '',\r\n      avatar: null,\r\n      image: null,\r\n      country: '',\r\n      timezone: '',\r\n      birthdate: '',\r\n      workType: [],\r\n      qualification: '',\r\n    });\r\n    const v$ = useVuelidate({\r\n      name: { required },\r\n      avatar: { required },\r\n      image: { required },\r\n      country: { required },\r\n      timezone: { required },\r\n      birthdate: { required },\r\n      workType: { required },\r\n      qualification: { required },\r\n    }, profile);\r\n    // const v$ = useVuelidate(); // Визначено тут для спрощення\r\n\r\n    const submitUserProfile = () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        console.log('Profile data:', profile.value);\r\n        // Тут може бути логіка для відправки даних на сервер\r\n      }\r\n      const formData = {\r\n        // name: name.value // Додайте ім'я користувача в дані форми\r\n      };\r\n      console.log(formData);\r\n    }\r\n    const handleFileUpload = (event, field) => {\r\n      profile.value[field] = event.target.files[0];\r\n    };\r\n    return {\r\n      profile,\r\n      v$,\r\n      submitUserProfile,\r\n      handleFileUpload\r\n    };\r\n  },\r\n  validations() {\r\n    return {\r\n      profile: { // Тепер використовуємо profile як реактивне джерело для валідацій\r\n        name: {required},\r\n        avatar: {required},\r\n        image: {required},\r\n        country: {required},\r\n        timezone: {required},\r\n        birthdate: {required},\r\n        workType: {required},\r\n        qualification: {required},\r\n      }\r\n    }\r\n  }\r\n  // validations () {\r\n  //   return {\r\n  //     name: { required },\r\n  //     avatar: { required },\r\n  //   }\r\n  // }\r\n}\r\n</script>"],"mappings":"AAgHA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAO,QAAS,uBAAsB;AAE/C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIJ,GAAG,CAAC;MAClBK,IAAI,EAAE,EAAE;MACRC,MAAM,EAAE,IAAI;MACZC,KAAK,EAAE,IAAI;MACXC,OAAO,EAAE,EAAE;MACXC,QAAQ,EAAE,EAAE;MACZC,SAAS,EAAE,EAAE;MACbC,QAAQ,EAAE,EAAE;MACZC,aAAa,EAAE;IACjB,CAAC,CAAC;IACF,MAAMC,EAAC,GAAIZ,YAAY,CAAC;MACtBI,IAAI,EAAE;QAAEH;MAAS,CAAC;MAClBI,MAAM,EAAE;QAAEJ;MAAS,CAAC;MACpBK,KAAK,EAAE;QAAEL;MAAS,CAAC;MACnBM,OAAO,EAAE;QAAEN;MAAS,CAAC;MACrBO,QAAQ,EAAE;QAAEP;MAAS,CAAC;MACtBQ,SAAS,EAAE;QAAER;MAAS,CAAC;MACvBS,QAAQ,EAAE;QAAET;MAAS,CAAC;MACtBU,aAAa,EAAE;QAAEV;MAAS;IAC5B,CAAC,EAAEE,OAAO,CAAC;IACX;;IAEA,MAAMU,iBAAgB,GAAIA,CAAA,KAAM;MAC9BD,EAAE,CAACE,KAAK,CAACC,MAAM,CAAC,CAAC;MACjB,IAAI,CAACH,EAAE,CAACE,KAAK,CAACE,QAAQ,EAAE;QACtBC,OAAO,CAACC,GAAG,CAAC,eAAe,EAAEf,OAAO,CAACW,KAAK,CAAC;QAC3C;MACF;MACA,MAAMK,QAAO,GAAI;QACf;MAAA,CACD;MACDF,OAAO,CAACC,GAAG,CAACC,QAAQ,CAAC;IACvB;IACA,MAAMC,gBAAe,GAAIA,CAACC,KAAK,EAAEC,KAAK,KAAK;MACzCnB,OAAO,CAACW,KAAK,CAACQ,KAAK,IAAID,KAAK,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC,CAAC;IAC9C,CAAC;IACD,OAAO;MACLrB,OAAO;MACPS,EAAE;MACFC,iBAAiB;MACjBO;IACF,CAAC;EACH,CAAC;EACDK,WAAWA,CAAA,EAAG;IACZ,OAAO;MACLtB,OAAO,EAAE;QAAE;QACTC,IAAI,EAAE;UAACH;QAAQ,CAAC;Q