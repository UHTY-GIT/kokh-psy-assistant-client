{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from \"vue\";\nimport useVuelidate from '@vuelidate/core';\nimport { required, minLength } from \"@vuelidate/validators\";\nimport M from \"materialize-css\";\nimport apiService from '@/services/apiService';\nimport { useRouter } from \"vue-router\";\nexport default {\n  setup() {\n    const password = ref('');\n    const newPassword = ref('');\n    const confirmNewPassword = ref('');\n    const v$ = useVuelidate();\n    const router = useRouter();\n\n    // Відправка форми по зміні паролю\n    const submitUserPassword = async () => {\n      v$.value.$touch();\n      if (v$.value.$invalid || newPassword.value !== confirmNewPassword.value) {\n        console.log(\"Validation failed or passwords do not match\");\n        return;\n      }\n      const token = localStorage.getItem('token');\n      if (!token) {\n        console.log(\"Токен не знайдений. Перенаправлення на сторінку входу.\");\n        router.push('/login');\n        return;\n      }\n      try {\n        const response = await apiService.changePassword(token, password.value, newPassword.value, confirmNewPassword.value);\n        M.toast({\n          html: `Пароль успішно змінено`\n        });\n        console.log('Пароль успішно змінено:', response);\n        // Очищення поля вводу\n        password.value = '';\n        newPassword.value = '';\n        confirmNewPassword.value = '';\n      } catch (error) {\n        M.toast({\n          html: `[Помилка]: Пароль змінити не вдалося`\n        });\n        console.log('Помилка при зміні паролю:', error);\n      }\n    };\n\n    // Реактивний стан для перевірки видимості старого пароля\n    const isOldPasswordVisible = ref(false);\n    const OldPasswordIconClass = ref('fas fa-eye-slash');\n\n    // Функція переключення видимості пароля\n    const OldTogglePassword = () => {\n      isOldPasswordVisible.value = !isOldPasswordVisible.value;\n      OldPasswordIconClass.value = isOldPasswordVisible.value ? 'fas fa-eye' : 'fas fa-eye-slash';\n    };\n\n    // Реактивний стан для перевірки видимості нового пароля\n    const isNewPasswordVisible = ref(false);\n    const NewPasswordIconClass = ref('fas fa-eye-slash');\n\n    // Функція переключення видимості пароля\n    const NewTogglePassword = () => {\n      isNewPasswordVisible.value = !isNewPasswordVisible.value;\n      NewPasswordIconClass.value = isNewPasswordVisible.value ? 'fas fa-eye' : 'fas fa-eye-slash';\n    };\n    return {\n      v$,\n      submitUserPassword,\n      OldTogglePassword,\n      NewTogglePassword,\n      isOldPasswordVisible,\n      isNewPasswordVisible,\n      OldPasswordIconClass,\n      NewPasswordIconClass,\n      password,\n      newPassword,\n      confirmNewPassword\n    };\n  },\n  validations() {\n    return {\n      password: {\n        required\n      },\n      newPassword: {\n        required,\n        minLength: minLength(6)\n      },\n      confirmNewPassword: {\n        required,\n        minLength: minLength(6)\n      }\n    };\n  }\n};","map":{"version":3,"names":["ref","useVuelidate","required","minLength","M","apiService","useRouter","setup","password","newPassword","confirmNewPassword","v$","router","submitUserPassword","value","$touch","$invalid","console","log","token","localStorage","getItem","push","response","changePassword","toast","html","error","isOldPasswordVisible","OldPasswordIconClass","OldTogglePassword","isNewPasswordVisible","NewPasswordIconClass","NewTogglePassword","validations"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\profile\\ProfilePasswordForm.vue"],"sourcesContent":["<!--src/components/modal/ProfilePasswordForm.vue-->\r\n<template>\r\n  <div>\r\n    <div class=\"update_profile_tittle\">\r\n      <p>\r\n        Змінити пароль\r\n      </p>\r\n    </div>\r\n    <div>\r\n      <form class=\"password-update-form\" @submit.prevent=\"submitUserPassword\">\r\n        <div class=\"input-field-text\">\r\n          <div class=\"container-input\">\r\n            <label for=\"old-password\">Старий пароль</label>\r\n            <input\r\n                id=\"old-password\"\r\n                :type=\"isOldPasswordVisible ? 'text' : 'password'\"\r\n                v-model.trim=\"password\"\r\n                placeholder=\"Введіть старий пароль\"\r\n            >\r\n            <i class=\"change-password user-page-password\" :class=\"OldPasswordIconClass\" @click=\"OldTogglePassword\"></i>\r\n          </div>\r\n          <span\r\n              class=\"validate-error\"\r\n              v-if=\"v$.password.$dirty && v$.password.required.$invalid\"\r\n          >Введіть старий пароль</span>\r\n        </div>\r\n\r\n        <div class=\"input-field-text\">\r\n          <div class=\"container-input\">\r\n            <label for=\"new-password\">Новий пароль</label>\r\n            <input\r\n                id=\"new-password\"\r\n                :type=\"isNewPasswordVisible ? 'text' : 'password'\"\r\n                v-model.trim=\"newPassword\"\r\n                placeholder=\"Введіть новий пароль\"\r\n            >\r\n            <i class=\"change-password user-page-password\" :class=\"NewPasswordIconClass\" @click=\"NewTogglePassword\"></i>\r\n          </div>\r\n          <span\r\n              class=\"validate-error\"\r\n              v-if=\"v$.newPassword.$dirty && v$.newPassword.required.$invalid\"\r\n          >Введіть новий пароль</span>\r\n          <span\r\n              class=\"validate-error\"\r\n              v-else-if=\"v$.newPassword.$dirty && v$.newPassword.minLength.$invalid\"\r\n          >Новий пароль повинен бути мінімум {{ v$.newPassword.minLength.$params.min }} символів. Зараз він {{ newPassword.length }}</span>\r\n        </div>\r\n\r\n        <div class=\"input-field-text\">\r\n          <div class=\"container-input\">\r\n            <label for=\"confirm-new-password\">Підтвердіть новий пароль</label>\r\n            <input\r\n                id=\"confirm-new-password\"\r\n                :type=\"isNewPasswordVisible ? 'text' : 'password'\"\r\n                v-model.trim=\"confirmNewPassword\"\r\n                placeholder=\"Підтвердіть новий пароль\"\r\n            >\r\n            <i class=\"change-password user-page-password\" :class=\"NewPasswordIconClass\" @click=\"NewTogglePassword\"></i>\r\n          </div>\r\n          <span\r\n              class=\"validate-error\"\r\n              v-if=\"v$.confirmNewPassword.$dirty && v$.confirmNewPassword.required.$invalid\"\r\n          >Підтвердіть новий пароль</span>\r\n          <span\r\n              class=\"validate-error\"\r\n              v-else-if=\"v$.confirmNewPassword.$dirty && v$.confirmNewPassword.minLength.$invalid\"\r\n          >Новий пароль повинен бути мінімум {{ v$.confirmNewPassword.minLength.$params.min }} символів. Зараз він {{ confirmNewPassword.length }}</span>\r\n          <span\r\n              class=\"validate-error\"\r\n              v-else-if=\"v$.confirmNewPassword.$dirty && confirmNewPassword !== newPassword\"\r\n          >Паролі не співпадають</span>\r\n        </div>\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"password-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/edit-form.svg\" alt=\"Edit Button\">\r\n            <span class=\"edit-link\">Змінити пароль</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from \"vue\";\r\nimport useVuelidate from '@vuelidate/core';\r\nimport { required, minLength } from \"@vuelidate/validators\";\r\nimport M from \"materialize-css\";\r\nimport apiService from '@/services/apiService';\r\nimport { useRouter } from \"vue-router\";\r\n\r\nexport default {\r\n  setup () {\r\n    const password = ref('');\r\n    const newPassword = ref('');\r\n    const confirmNewPassword = ref('');\r\n\r\n    const v$ = useVuelidate();\r\n    const router = useRouter();\r\n\r\n    // Відправка форми по зміні паролю\r\n    const submitUserPassword = async () => {\r\n      v$.value.$touch();\r\n      if (v$.value.$invalid || newPassword.value !== confirmNewPassword.value) {\r\n        console.log(\"Validation failed or passwords do not match\");\r\n        return;\r\n      }\r\n\r\n      const token = localStorage.getItem('token');\r\n      if (!token) {\r\n        console.log(\"Токен не знайдений. Перенаправлення на сторінку входу.\");\r\n        router.push('/login');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await apiService.changePassword(token, password.value, newPassword.value, confirmNewPassword.value);\r\n        M.toast({ html: `Пароль успішно змінено` });\r\n        console.log('Пароль успішно змінено:', response);\r\n        // Очищення поля вводу\r\n        password.value = '';\r\n        newPassword.value = '';\r\n        confirmNewPassword.value = '';\r\n      } catch (error) {\r\n        M.toast({ html: `[Помилка]: Пароль змінити не вдалося` });\r\n        console.log('Помилка при зміні паролю:', error);\r\n      }\r\n    }\r\n\r\n    // Реактивний стан для перевірки видимості старого пароля\r\n    const isOldPasswordVisible = ref(false);\r\n    const OldPasswordIconClass = ref('fas fa-eye-slash');\r\n\r\n    // Функція переключення видимості пароля\r\n    const OldTogglePassword = () => {\r\n      isOldPasswordVisible.value = !isOldPasswordVisible.value;\r\n      OldPasswordIconClass.value = isOldPasswordVisible.value ? 'fas fa-eye' : 'fas fa-eye-slash';\r\n    }\r\n\r\n    // Реактивний стан для перевірки видимості нового пароля\r\n    const isNewPasswordVisible = ref(false);\r\n    const NewPasswordIconClass = ref('fas fa-eye-slash');\r\n\r\n    // Функція переключення видимості пароля\r\n    const NewTogglePassword = () => {\r\n      isNewPasswordVisible.value = !isNewPasswordVisible.value;\r\n      NewPasswordIconClass.value = isNewPasswordVisible.value ? 'fas fa-eye' : 'fas fa-eye-slash';\r\n    }\r\n\r\n    return {\r\n      v$,\r\n      submitUserPassword,\r\n      OldTogglePassword,\r\n      NewTogglePassword,\r\n      isOldPasswordVisible,\r\n      isNewPasswordVisible,\r\n      OldPasswordIconClass,\r\n      NewPasswordIconClass,\r\n      password,\r\n      newPassword,\r\n      confirmNewPassword,\r\n    }\r\n  },\r\n  validations () {\r\n    return {\r\n      password: { required },\r\n      newPassword: { required, minLength: minLength(6) },\r\n      confirmNewPassword: { required, minLength: minLength(6) }\r\n    }\r\n  },\r\n}\r\n</script>\r\n"],"mappings":";AAoFA,SAASA,GAAE,QAAS,KAAK;AACzB,OAAOC,YAAW,MAAO,iBAAiB;AAC1C,SAASC,QAAQ,EAAEC,SAAQ,QAAS,uBAAuB;AAC3D,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,SAASC,SAAQ,QAAS,YAAY;AAEtC,eAAe;EACbC,KAAIA,CAAA,EAAK;IACP,MAAMC,QAAO,GAAIR,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMS,WAAU,GAAIT,GAAG,CAAC,EAAE,CAAC;IAC3B,MAAMU,kBAAiB,GAAIV,GAAG,CAAC,EAAE,CAAC;IAElC,MAAMW,EAAC,GAAIV,YAAY,CAAC,CAAC;IACzB,MAAMW,MAAK,GAAIN,SAAS,CAAC,CAAC;;IAE1B;IACA,MAAMO,kBAAiB,GAAI,MAAAA,CAAA,KAAY;MACrCF,EAAE,CAACG,KAAK,CAACC,MAAM,CAAC,CAAC;MACjB,IAAIJ,EAAE,CAACG,KAAK,CAACE,QAAO,IAAKP,WAAW,CAACK,KAAI,KAAMJ,kBAAkB,CAACI,KAAK,EAAE;QACvEG,OAAO,CAACC,GAAG,CAAC,6CAA6C,CAAC;QAC1D;MACF;MAEA,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;MAC3C,IAAI,CAACF,KAAK,EAAE;QACVF,OAAO,CAACC,GAAG,CAAC,wDAAwD,CAAC;QACrEN,MAAM,CAACU,IAAI,CAAC,QAAQ,CAAC;QACrB;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMlB,UAAU,CAACmB,cAAc,CAACL,KAAK,EAAEX,QAAQ,CAACM,KAAK,EAAEL,WAAW,CAACK,KAAK,EAAEJ,kBAAkB,CAACI,KAAK,CAAC;QACpHV,CAAC,CAACqB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAwB,CAAC,CAAC;QAC3CT,OAAO,CAACC,GAAG,CAAC,yBAAyB,EAAEK,QAAQ,CAAC;QAChD;QACAf,QAAQ,CAACM,KAAI,GAAI,EAAE;QACnBL,WAAW,CAACK,KAAI,GAAI,EAAE;QACtBJ,kBAAkB,CAACI,KAAI,GAAI,EAAE;MAC/B,EAAE,OAAOa,KAAK,EAAE;QACdvB,CAAC,CAACqB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAsC,CAAC,CAAC;QACzDT,OAAO,CAACC,GAAG,CAAC,2BAA2B,EAAES,KAAK,CAAC;MACjD;IACF;;IAEA;IACA,MAAMC,oBAAmB,GAAI5B,GAAG,CAAC,KAAK,CAAC;IACvC,MAAM