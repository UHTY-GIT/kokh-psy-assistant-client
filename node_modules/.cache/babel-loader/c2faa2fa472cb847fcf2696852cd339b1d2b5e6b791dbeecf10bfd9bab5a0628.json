{"ast":null,"code":"import NavbarLogin from \"@/components/app/NavBar.vue\";\nimport SidebarLogin from \"@/components/app/SideBar.vue\";\nexport default {\n  name: 'main-layout',\n  components: {\n    NavbarLogin,\n    SidebarLogin\n  },\n  data: () => ({\n    isFull: false,\n    isSmall: false\n  }),\n  mounted() {\n    this.checkWindowSize();\n    window.addEventListener('resize', this.checkWindowSize);\n  },\n  beforeUnmount() {\n    window.removeEventListener('resize', this.checkWindowSize);\n  },\n  methods: {\n    checkWindowSize() {\n      // Update isSmall based on window width\n      this.isSmall = window.innerWidth < 750;\n      // Whenever we check the window size, adjust the isFull property too\n      this.isFull = this.isSmall;\n    },\n    toggleSize(isSmall) {\n      this.isFull = isSmall;\n    }\n\n    // toggleSize() {\n    //   this.isFull = !this.isFull;\n    // }\n  }\n};","map":{"version":3,"names":["NavbarLogin","SidebarLogin","name","components","data","isFull","isSmall","mounted","checkWindowSize","window","addEventListener","beforeUnmount","removeEventListener","methods","innerWidth","toggleSize"],"sources":["C:\\Users\\Denys\\WebstormProjects\\assistant-psychologist-client\\src\\layouts\\MainLayout.vue"],"sourcesContent":["<!--src/layouts/MainLayout.vue-->\r\n<template>\r\n  <div class=\"background_main\">\r\n    <NavbarLogin />\r\n    <section class=\"main-section\">\r\n      <SidebarLogin @toggle-size=\"toggleSize\"/>\r\n      <main class=\"site-content app-content\" :class=\"{ full: isFull }\">\r\n        <router-view />\r\n      </main>\r\n    </section>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport NavbarLogin from \"@/components/app/NavBar.vue\";\r\nimport SidebarLogin from \"@/components/app/SideBar.vue\";\r\n\r\nexport default {\r\n  name: 'main-layout',\r\n  components: {\r\n    NavbarLogin, SidebarLogin\r\n  },\r\n  data: () => ({\r\n    isFull: false,\r\n    isSmall: false\r\n  }),\r\n  mounted() {\r\n    this.checkWindowSize();\r\n    window.addEventListener('resize', this.checkWindowSize);\r\n  },\r\n  beforeUnmount() {\r\n    window.removeEventListener('resize', this.checkWindowSize);\r\n  },\r\n  methods: {\r\n    checkWindowSize() {\r\n      // Update isSmall based on window width\r\n      this.isSmall = window.innerWidth < 750;\r\n      // Whenever we check the window size, adjust the isFull property too\r\n      this.isFull = this.isSmall;\r\n    },\r\n    toggleSize(isSmall) {\r\n      this.isFull = isSmall;\r\n    },\r\n\r\n    // toggleSize() {\r\n    //   this.isFull = !this.isFull;\r\n    // }\r\n  }\r\n}\r\n</script>"],"mappings":"AAcA,OAAOA,WAAU,MAAO,6BAA6B;AACrD,OAAOC,YAAW,MAAO,8BAA8B;AAEvD,eAAe;EACbC,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IACVH,WAAW;IAAEC;EACf,CAAC;EACDG,IAAI,EAAEA,CAAA,MAAO;IACXC,MAAM,EAAE,KAAK;IACbC,OAAO,EAAE;EACX,CAAC,CAAC;EACFC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC,CAAC;IACtBC,MAAM,CAACC,gBAAgB,CAAC,QAAQ,EAAE,IAAI,CAACF,eAAe,CAAC;EACzD,CAAC;EACDG,aAAaA,CAAA,EAAG;IACdF,MAAM,CAACG,mBAAmB,CAAC,QAAQ,EAAE,IAAI,CAACJ,eAAe,CAAC;EAC5D,CAAC;EACDK,OAAO,EAAE;IACPL,eAAeA,CAAA,EAAG;MAChB;MACA,IAAI,CAACF,OAAM,GAAIG,MAAM,CAACK,UAAS,GAAI,GAAG;MACtC;MACA,IAAI,CAACT,MAAK,GAAI,IAAI,CAACC,OAAO;IAC5B,CAAC;IACDS,UAAUA,CAACT,OAAO,EAAE;MAClB,IAAI,CAACD,MAAK,GAAIC,OAAO;IACvB;;IAEA;IACA;IACA;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}