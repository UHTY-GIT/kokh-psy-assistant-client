{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport apiService from \"@/services/apiService\";\nexport default {\n  name: 'ActiveSession',\n  props: {\n    clientId: {\n      type: Number,\n      required: true\n    },\n    clientName: {\n      type: String,\n      required: true\n    },\n    customFormId: {\n      type: Number,\n      required: true\n    },\n    customFormTitle: {\n      type: String,\n      required: true\n    },\n    sessionNumber: {\n      type: Number,\n      required: true\n    }\n  },\n  setup(props) {\n    const formData = ref({\n      fields: []\n    });\n    const fetchFormData = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          throw new Error('No authentication token found');\n        }\n        const response = await apiService.getCustomFormById(props.customFormId);\n        formData.value.fields = response.data.fields; // Assuming the response contains fields data\n      } catch (error) {\n        console.error('Error fetching form data:', error);\n      }\n    };\n    onMounted(fetchFormData);\n    return {\n      formData,\n      ...props\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","apiService","name","props","clientId","type","Number","required","clientName","String","customFormId","customFormTitle","sessionNumber","setup","formData","fields","fetchFormData","token","localStorage","getItem","Error","response","getCustomFormById","value","data","error","console"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\ActiveSessionPage.vue"],"sourcesContent":["<!-- src/views/ActiveSessionPage.vue -->\r\n<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Сесія №{{ sessionNumber }}, клієнт {{ clientName }}\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"block_active_session\">\r\n    <div class=\"titte_field\">\r\n      <p>\r\n        Базові поля\r\n      </p>\r\n    </div>\r\n    <div class=\"block_input_field\">\r\n      <form>\r\n        <div class=\"forms-name-add\">\r\n          <div class=\"container-input\">\r\n            <label for=\"main-points-of-the-session\">Основні думки сесії</label>\r\n            <input\r\n                type=\"text\"\r\n                id=\"main-points-of-the-session\"\r\n                placeholder=\"Введіть основні думки по цій сесії\"\r\n            >\r\n          </div>\r\n        </div>\r\n        <div v-for=\"field in formData.fields\" :key=\"field.id\" class=\"forms-name-add\">\r\n          <div class=\"container-input\">\r\n            <label :for=\"field.id\">{{ field.label }}</label>\r\n            <input\r\n                :type=\"field.type\"\r\n                :id=\"field.id\"\r\n                v-model=\"field.value\"\r\n                :placeholder=\"field.placeholder\"\r\n            >\r\n          </div>\r\n        </div>\r\n        <div class=\"container-global-form-edit\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/share.svg\" alt=\"Send name form\">\r\n            <span class=\"edit-link\">Завершити сесію</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  name: 'ActiveSession',\r\n  props: {\r\n    clientId: {\r\n      type: Number,\r\n      required: true\r\n    },\r\n    clientName: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    customFormId: {\r\n      type: Number,\r\n      required: true\r\n    },\r\n    customFormTitle: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    sessionNumber: {\r\n      type: Number,\r\n      required: true\r\n    }\r\n  },\r\n  setup(props) {\r\n    const formData = ref({\r\n      fields: [],\r\n    });\r\n\r\n    const fetchFormData = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          throw new Error('No authentication token found');\r\n        }\r\n        const response = await apiService.getCustomFormById(props.customFormId);\r\n        formData.value.fields = response.data.fields; // Assuming the response contains fields data\r\n      } catch (error) {\r\n        console.error('Error fetching form data:', error);\r\n      }\r\n    };\r\n\r\n    onMounted(fetchFormData);\r\n\r\n    return {\r\n      formData,\r\n      ...props\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAmDA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IACLC,QAAQ,EAAE;MACRC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,UAAU,EAAE;MACVH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ,CAAC;IACDG,YAAY,EAAE;MACZL,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDI,eAAe,EAAE;MACfN,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ,CAAC;IACDK,aAAa,EAAE;MACbP,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDM,KAAKA,CAACV,KAAK,EAAE;IACX,MAAMW,QAAO,GAAIf,GAAG,CAAC;MACnBgB,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACV,MAAM,IAAIG,KAAK,CAAC,+BAA+B,CAAC;QAClD;QACA,MAAMC,QAAO,GAAI,MAAMpB,UAAU,CAACqB,iBAAiB,CAACnB,KAAK,CAACO,YAAY,CAAC;QACvEI,QAAQ,CAACS,KAAK,CAACR,MAAK,GAAIM,QAAQ,CAACG,IAAI,CAACT,MAAM,EAAE;MAChD,EAAE,OAAOU,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;MACnD;IACF,CAAC;IAEDzB,SAAS,CAACgB,aAAa,CAAC;IAExB,OAAO;MACLF,QAAQ;MACR,GAAGX;IACL,CAAC;EACH;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}