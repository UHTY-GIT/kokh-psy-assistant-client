{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { reactive } from 'vue';\nimport apiService from '@/services/apiService';\nimport { useVuelidate } from '@vuelidate/core';\nimport { required } from '@vuelidate/validators';\nimport M from 'materialize-css';\nexport default {\n  setup() {\n    const form = reactive({\n      title: '',\n      formItems: [{\n        field_name: '',\n        field_type: 'text'\n      }],\n      createdFormId: ''\n    });\n    const rules = {\n      title: {\n        required\n      },\n      formItems: {\n        $each: {\n          field_name: {\n            required\n          },\n          field_type: {\n            required\n          }\n        }\n      }\n    };\n\n    // Використання Vuelidate\n    const v$ = useVuelidate(rules, form);\n    // const createdFormId = ref('');\n\n    // Методи\n    const addFormItem = () => {\n      form.formItems.push({\n        field_name: '',\n        field_type: 'text'\n      });\n    };\n    const removeFormItem = index => {\n      form.formItems.splice(index, 1);\n    };\n    const handleSubmit = async () => {\n      v$.value.$touch();\n      if (!v$.value.$invalid) {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          M.toast({\n            html: `Ви не авторизовані`\n          });\n          return;\n        }\n        try {\n          const response = await apiService.createCustomForm(token, form.title, form.primaryPollId);\n          form.createdFormId = response.data.data.id;\n          M.toast({\n            html: `Назву форми успішно задано`\n          });\n        } catch (error) {\n          console.error('Помилка при створенні форми:', error);\n        }\n      }\n    };\n    const submitFormItems = async () => {\n      const token = localStorage.getItem('token');\n      if (this.createdFormId && this.formItems.length) {\n        try {\n          const response = await apiService.createFormItem(token, this.createdFormId, this.formItems);\n          console.log('Елементи форми створені:', response.data.data);\n          M.toast({\n            html: `Форма успішно створена`\n          });\n        } catch (error) {\n          console.error('Помилка при створенні елементів форми:', error);\n          M.toast({\n            html: `Помилка під час створення форми`\n          });\n        }\n      } else {\n        M.toast({\n          html: `Форма не створена або елементи форми відсутні`\n        });\n      }\n    };\n    return {\n      form,\n      v$,\n      addFormItem,\n      removeFormItem,\n      handleSubmit,\n      submitFormItems\n    };\n  }\n};","map":{"version":3,"names":["reactive","apiService","useVuelidate","required","M","setup","form","title","formItems","field_name","field_type","createdFormId","rules","$each","v$","addFormItem","push","removeFormItem","index","splice","handleSubmit","value","$touch","$invalid","token","localStorage","getItem","toast","html","response","createCustomForm","primaryPollId","data","id","error","console","submitFormItems","length","createFormItem","log"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\TemplateForm.vue"],"sourcesContent":["<!--template form-->\r\n<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Створити нову форму\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"form-bank-info-container\">\r\n    <!-- Форма для створення шаблону -->\r\n    <form class=\"name-update-form\" @submit.prevent=\"handleSubmit\">\r\n      <div class=\"forms-name-add\">\r\n        <div class=\"container-input\">\r\n          <label for=\"title\">Назва шаблону</label>\r\n          <input\r\n              type=\"text\"\r\n              id=\"title\"\r\n              v-model=\"form.title\"\r\n              :class=\"{ 'is-invalid': v$.form.title.$dirty && v$.form.title.required.$invalid }\"\r\n              placeholder=\"Введіть назву шаблону\"\r\n          >\r\n        </div>\r\n      </div>\r\n      <span class=\"validate-error\" v-if=\"v$.form.title.$dirty && v$.form.title.required.$invalid\">Це поле не може бути пустим</span>\r\n      <!--      <button type=\"submit\" class=\"btn-submit\">Задати назву</button>-->\r\n      <div class=\"container-global-form-edit\">\r\n        <button class=\"global-form-edit\" type=\"submit\">\r\n          <img src=\"@/assets/icons/edit-form.svg\" alt=\"Edit Button\">\r\n          <span class=\"edit-link\">Задати назву</span>\r\n        </button>\r\n      </div>\r\n    </form>\r\n\r\n    <!-- Умовний рендеринг для додавання елементів форми, якщо форма створена -->\r\n    <div v-if=\"createdFormId\">\r\n      <label>Додати елемент форми:</label>\r\n      <div class=\"form-items\">\r\n        <!-- Відображення динамічних полів форми -->\r\n        <div v-for=\"(item, index) in form.formItems\" :key=\"index\" class=\"form-item\">\r\n          <input\r\n              type=\"text\"\r\n              v-model=\"item.field_name\"\r\n              :class=\"{ 'is-invalid': v$.form.formItems[index].field_name.$dirty && v$.form.formItems[index].field_name.$error }\"\r\n              placeholder=\"Ім'я поля\"\r\n          >\r\n          <select v-model=\"item.field_type\">\r\n            <option value=\"text\">Довгий текст</option>\r\n            <option value=\"string\">Короткий текст</option>\r\n            <option value=\"boolean\">Так / Ні</option>\r\n          </select>\r\n          <span class=\"validate-error\" v-if=\"v$.form.formItems[index].field_name.$dirty && v$.form.formItems[index].field_name.$error\">Це поле не може бути пустим</span>\r\n          <button type=\"button\" @click=\"removeFormItem(index)\">Remove</button>\r\n        </div>\r\n        <!-- Кнопка для додавання нового елементу форми -->\r\n        <button type=\"button\" @click=\"addFormItem\">Додати поле</button>\r\n      </div>\r\n      <!-- Кнопка для фінального створення шаблону форми -->\r\n      <button type=\"button\" @click=\"submitFormItems\" class=\"btn-submit\">Створити шаблон</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { reactive } from 'vue';\r\nimport apiService from '@/services/apiService';\r\nimport { useVuelidate } from '@vuelidate/core';\r\nimport { required } from '@vuelidate/validators';\r\nimport M from 'materialize-css';\r\nexport default {\r\n  setup() {\r\n    const form = reactive({\r\n      title: '',\r\n      formItems: [{ field_name: '', field_type: 'text' }],\r\n      createdFormId: ''\r\n    });\r\n\r\n    const rules = {\r\n      title: { required },\r\n      formItems: {\r\n        $each: {\r\n          field_name: { required },\r\n          field_type: { required },\r\n        },\r\n      },\r\n    };\r\n\r\n    // Використання Vuelidate\r\n    const v$ = useVuelidate(rules, form);\r\n    // const createdFormId = ref('');\r\n\r\n    // Методи\r\n    const addFormItem = () => {\r\n      form.formItems.push({ field_name: '', field_type: 'text' });\r\n    };\r\n\r\n    const removeFormItem = (index) => {\r\n      form.formItems.splice(index, 1);\r\n    };\r\n    const handleSubmit = async () => {\r\n      v$.value.$touch();\r\n      if (!v$.value.$invalid) {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          M.toast({ html: `Ви не авторизовані` });\r\n          return;\r\n        }\r\n\r\n        try {\r\n          const response = await apiService.createCustomForm(token, form.title, form.primaryPollId);\r\n          form.createdFormId = response.data.data.id;\r\n\r\n          M.toast({ html: `Назву форми успішно задано` });\r\n\r\n        } catch (error) {\r\n          console.error('Помилка при створенні форми:', error);\r\n        }\r\n      }\r\n    };\r\n    const submitFormItems = async () =>  {\r\n      const token = localStorage.getItem('token');\r\n      if (this.createdFormId && this.formItems.length) {\r\n        try {\r\n          const response = await apiService.createFormItem(token, this.createdFormId, this.formItems);\r\n          console.log('Елементи форми створені:', response.data.data);\r\n          M.toast({ html: `Форма успішно створена` });\r\n\r\n        } catch (error) {\r\n          console.error('Помилка при створенні елементів форми:', error);\r\n          M.toast({ html: `Помилка під час створення форми` });\r\n        }\r\n      } else {\r\n        M.toast({ html: `Форма не створена або елементи форми відсутні` });\r\n      }\r\n    };\r\n\r\n    return {\r\n      form,\r\n      v$,\r\n      addFormItem,\r\n      removeFormItem,\r\n      handleSubmit,\r\n      submitFormItems\r\n    };\r\n  }\r\n};\r\n</script>\r\n"],"mappings":";AAiEA,SAASA,QAAO,QAAS,KAAK;AAC9B,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAO,QAAS,uBAAuB;AAChD,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,IAAG,GAAIN,QAAQ,CAAC;MACpBO,KAAK,EAAE,EAAE;MACTC,SAAS,EAAE,CAAC;QAAEC,UAAU,EAAE,EAAE;QAAEC,UAAU,EAAE;MAAO,CAAC,CAAC;MACnDC,aAAa,EAAE;IACjB,CAAC,CAAC;IAEF,MAAMC,KAAI,GAAI;MACZL,KAAK,EAAE;QAAEJ;MAAS,CAAC;MACnBK,SAAS,EAAE;QACTK,KAAK,EAAE;UACLJ,UAAU,EAAE;YAAEN;UAAS,CAAC;UACxBO,UAAU,EAAE;YAAEP;UAAS;QACzB;MACF;IACF,CAAC;;IAED;IACA,MAAMW,EAAC,GAAIZ,YAAY,CAACU,KAAK,EAAEN,IAAI,CAAC;IACpC;;IAEA;IACA,MAAMS,WAAU,GAAIA,CAAA,KAAM;MACxBT,IAAI,CAACE,SAAS,CAACQ,IAAI,CAAC;QAAEP,UAAU,EAAE,EAAE;QAAEC,UAAU,EAAE;MAAO,CAAC,CAAC;IAC7D,CAAC;IAED,MAAMO,cAAa,GAAKC,KAAK,IAAK;MAChCZ,IAAI,CAACE,SAAS,CAACW,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IACjC,CAAC;IACD,MAAME,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/BN,EAAE,CAACO,KAAK,CAACC,MAAM,CAAC,CAAC;MACjB,IAAI,CAACR,EAAE,CAACO,KAAK,CAACE,QAAQ,EAAE;QACtB,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,IAAI,CAACF,KAAK,EAAE;UACVpB,CAAC,CAACuB,KAAK,CAAC;YAAEC,IAAI,EAAG;UAAoB,CAAC,CAAC;UACvC;QACF;QAEA,IAAI;UACF,MAAMC,QAAO,GAAI,MAAM5B,UAAU,CAAC6B,gBAAgB,CAACN,KAAK,EAAElB,IAAI,CAACC,KAAK,EAAED,IAAI,CAACyB,aAAa,CAAC;UACzFzB,IAAI,CAACK,aAAY,GAAIkB,QAAQ,CAACG,IAAI,CAACA,IAAI,CAACC,EAAE;UAE1C7B,C