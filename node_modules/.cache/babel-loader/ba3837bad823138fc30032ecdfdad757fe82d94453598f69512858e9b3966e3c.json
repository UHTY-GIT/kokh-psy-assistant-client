{"ast":null,"code":"import { defineComponent, ref } from 'vue';\nimport FullCalendar from '@fullcalendar/vue3';\nimport dayGridPlugin from '@fullcalendar/daygrid';\nimport timeGridPlugin from '@fullcalendar/timegrid';\nimport interactionPlugin from '@fullcalendar/interaction';\nimport ukLocale from '@fullcalendar/core/locales/uk';\nimport ModalCalendar from \"@/components/modal/ModalCalendar.vue\";\nexport default defineComponent({\n  components: {\n    FullCalendar,\n    ModalCalendar\n  },\n  setup() {\n    const showModal = ref(false);\n    const showStart = ref('');\n    const showEnd = ref('');\n    const showAllDay = ref(false);\n    const calendarOptions = {\n      plugins: [dayGridPlugin, timeGridPlugin, interactionPlugin],\n      locale: ukLocale,\n      headerToolbar: {\n        left: 'prev,next today',\n        center: 'title',\n        right: 'dayGridMonth,timeGridWeek,timeGridDay'\n      },\n      initialView: 'dayGridMonth',\n      editable: true,\n      selectable: true,\n      selectMirror: true,\n      dayMaxEvents: true,\n      weekends: true,\n      select: handleDateSelect,\n      eventClick: handleEventClick,\n      eventsSet: handleEvents\n    };\n    function formatDate(date) {\n      let d = new Date(date);\n      let year = d.getFullYear();\n      let month = (d.getMonth() + 1).toString().padStart(2, '0');\n      let day = d.getDate().toString().padStart(2, '0');\n      let hours = d.getHours().toString().padStart(2, '0');\n      let minutes = d.getMinutes().toString().padStart(2, '0');\n      let seconds = d.getSeconds().toString().padStart(2, '0');\n      let milliseconds = d.getMilliseconds().toString().padStart(6, '0');\n      let timezoneOffset = -d.getTimezoneOffset();\n      let sign = timezoneOffset >= 0 ? '+' : '-';\n      let offsetHours = Math.floor(Math.abs(timezoneOffset) / 60).toString().padStart(2, '0');\n      let offsetMinutes = (Math.abs(timezoneOffset) % 60).toString().padStart(2, '0');\n      return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}.${milliseconds} ${sign}${offsetHours}${offsetMinutes}`;\n    }\n    function handleDateSelect(selectInfo) {\n      showModal.value = true;\n      showStart.value = formatDate(selectInfo.startStr);\n      showEnd.value = formatDate(selectInfo.endStr);\n      showAllDay.value = selectInfo.allDay;\n    }\n    function handleEventClick(clickInfo) {\n      if (confirm(`Are you sure you want to delete the event '${clickInfo.event.title}'`)) {\n        clickInfo.event.remove();\n      }\n    }\n    function handleEvents() {\n      // This could be used to manage state about events\n    }\n    function closeModal() {\n      showModal.value = false;\n    }\n    return {\n      showModal,\n      showStart,\n      showEnd,\n      showAllDay,\n      calendarOptions,\n      closeModal\n    };\n  }\n});","map":{"version":3,"names":["defineComponent","ref","FullCalendar","dayGridPlugin","timeGridPlugin","interactionPlugin","ukLocale","ModalCalendar","components","setup","showModal","showStart","showEnd","showAllDay","calendarOptions","plugins","locale","headerToolbar","left","center","right","initialView","editable","selectable","selectMirror","dayMaxEvents","weekends","select","handleDateSelect","eventClick","handleEventClick","eventsSet","handleEvents","formatDate","date","d","Date","year","getFullYear","month","getMonth","toString","padStart","day","getDate","hours","getHours","minutes","getMinutes","seconds","getSeconds","milliseconds","getMilliseconds","timezoneOffset","getTimezoneOffset","sign","offsetHours","Math","floor","abs","offsetMinutes","selectInfo","value","startStr","endStr","allDay","clickInfo","confirm","event","title","remove","closeModal"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\CalendarPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"calendar-width\">\r\n\r\n    <FullCalendar\r\n        class='demo-app-calendar'\r\n        :options='calendarOptions'\r\n    >\r\n      <!--      <b>{{ arg.timeText }}</b>-->\r\n      <!--      <i>{{ arg.event.title }}</i>-->\r\n    </FullCalendar>\r\n  </div>\r\n  <!--  Модальне вікно-->\r\n  <ModalCalendar\r\n      v-if=\"showModal\"\r\n      :showModal=\"showModal\"\r\n      :start=\"showStart\"\r\n      :end=\"showEnd\"\r\n      :allDay=\"showAllDay\"\r\n      @close=\"showModal = false\"\r\n  />\r\n</template>\r\n<script>\r\nimport { defineComponent, ref } from 'vue';\r\nimport FullCalendar from '@fullcalendar/vue3';\r\nimport dayGridPlugin from '@fullcalendar/daygrid';\r\nimport timeGridPlugin from '@fullcalendar/timegrid';\r\nimport interactionPlugin from '@fullcalendar/interaction';\r\nimport ukLocale from '@fullcalendar/core/locales/uk';\r\nimport ModalCalendar from \"@/components/modal/ModalCalendar.vue\";\r\n\r\nexport default defineComponent({\r\n  components: {\r\n    FullCalendar,\r\n    ModalCalendar\r\n  },\r\n  setup() {\r\n    const showModal = ref(false);\r\n    const showStart = ref('');\r\n    const showEnd = ref('');\r\n    const showAllDay = ref(false);\r\n    const calendarOptions = {\r\n      plugins: [dayGridPlugin, timeGridPlugin, interactionPlugin],\r\n      locale: ukLocale,\r\n      headerToolbar: {\r\n        left: 'prev,next today',\r\n        center: 'title',\r\n        right: 'dayGridMonth,timeGridWeek,timeGridDay'\r\n      },\r\n      initialView: 'dayGridMonth',\r\n      editable: true,\r\n      selectable: true,\r\n      selectMirror: true,\r\n      dayMaxEvents: true,\r\n      weekends: true,\r\n      select: handleDateSelect,\r\n      eventClick: handleEventClick,\r\n      eventsSet: handleEvents\r\n    };\r\n\r\n    function formatDate(date) {\r\n      let d = new Date(date);\r\n      let year = d.getFullYear();\r\n      let month = (d.getMonth() + 1).toString().padStart(2, '0');\r\n      let day = d.getDate().toString().padStart(2, '0');\r\n      let hours = d.getHours().toString().padStart(2, '0');\r\n      let minutes = d.getMinutes().toString().padStart(2, '0');\r\n      let seconds = d.getSeconds().toString().padStart(2, '0');\r\n      let milliseconds = d.getMilliseconds().toString().padStart(6, '0');\r\n      let timezoneOffset = -d.getTimezoneOffset();\r\n      let sign = timezoneOffset >= 0 ? '+' : '-';\r\n      let offsetHours = Math.floor(Math.abs(timezoneOffset) / 60).toString().padStart(2, '0');\r\n      let offsetMinutes = (Math.abs(timezoneOffset) % 60).toString().padStart(2, '0');\r\n      return `${year}-${month}-${day} ${hours}:${minutes}:${seconds}.${milliseconds} ${sign}${offsetHours}${offsetMinutes}`;\r\n    }\r\n\r\n    function handleDateSelect(selectInfo) {\r\n      showModal.value = true;\r\n      showStart.value = formatDate(selectInfo.startStr);\r\n      showEnd.value = formatDate(selectInfo.endStr);\r\n      showAllDay.value = selectInfo.allDay;\r\n    }\r\n\r\n    function handleEventClick(clickInfo) {\r\n      if (confirm(`Are you sure you want to delete the event '${clickInfo.event.title}'`)) {\r\n        clickInfo.event.remove();\r\n      }\r\n    }\r\n\r\n    function handleEvents() {\r\n      // This could be used to manage state about events\r\n    }\r\n\r\n    function closeModal() {\r\n      showModal.value = false;\r\n    }\r\n\r\n    return {\r\n      showModal,\r\n      showStart,\r\n      showEnd,\r\n      showAllDay,\r\n      calendarOptions,\r\n      closeModal\r\n    };\r\n  }\r\n});\r\n</script>\r\n<!--<script>-->\r\n<!--import { defineComponent } from 'vue'-->\r\n<!--import FullCalendar from '@fullcalendar/vue3'-->\r\n<!--import dayGridPlugin from '@fullcalendar/daygrid'-->\r\n<!--import timeGridPlugin from '@fullcalendar/timegrid'-->\r\n<!--import interactionPlugin from '@fullcalendar/interaction'-->\r\n<!--import { INITIAL_EVENTS } from './event-utils'-->\r\n<!--import ukLocale from '@fullcalendar/core/locales/uk'-->\r\n<!--import ModalCalendar from \"@/components/modal/ModalCalendar.vue\";-->\r\n\r\n<!--export default defineComponent({-->\r\n<!--  components: {-->\r\n<!--    