{"ast":null,"code":"import apiService from '@/services/apiService';\nexport default {\n  data() {\n    return {\n      form: {\n        title: '',\n        primaryPollId: '' // Якщо у вас є ідентифікатор для первинного опитування\n      }\n    };\n  },\n  methods: {\n    async handleSubmit() {\n      const token = localStorage.getItem('token'); // Отримання токену з localStorage\n      if (!token) {\n        alert('Ви не авторизовані');\n        return;\n      }\n      try {\n        const response = await apiService.createCustomForm(token, this.form.title, this.form.primaryPollId);\n        console.log('Форма створена:', response.data);\n        // Тут може бути редірект на список шаблонів або показ повідомлення про успіх\n      } catch (error) {\n        console.error('Помилка при створенні форми:', error);\n        // Тут може бути показ помилки користувачеві\n      }\n    }\n  }\n};","map":{"version":3,"names":["apiService","data","form","title","primaryPollId","methods","handleSubmit","token","localStorage","getItem","alert","response","createCustomForm","console","log","error"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\TemplateForm.vue"],"sourcesContent":["<!--template form-->\r\n<template>\r\n  <div class=\"form-container\">\r\n    <form @submit.prevent=\"handleSubmit\">\r\n      <div class=\"form-group\">\r\n        <label for=\"title\">Назва шаблону</label>\r\n        <input type=\"text\" id=\"title\" v-model=\"form.title\" required>\r\n      </div>\r\n      <button type=\"submit\" class=\"btn-submit\">Створити шаблон</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\n\r\nexport default {\r\n  data() {\r\n    return {\r\n      form: {\r\n        title: '',\r\n        primaryPollId: '', // Якщо у вас є ідентифікатор для первинного опитування\r\n      },\r\n    };\r\n  },\r\n  methods: {\r\n    async handleSubmit() {\r\n      const token = localStorage.getItem('token'); // Отримання токену з localStorage\r\n      if (!token) {\r\n        alert('Ви не авторизовані');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await apiService.createCustomForm(token, this.form.title, this.form.primaryPollId);\r\n        console.log('Форма створена:', response.data);\r\n        // Тут може бути редірект на список шаблонів або показ повідомлення про успіх\r\n      } catch (error) {\r\n        console.error('Помилка при створенні форми:', error);\r\n        // Тут може бути показ помилки користувачеві\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":"AAaA,OAAOA,UAAS,MAAO,uBAAuB;AAE9C,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE;QACJC,KAAK,EAAE,EAAE;QACTC,aAAa,EAAE,EAAE,CAAE;MACrB;IACF,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,YAAYA,CAAA,EAAG;MACnB,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;MAC7C,IAAI,CAACF,KAAK,EAAE;QACVG,KAAK,CAAC,oBAAoB,CAAC;QAC3B;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMX,UAAU,CAACY,gBAAgB,CAACL,KAAK,EAAE,IAAI,CAACL,IAAI,CAACC,KAAK,EAAE,IAAI,CAACD,IAAI,CAACE,aAAa,CAAC;QACnGS,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAEH,QAAQ,CAACV,IAAI,CAAC;QAC7C;MACF,EAAE,OAAOc,KAAK,EAAE;QACdF,OAAO,CAACE,KAAK,CAAC,8BAA8B,EAAEA,KAAK,CAAC;QACpD;MACF;IACF;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}