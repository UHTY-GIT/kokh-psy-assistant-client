{"ast":null,"code":"import apiService from \"@/services/apiService\";\nimport { ref } from \"vue\";\nexport default {\n  props: {\n    showModal: Boolean,\n    start: String,\n    end: String,\n    allDay: Boolean\n  },\n  setup(props) {\n    const name = ref(''); // Для зберігання назви консультації\n    const selectedClientId = ref(''); // Для вибору клієнта\n    const selectedTemplateId = ref(''); // Для вибору шаблону форми\n    const selectedOriginType = ref(''); // Для вибору типу консультації\n\n    const clients = ref([]); // Масив клієнтів\n    const filteredTemplates = ref([]); // Масив шаблонів\n\n    const fetchAllForms = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        const response = await apiService.getForms(token);\n        filteredTemplates.value = response.data.data;\n      } catch (error) {\n        console.error('Error fetching forms:', error);\n      }\n    };\n    const fetchAllClients = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        const response = await apiService.getClients(token);\n        clients.value = response.data.data;\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n      }\n    };\n    const sendEvent = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        const date = `${props.start} - ${props.end}`; // Форматування дати\n        await apiService.createEvent(token, name.value, selectedClientId.value, selectedTemplateId.value, selectedOriginType.value, date);\n        alert('Подія успішно створена!');\n      } catch (error) {\n        console.error('Error sending event:', error);\n        alert('Помилка при створенні події: ' + error.message);\n      }\n    };\n    return {\n      name,\n      selectedClientId,\n      selectedTemplateId,\n      selectedOriginType,\n      clients,\n      filteredTemplates,\n      fetchAllForms,\n      fetchAllClients,\n      sendEvent\n    };\n  }\n};","map":{"version":3,"names":["apiService","ref","props","showModal","Boolean","start","String","end","allDay","setup","name","selectedClientId","selectedTemplateId","selectedOriginType","clients","filteredTemplates","fetchAllForms","token","localStorage","getItem","response","getForms","value","data","error","console","fetchAllClients","getClients","sendEvent","date","createEvent","alert","message"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\modal\\ModalCalendar.vue"],"sourcesContent":["<!--src/components/modal/ModalCalendar.vue-->\r\n<template>\r\n  <div :class=\"{ 'modal-window': true, 'is-active': showModal }\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-close-butt\">\r\n        <img src=\"@/assets/icons/close-modal.svg\" alt=\"close\" @click=\"closeModal\">\r\n      </div>\r\n      <div class=\"modal-content-all\">\r\n        <p>Заповніть поля форми щоб створити консультацію</p>\r\n        <div>\r\n          <div class=\"input-field-text\">\r\n            <div class=\"container-input\">\r\n              <input\r\n                  id=\"name\"\r\n                  type=\"text\"\r\n                  v-model=\"name\"\r\n\r\n                  placeholder=\"Введіть бажану назву консультації\"\r\n              >\r\n<!--              :class=\"{ 'is-invalid': v$.nameConsultation.$dirty && v$.nameConsultation.required.$invalid }\"-->\r\n            </div>\r\n<!--            <span class=\"validate-error\" v-if=\"v$.profile.name.$dirty && v$.profile.name.required.$invalid\">Це поле не може бути пустим</span>-->\r\n          </div>\r\n          <div class=\"chosen-templates select-field\">\r\n            <div class=\"container-input\">\r\n              <select v-model=\"selectedClientId\">\r\n                <option disabled value=\"\">Будь ласка, виберіть клієнта</option>\r\n                <option v-for=\"client in clients\" :key=\"client.telegram_id\">{{ client.name }}, {{ client.phone }}</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n          <div class=\"chosen-templates select-field\">\r\n            <div class=\"container-input\">\r\n              <select v-model=\"selectedOriginType\">\r\n                <option disabled value=\"\">Будь ласка, виберіть тип консульатції</option>\r\n                <option value=\"individual\">Індивідуальна</option>\r\n                <option value=\"couple_classic\">Парна класична</option>\r\n                <option value=\"couple_diagnostic\">Парна діагностична</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n          <div class=\"chosen-templates select-field\">\r\n            <div class=\"container-input\">\r\n              <select v-model=\"selectedTemplateId\">\r\n                <option disabled value=\"\">Будь ласка, виберіть шаблон</option>\r\n                <option v-for=\"template in filteredTemplates\" :value=\"template.id\" :key=\"template.id\">{{ template.title }}</option>\r\n              </select>\r\n            </div>\r\n          </div>\r\n          <div class=\"modal-btn\">\r\n            <button class=\"btn-send-templates\" @click=\"sendEvent\">Надіслати</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport apiService from \"@/services/apiService\";\r\nimport { ref } from \"vue\";\r\n\r\nexport default {\r\n  props: {\r\n    showModal: Boolean,\r\n    start: String,\r\n    end: String,\r\n    allDay: Boolean\r\n  },\r\n  setup(props) {\r\n    const name = ref(''); // Для зберігання назви консультації\r\n    const selectedClientId = ref(''); // Для вибору клієнта\r\n    const selectedTemplateId = ref(''); // Для вибору шаблону форми\r\n    const selectedOriginType = ref(''); // Для вибору типу консультації\r\n\r\n    const clients = ref([]); // Масив клієнтів\r\n    const filteredTemplates = ref([]); // Масив шаблонів\r\n\r\n    const fetchAllForms = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        const response = await apiService.getForms(token);\r\n        filteredTemplates.value = response.data.data;\r\n      } catch (error) {\r\n        console.error('Error fetching forms:', error);\r\n      }\r\n    };\r\n\r\n    const fetchAllClients = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        const response = await apiService.getClients(token);\r\n        clients.value = response.data.data;\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n      }\r\n    };\r\n\r\n    const sendEvent = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        const date = `${props.start} - ${props.end}`; // Форматування дати\r\n        await apiService.createEvent(token, name.value, selectedClientId.value, selectedTemplateId.value, selectedOriginType.value, date);\r\n        alert('Подія успішно створена!');\r\n      } catch (error) {\r\n        console.error('Error sending event:', error);\r\n        alert('Помилка при створенні події: ' + error.message);\r\n      }\r\n    };\r\n\r\n    return {\r\n      name,\r\n      selectedClientId,\r\n      selectedTemplateId,\r\n      selectedOriginType,\r\n      clients,\r\n      filteredTemplates,\r\n      fetchAllForms,\r\n      fetchAllClients,\r\n      sendEvent\r\n    };\r\n  }\r\n}\r\n</script>\r\n<!--<script>-->\r\n<!--//import M from 'materialize-css';-->\r\n<!--//import apiService from '@/services/apiService';-->\r\n<!--//import { INITIAL_EVENTS, createEventId } from './event-utils'-->\r\n<!--import apiService from \"@/services/apiService\";-->\r\n<!--//import M from \"materialize-css\";-->\r\n\r\n<!--export default {-->\r\n<!--  props: {-->\r\n<!--    showModal: Boolean,-->\r\n<!--    start: String,-->\r\n<!--    end: String,-->\r\n<!--    allDay: Boolean-->\r\n<!--  },-->\r\n<!--  data() {-->\r\n<!--    return {-->\r\n<!-