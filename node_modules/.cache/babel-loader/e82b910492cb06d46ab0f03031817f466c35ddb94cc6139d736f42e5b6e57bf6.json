n  text-align: center;\r\n}\r\n.modal-close-butt {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n.modal-close-butt img {\r\n  cursor: pointer;\r\n}\r\n.modal-window.is-active {\r\n  display: flex;\r\n}\r\n.chosen-templates .container-input select {\r\n  width: 100%;\r\n  height: auto !important;\r\n  margin: 0;\r\n  line-height: normal;\r\n  max-width: none;\r\n}\r\n</style>"],"mappings":"AA0DA,OAAOA,UAAS,MAAO,uBAAuB;AAC9C,SAASC,GAAE,QAAS,KAAK;AAEzB,eAAe;EACbC,KAAK,EAAE;IACLC,SAAS,EAAEC,OAAO;IAClBC,KAAK,EAAEC,MAAM;IACbC,GAAG,EAAED,MAAM;IACXE,MAAM,EAAEJ;EACV,CAAC;EACDK,KAAKA,CAACP,KAAK,EAAE;IACX,MAAMQ,IAAG,GAAIT,GAAG,CAAC,EAAE,CAAC,EAAE;IACtB,MAAMU,gBAAe,GAAIV,GAAG,CAAC,EAAE,CAAC,EAAE;IAClC,MAAMW,kBAAiB,GAAIX,GAAG,CAAC,EAAE,CAAC,EAAE;IACpC,MAAMY,kBAAiB,GAAIZ,GAAG,CAAC,EAAE,CAAC,EAAE;;IAEpC,MAAMa,OAAM,GAAIb,GAAG,CAAC,EAAE,CAAC,EAAE;IACzB,MAAMc,iBAAgB,GAAId,GAAG,CAAC,EAAE,CAAC,EAAE;;IAEnC,MAAMe,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMC,QAAO,GAAI,MAAMpB,UAAU,CAACqB,QAAQ,CAACJ,KAAK,CAAC;QACjDF,iBAAiB,CAACO,KAAI,GAAIF,QAAQ,CAACG,IAAI,CAACA,IAAI;MAC9C,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,uBAAuB,EAAEA,KAAK,CAAC;MAC/C;IACF,CAAC;IAED,MAAME,eAAc,GAAI,MAAAA,CAAA,KAAY;MAClC,IAAI;QACF,MAAMT,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMC,QAAO,GAAI,MAAMpB,UAAU,CAAC2B,UAAU,CAACV,KAAK,CAAC;QACnDH,OAAO,CAACQ,KAAI,GAAIF,QAAQ,CAACG,IAAI,CAACA,IAAI;MACpC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;MACjD;IACF,CAAC;IAED,MAAMI,SAAQ,GAAI,MAAAA,CAAA,KAAY;MAC5B,IAAI;QACF,MAAMX,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;QAC3C,MAAMU,IAAG,GAAK,GAAE3B,KAAK,CAACG,KAAK,MAAMH,KAAK,CAACK,GAAI,EAAC,EAAE;QAC9C,MAAMP,UAAU,CAAC8B,WAAW,CAACb,KAAK,EAAEP,IAAI,CAACY,KAAK,EAAEX,gBAAgB,CAACW,KAAK,EAAEV,kBAAkB,CAACU,KAAK,EAAET,kBAAkB,CAACS,KAAK,EAAEO,IAAI,CAAC;QACjIE,KAAK,CAAC,yBAAyB,CAAC;MAClC,EAAE,OAAOP,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,sBAAsB,EAAEA,KAAK,CAAC;QAC5CO,KAAK,CAAC,+BAA8B,GAAIP,KA