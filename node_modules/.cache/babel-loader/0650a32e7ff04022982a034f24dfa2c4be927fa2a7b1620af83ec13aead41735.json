{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useRoute } from 'vue-router';\nimport apiService from \"@/services/apiService\";\nimport ModalSessionSuccess from \"@/components/modal/ModalSessionSuccess.vue\";\nexport default {\n  components: {\n    ModalSessionSuccess\n  },\n  setup() {\n    const route = useRoute();\n    const formData = ref({\n      fields: []\n    });\n    const showModal = ref(false);\n    const clientId = route.query.clientId;\n    const clientName = route.query.clientName;\n    const customFormId = route.query.customFormId;\n    const customFormTitle = route.query.customFormTitle;\n    const sessionNumber = route.query.sessionNumber;\n    const IDconsultation = route.query.IDconsultation;\n    const fetchFormData = async () => {\n      try {\n        const token = localStorage.getItem('token');\n        if (!token) {\n          throw new Error('No authentication token found');\n        }\n        const response = await apiService.getCustomFormById(customFormId);\n        formData.value.fields = response.data.data.form_items.map(item => ({\n          id: item.id,\n          field_name: item.field_name,\n          field_type: item.field_type,\n          variants: item.variants || [],\n          value: ''\n        }));\n      } catch (error) {\n        console.error('Error fetching form data:', error);\n      }\n    };\n    const openModal = () => {\n      showModal.value = true;\n      console.log(\"відкрити модальне вікно\");\n    };\n    const submitForm = async () => {\n      const answers = formData.value.fields.map(field => ({\n        form_item_id: field.id,\n        text_answer: field.value,\n        consultation_id: IDconsultation\n      }));\n      const payload = {\n        client_id: clientId,\n        answers_data: JSON.stringify(answers)\n      };\n      try {\n        await apiService.submitAnswers(payload);\n        showModal.value = false;\n      } catch (error) {\n        console.error('Error submitting form:', error);\n      }\n    };\n    onMounted(fetchFormData);\n    return {\n      formData,\n      clientId,\n      clientName,\n      customFormId,\n      customFormTitle,\n      sessionNumber,\n      IDconsultation,\n      openModal,\n      submitForm\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useRoute","apiService","ModalSessionSuccess","components","setup","route","formData","fields","showModal","clientId","query","clientName","customFormId","customFormTitle","sessionNumber","IDconsultation","fetchFormData","token","localStorage","getItem","Error","response","getCustomFormById","value","data","form_items","map","item","id","field_name","field_type","variants","error","console","openModal","log","submitForm","answers","field","form_item_id","text_answer","consultation_id","payload","client_id","answers_data","JSON","stringify","submitAnswers"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\ActiveSessionPage.vue"],"sourcesContent":["<!-- src/views/ActiveSessionPage.vue -->\r\n<template>\r\n  <div>\r\n    <div class=\"profile_tittle\">\r\n      <p>\r\n        Сесія №{{ sessionNumber }}, клієнт {{ clientName }}\r\n      </p>\r\n    </div>\r\n    <hr class=\"hr_profile\">\r\n  </div>\r\n  <div class=\"block_active_session\">\r\n    <div class=\"titte_field\">\r\n      <p>\r\n        Базові поля\r\n      </p>\r\n    </div>\r\n    <div class=\"block_input_field\">\r\n      <form @submit.prevent=\"openModal\">\r\n        <div v-for=\"field in formData.fields\" :key=\"field.id\" class=\"forms-name-add active_session_fields\">\r\n          <div class=\"container-input\">\r\n            <label :for=\"field.field_name\">{{ field.field_name }}</label>\r\n            <textarea\r\n                v-if=\"field.field_type === 'text'\"\r\n                :id=\"field.field_name\"\r\n                v-model=\"field.value\"\r\n                :placeholder=\"'Введіть ' + field.field_name\"\r\n            ></textarea>\r\n            <input\r\n                v-else-if=\"field.field_type === 'string'\"\r\n                type=\"text\"\r\n                :id=\"field.field_name\"\r\n                v-model=\"field.value\"\r\n                :placeholder=\"'Введіть ' + field.field_name\"\r\n            >\r\n            <select v-else-if=\"field.field_type === 'select_v2'\" :id=\"field.field_name\" v-model=\"field.value\">\r\n              <option disabled value=\"\">Оберіть варіант</option>\r\n              <option v-for=\"variant in field.variants\" :key=\"variant\">{{ variant }}</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n        <div class=\"container-global-form-edit active_session_button\">\r\n          <button class=\"global-form-edit\" type=\"submit\">\r\n            <img src=\"@/assets/icons/share.svg\" alt=\"Send name form\">\r\n            <span class=\"edit-link\">Завершити сесію</span>\r\n          </button>\r\n        </div>\r\n      </form>\r\n    </div>\r\n  </div>\r\n  <!--  Модальне вікно-->\r\n  <ModalSessionSuccess\r\n      v-if=\"showModal\"\r\n      :IDconsultation = \"IDconsultation\"\r\n      :clientId = \"clientId\"\r\n      @close=\"showModal = false\"\r\n      @confirm=\"submitForm\"\r\n  />\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\nimport apiService from \"@/services/apiService\";\r\nimport ModalSessionSuccess from \"@/components/modal/ModalSessionSuccess.vue\";\r\n\r\nexport default {\r\n  components: {\r\n    ModalSessionSuccess\r\n  },\r\n  setup() {\r\n    const route = useRoute();\r\n    const formData = ref({\r\n      fields: [],\r\n    });\r\n\r\n    const showModal = ref(false);\r\n    const clientId = route.query.clientId;\r\n    const clientName = route.query.clientName;\r\n    const customFormId = route.query.customFormId;\r\n    const customFormTitle = route.query.customFormTitle;\r\n    const sessionNumber = route.query.sessionNumber;\r\n    const IDconsultation = route.query.IDconsultation;\r\n\r\n    const fetchFormData = async () => {\r\n      try {\r\n        const token = localStorage.getItem('token');\r\n        if (!token) {\r\n          throw new Error('No authentication token found');\r\n        }\r\n        const response = await apiService.getCustomFormById(customFormId);\r\n        formData.value.fields = response.data.data.form_items.map(item => ({\r\n          id: item.id,\r\n          field_name: item.field_name,\r\n          field_type: item.field_type,\r\n          variants: item.variants || [],\r\n          value: ''\r\n        }));\r\n      } catch (error) {\r\n        console.error('Error fetching form data:', error);\r\n      }\r\n    };\r\n\r\n    const openModal = () => {\r\n      showModal.value = true;\r\n      console.log(\"відкрити модальне вікно\")\r\n    };\r\n\r\n    const submitForm = async () => {\r\n      const answers = formData.value.fields.map(field => ({\r\n        form_item_id: field.id,\r\n        text_answer: field.value,\r\n        consultation_id: IDconsultation\r\n      }));\r\n\r\n      const payload = {\r\n        client_id: clientId,\r\n        answers_data: JSON.stringify(answers)\r\n      };\r\n\r\n      try {\r\n        await apiService.submitAnswers(payload);\r\n        showModal.value = false;\r\n      } catch (error) {\r\n        console.error('Error submitting form:', error);\r\n      }\r\n    };\r\n\r\n    onMounted(fetchFormData);\r\n\r\n    return {\r\n      formData,\r\n      clientId,\r\n      clientName,\r\n      customFormId,\r\n      customFormTitle,\r\n      sessionNumber,\r\n      IDconsultation,\r\n      openModal,\r\n      submitForm\r\n    };\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AA4DA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,mBAAkB,MAAO,4CAA4C;AAE5E,eAAe;EACbC,UAAU,EAAE;IACVD;EACF,CAAC;EACDE,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC,CAAC;IACxB,MAAMM,QAAO,GAAIR,GAAG,CAAC;MA