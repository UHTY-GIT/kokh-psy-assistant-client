{"ast":null,"code":"import apiService from '@/services/apiService';\nimport M from 'materialize-css';\nimport { ref } from 'vue';\nimport ModalTemplates from \"@/components/modal/ModalTemplates.vue\";\nexport default {\n  name: \"AllClient\",\n  components: {\n    ModalTemplates\n  },\n  setup() {\n    const showModal = ref(false);\n    const clients = ref([]);\n    const fetchClients = async () => {\n      // Логіка отримання клієнтів\n    };\n    const fetchTemplates = async () => {\n      // Логіка отримання шаблонів\n    };\n    const openModal = () => {\n      showModal.value = true;\n      fetchTemplates();\n    };\n\n    // Перенесіть логіку з mounted сюди, якщо потрібно запустити щось при створенні компонента\n    fetchClients();\n    return {\n      showModal\n    };\n  },\n  data() {\n    return {\n      clients: [] // Масив для зберігання даних клієнтів\n    };\n  },\n  async mounted() {\n    await this.fetchClients();\n  },\n  methods: {\n    async fetchClients() {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getClients(token);\n          if (response && response.data && response.data.data) {\n            this.clients = response.data.data; // Зберігання даних клієнтів у масив\n          }\n        }\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n        M.toast({\n          html: `Увійдіть у систему`\n        });\n      }\n    },\n    openModal() {\n      this.showModal = true;\n      // виклик fetchTemplates можна розмістити тут, щоб завантажити шаблони при відкритті модального вікна\n      this.fetchTemplates();\n    }\n  }\n};","map":{"version":3,"names":["apiService","M","ref","ModalTemplates","name","components","setup","showModal","clients","fetchClients","fetchTemplates","openModal","value","data","mounted","methods","token","localStorage","getItem","response","getClients","error","console","toast","html"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\AllClientPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"client-header\">\r\n      <button class=\"btn-add-client\">\r\n        Додати клієнта\r\n      </button>\r\n      <button class=\"btn-refresh\">\r\n        <img src=\"@/assets/icons/refresh.svg\" alt=\"Оновити\">\r\n      </button>\r\n    </div>\r\n    <div class=\"search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Ім'я</th>\r\n          <th>Номер телефону</th>\r\n          <th>Прийняв згоду</th>\r\n          <th>Первинне оцінювання</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"client in clients\" :key=\"client.telegram_id\">\r\n          <td>{{ client.name }}</td>\r\n          <td>{{ client.phone }}</td>\r\n          <td>{{ client.was_agreed ? 'так' : 'ні' }}</td>\r\n          <td>{{ client.primary_poll_complete ? 'так' : 'ні' }}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\" data-tooltip=\"Надіслати повідомлення\" @click=\"openModal\">\r\n              <img src=\"@/assets/icons/send-template-white.svg\" alt=\"Надіслати повідомлення\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Переглянути\">\r\n              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Редагувати\">\r\n              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">\r\n            </button>\r\n            <button class=\"btn-action\" data-tooltip=\"Видалити\">\r\n              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">\r\n            </button>\r\n          </td>\r\n\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n<!--  Модальне вікно-->\r\n  <modal-templates v-if=\"showModal\" @close=\"showModal = false\" />\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport M from 'materialize-css';\r\nimport { ref } from 'vue';\r\nimport ModalTemplates from \"@/components/modal/ModalTemplates.vue\";\r\nexport default {\r\n  name: \"AllClient\",\r\n  components: {\r\n    ModalTemplates\r\n  },\r\n  setup() {\r\n    const showModal = ref(false);\r\n    const clients = ref([]);\r\n\r\n    const fetchClients = async () => {\r\n      // Логіка отримання клієнтів\r\n    };\r\n\r\n    const fetchTemplates = async () => {\r\n      // Логіка отримання шаблонів\r\n    };\r\n\r\n    const openModal = () => {\r\n      showModal.value = true;\r\n      fetchTemplates();\r\n    };\r\n    \r\n    // Перенесіть логіку з mounted сюди, якщо потрібно запустити щось при створенні компонента\r\n    fetchClients();\r\n\r\n    return {\r\n      showModal\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      clients: [], // Масив для зберігання даних клієнтів\r\n    };\r\n  },\r\n  async mounted() {\r\n    await this.fetchClients();\r\n  },\r\n  methods: {\r\n    async fetchClients() {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getClients(token);\r\n          if (response && response.data && response.data.data) {\r\n            this.clients = response.data.data; // Зберігання даних клієнтів у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n        M.toast({ html: `Увійдіть у систему` });\r\n      }\r\n    },\r\n    openModal() {\r\n      this.showModal = true;\r\n      // виклик fetchTemplates можна розмістити тут, щоб завантажити шаблони при відкритті модального вікна\r\n      this.fetchTemplates();\r\n    }\r\n  },\r\n};\r\n</script>"],"mappings":"AAgEA,OAAOA,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,CAAA,MAAO,iBAAiB;AAC/B,SAASC,GAAE,QAAS,KAAK;AACzB,OAAOC,cAAa,MAAO,uCAAuC;AAClE,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIL,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMM,OAAM,GAAIN,GAAG,CAAC,EAAE,CAAC;IAEvB,MAAMO,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B;IAAA,CACD;IAED,MAAMC,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC;IAAA,CACD;IAED,MAAMC,SAAQ,GAAIA,CAAA,KAAM;MACtBJ,SAAS,CAACK,KAAI,GAAI,IAAI;MACtBF,cAAc,CAAC,CAAC;IAClB,CAAC;;IAED;IACAD,YAAY,CAAC,CAAC;IAEd,OAAO;MACLF;IACF;EACF,CAAC;EACDM,IAAIA,CAAA,EAAG;IACL,OAAO;MACLL,OAAO,EAAE,EAAE,CAAE;IACf,CAAC;EACH,CAAC;EACD,MAAMM,OAAOA,CAAA,EAAG;IACd,MAAM,IAAI,CAACL,YAAY,CAAC,CAAC;EAC3B,CAAC;EACDM,OAAO,EAAE;IACP,MAAMN,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAMO,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;QAC7C,IAAIF,KAAK,EAAE;UACT,MAAMG,QAAO,GAAI,MAAMnB,UAAU,CAACoB,UAAU,CAACJ,KAAK,CAAC;UACnD,IAAIG,QAAO,IAAKA,QAAQ,CAACN,IAAG,IAAKM,QAAQ,CAACN,IAAI,CAACA,IAAI,EAAE;YACnD,IAAI,CAACL,OAAM,GAAIW,QAAQ,CAACN,IAAI,CAACA,IAAI,EAAE;UACrC;QACF;MACF,EAAE,OAAOQ,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;QAC/CpB,CAAC,CAACsB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAoB,CAAC,CAAC;MACzC;IACF,CAAC;IACDb,SAASA,CAAA,EAAG;MACV,IAAI,CAACJ,SAAQ,GAAI,IAAI;MACrB;MACA,IAAI,CAACG,cAAc,CAAC,CAAC;IACvB;EACF;AACF,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}