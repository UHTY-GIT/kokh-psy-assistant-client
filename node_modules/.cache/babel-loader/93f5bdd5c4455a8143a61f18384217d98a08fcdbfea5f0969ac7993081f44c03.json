еріть хоча б один робочий день.'\r\n};\r\n\r\nconst v$ = useVuelidate({\r\n  workingDays: { atLeastOneDaySelected }\r\n}, { workingDays });\r\n\r\nconst submitDaysProfile = async () => {\r\n  if (!v$.value.$validate()) {\r\n    console.log('Будь ласка, виберіть хоча б один робочий день.');\r\n    return;\r\n  }\r\n\r\n  const selectedDays = Object.entries(workingDays.value).filter(([day, isSelected]) => isSelected).map(([day]) => day);\r\n  console.log('Відправлено дні: ', selectedDays);\r\n};\r\n\r\n</script>"],"mappings":"AAkGA,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,YAAY,QAAQ,iBAAiB;AAC9C;;AAEA;;;;;;;;IACA,MAAMC,WAAW,GAAGF,GAAG,CAAC;MACtBG,MAAM,EAAE,KAAK;MACbC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,KAAK;MAChBC,QAAQ,EAAE,KAAK;MACfC,MAAM,EAAE,KAAK;MACbC,QAAQ,EAAE;IACZ,CAAC,CAAC;;IAEF;IACA,MAAMC,qBAAqB,GAAG;MAC5BC,UAAU,EAAGC,KAAK,IAAKC,MAAM,CAACC,MAAM,CAACF,KAAK,CAAC,CAACG,IAAI,CAAEC,GAAG,IAAKA,GAAG,CAAC;MAC9DC,QAAQ,EAAE;IACZ,CAAC;IAED,MAAMC,EAAE,GAAGhB,YAAY,CAAC;MACtBC,WAAW,EAAE;QAAEO;MAAsB;IACvC,CAAC,EAAE;MAAEP;IAAY,CAAC,CAAC;IAEnB,MAAMgB,iBAAiB,GAAG,MAAAA,CAAA,KAAY;MACpC,IAAI,CAACD,EAAE,CAACN,KAAK,CAACQ,SAAS,CAAC,CAAC,EAAE;QACzBC,OAAO,CAACC,GAAG,CAAC,gDAAgD,CAAC;QAC7D;MACF;MAEA,MAAMC,YAAY,GAAGV,MAAM,CAACW,OAAO,CAACrB,WAAW,CAACS,KAAK,CAAC,CAACa,MAAM,CAAC,CAAC,CAACT,GAAG,EAAEU,UAAU,CAAC,KAAKA,UAAU,CAAC,CAACC,GAAG,CAAC,CAAC,CAACX,GAAG,CAAC,KAAKA,GAAG,CAAC;MACpHK,OAAO,CAACC,GAAG,CAAC,mBAAmB,EAAEC,YAAY,CAAC;IAChD,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}