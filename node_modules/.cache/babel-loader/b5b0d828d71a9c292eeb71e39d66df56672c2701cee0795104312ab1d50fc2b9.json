{"ast":null,"code":"import apiService from '@/services/apiService';\nimport defaultUserPhoto from '@/assets/photo/Potted Plant.svg';\nimport defaultBackgroundImage from '@/assets/photo/back-users-1.png';\n//import { mapState } from 'vuex';\nexport default {\n  name: 'NavBar',\n  data() {\n    return {\n      userPhoto: defaultUserPhoto,\n      userName: '',\n      backgroundImage: defaultBackgroundImage,\n      baseImageUrl: 'http://assistant.psy-kokh.online:3000'\n    };\n  },\n  async mounted() {\n    try {\n      const token = localStorage.getItem('token');\n      console.log(token);\n      if (token) {\n        const userProfile = await apiService.getUserProfile(token);\n        console.log(userProfile.data);\n        if (userProfile && userProfile.data) {\n          this.userName = userProfile.data.name || 'Username';\n          this.userPhoto = userProfile.data.avatar_url || defaultUserPhoto;\n          this.backgroundImage = userProfile.data.background_photo_url || defaultBackgroundImage;\n        }\n      }\n    } catch (error) {\n      console.error('Error fetching user profile:', error);\n    }\n  }\n};","map":{"version":3,"names":["apiService","defaultUserPhoto","defaultBackgroundImage","name","data","userPhoto","userName","backgroundImage","baseImageUrl","mounted","token","localStorage","getItem","console","log","userProfile","getUserProfile","avatar_url","background_photo_url","error"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\app\\NavBar.vue"],"sourcesContent":["<template>\r\n  <div :style=\"{ backgroundImage: `url(${backgroundImage})` }\" class=\"background-navbar\">\r\n    <div class=\"container-user-photo\">\r\n      <router-link to=\"/profile\">\r\n        <div class=\"user-photo\">\r\n          <img :src=\"userPhoto\" alt=\"user photo\">\r\n        </div>\r\n        <span class=\"container-user-name\">\r\n          {{ userName }}\r\n        </span>\r\n      </router-link>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\nimport defaultUserPhoto from '@/assets/photo/Potted Plant.svg';\r\nimport defaultBackgroundImage from '@/assets/photo/back-users-1.png';\r\n//import { mapState } from 'vuex';\r\nexport default {\r\n  name: 'NavBar',\r\n  data() {\r\n    return {\r\n      userPhoto: defaultUserPhoto,\r\n      userName: '',\r\n      backgroundImage: defaultBackgroundImage,\r\n      baseImageUrl: 'http://assistant.psy-kokh.online:3000',\r\n    };\r\n  },\r\n  async mounted() {\r\n    try {\r\n      const token = localStorage.getItem('token');\r\n      console.log(token);\r\n      if (token) {\r\n        const userProfile = await apiService.getUserProfile(token);\r\n        console.log(userProfile.data)\r\n        if (userProfile && userProfile.data) {\r\n          this.userName = userProfile.data.name || 'Username';\r\n          this.userPhoto = userProfile.data.avatar_url || defaultUserPhoto;\r\n          this.backgroundImage = userProfile.data.background_photo_url || defaultBackgroundImage;\r\n        }\r\n      }\r\n    } catch (error) {\r\n      console.error('Error fetching user profile:', error);\r\n    }\r\n  },\r\n}\r\n</script>"],"mappings":"AAeA,OAAOA,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,gBAAe,MAAO,iCAAiC;AAC9D,OAAOC,sBAAqB,MAAO,iCAAiC;AACpE;AACA,eAAe;EACbC,IAAI,EAAE,QAAQ;EACdC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAEJ,gBAAgB;MAC3BK,QAAQ,EAAE,EAAE;MACZC,eAAe,EAAEL,sBAAsB;MACvCM,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,IAAI;MACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC;MAC3CC,OAAO,CAACC,GAAG,CAACJ,KAAK,CAAC;MAClB,IAAIA,KAAK,EAAE;QACT,MAAMK,WAAU,GAAI,MAAMf,UAAU,CAACgB,cAAc,CAACN,KAAK,CAAC;QAC1DG,OAAO,CAACC,GAAG,CAACC,WAAW,CAACX,IAAI;QAC5B,IAAIW,WAAU,IAAKA,WAAW,CAACX,IAAI,EAAE;UACnC,IAAI,CAACE,QAAO,GAAIS,WAAW,CAACX,IAAI,CAACD,IAAG,IAAK,UAAU;UACnD,IAAI,CAACE,SAAQ,GAAIU,WAAW,CAACX,IAAI,CAACa,UAAS,IAAKhB,gBAAgB;UAChE,IAAI,CAACM,eAAc,GAAIQ,WAAW,CAACX,IAAI,CAACc,oBAAmB,IAAKhB,sBAAsB