     value: template.id,\n      key: template.id\n    }, _toDisplayString(template.title), 9 /* TEXT, PROPS */, _hoisted_8);\n  }), 128 /* KEYED_FRAGMENT */))], 512 /* NEED_PATCH */), [[_vModelSelect, _ctx.selectedTemplateId]])]), _createElementVNode(\"div\", _hoisted_9, [_createElementVNode(\"button\", {\n    class: \"btn-send-templates\",\n    onClick: _cache[2] || (_cache[2] = (...args) => _ctx.sendTemplate && _ctx.sendTemplate(...args))\n  }, \"Надіслати\")])])])])], 2 /* CLASS */);\n}","map":{"version":3,"names":["_imports_0","class","_createElementVNode","disabled","value","_createElementBlock","_normalizeClass","_ctx","showModal","_hoisted_1","_hoisted_2","src","alt","onClick","_cache","args","closeModal","_hoisted_3","_hoisted_4","_hoisted_5","_hoisted_6","$event","selectedTemplateId","_hoisted_7","_Fragment","_renderList","filteredTemplates","template","id","key","title","_hoisted_8","_hoisted_9","sendTemplate"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\modal\\ModalTemplates.vue"],"sourcesContent":["<!--src/components/modal/ModalTemplates.vue-->\r\n<template>\r\n  <div :class=\"{ 'modal-window': true, 'is-active': showModal }\">\r\n    <div class=\"modal-content\">\r\n      <div class=\"modal-close-butt\">\r\n        <img src=\"@/assets/icons/close-modal.svg\" alt=\"close\" @click=\"closeModal\">\r\n      </div>\r\n      <div class=\"modal-content-all\">\r\n        <p>Виберіть шаблон для відправки</p>\r\n        <div class=\"chosen-templates select-field\">\r\n          <div class=\"container-input\">\r\n            <select v-model=\"selectedTemplateId\">\r\n              <option disabled value=\"\">Будь ласка, виберіть шаблон</option>\r\n              <option v-for=\"template in filteredTemplates\" :value=\"template.id\" :key=\"template.id\">{{ template.title }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"modal-btn\">\r\n            <button class=\"btn-send-templates\" @click=\"sendTemplate\">Надіслати</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport M from 'materialize-css';\r\nexport default {\r\n  props: {\r\n    templates: Array,\r\n    showModal: Boolean,\r\n    selectedClientId: Number,\r\n    clientWasAgreedConsent: Boolean,\r\n    clientPrimaryPollComplete: Boolean\r\n  },\r\n  data() {\r\n    return {\r\n      selectedTemplateId: '' // Додано змінну для зберігання вибраного ID шаблону\r\n    };\r\n  },\r\n  methods: {\r\n    closeModal() {\r\n      this.$emit('close'); // Емітуйте подію 'close'\r\n    },\r\n  //   sendTemplate() {\r\n  //     if (this.selectedTemplateId && this.selectedClientId) {\r\n  //\r\n  //       // M.toast({ html: `Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.` });\r\n  //       M.toast({ html: `Шаблон надіслано.` });\r\n  //       // console.log(`Шаблон з ID: ${this.selectedTemplateId} буде надіслано на id ${this.selectedClientId}.`);\r\n  //\r\n  //       // Створюємо унікальне посилання\r\n  //       const uniqueLink = `http://localhost:8080/send-form?client=${this.selectedClientId}&template=${this.selectedTemplateId}`;\r\n  //       // console.log('Посилання для відправки:', uniqueLink);\r\n  //       // Відкриваємо посилання у новій вкладці\r\n  //       window.open(uniqueLink, '_blank');\r\n  //\r\n  //       this.closeModal(); // Закриття модального вікна після відправки\r\n  //     } else {\r\n  //       M.toast({ html: `Будь ласка, виберіть шаблон для відправки.` });\r\n  //     }\r\n  //   }\r\n  // },\r\n  async sendTemplate() {\r\n    if (this.selectedTemplateId && this.selectedClientId) {\r\n      // Створюємо унікальне посилання\r\n      const uniqueLink = `http://localhost:8080/send-form?client=${this.selectedClientId}&template=${this.selectedTemplateId}`;\r\n\r\n      try {\r\n        // Тут виконуємо POST запит до Telegram бота\r\n        let response = await fetch('<URL_до_вашого_бота>/send_template', {\r\n          method: 'POST',\r\n          headers: {\r\n            'Content-Type': 'application/json',\r\n          },\r\n          body: JSON.stringify({\r\n            client_id: this.selectedClientId,\r\n            url: uniqueLink,\r\n          }),\r\n        });\r\n\r\n        if (response.ok) {\r\n          let jsonResponse = await response.json();\r\n          // Перевірка відповіді від бота\r\n          if (jsonResponse.success) {\r\n            M.toast({ html: 'Шаблон успішно надіслано.' });\r\n          } else {\r\n            M.toast({ html: 'Виникла помилка при надсиланні шаблону.' });\r\n          }\r\n        } else {\r\n          throw new Error('Network response was not ok.');\r\n        }\r\n      } catch (error) {\r\n        console.error('Виникла помилка при надсиланні шаблону:', error);\r\n        M.toast({ html: `Помилка: ${error.message}` });\r\n      }\r\n\r\n      this.closeModal(); // Закриття модального вікна після відправки\r\n    } else {\r\n      M.toast({ html: 'Будь ласка, виберіть шаблон для відправки.' });\r\n    }\r\n  },\r\n  computed: {\r\n    filteredTemplates() {\r\n      // Якщо клієнт дав згоду, виключаємо шаблони з типом 'consent_individual' та 'consent_couple'\r\n      // Якщо клієнт пройшов первинне опитування, виключаємо 'primary_poll_individual' та 'primary_poll_couple'\r\n      return this.templates.filter(template => {\r\n        const isConsentType = ['consent_individual', 'consent_couple'].includes(template.form_type);\r\n        const isPrimaryPollType = ['primary_poll_individual', 'primary_poll_couple'].includes(template.form_type);\r\n        if (this.clientWasAgreedConsent && isConsentType) {\r\n          return false;\r\n        }\r\n        if (this.clientPrimaryPollComplete && isPrimaryPollType) {\r\n          return false;\r\n        }\r\n        return true;\r\n      });\r\n    }\r\n  },\r\n};\r\n</script>\r\n<style>\r\n.modal-window {\r\n  position: fixed;\r\n  z-index: 1;\r\n  left: 0;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  overflow: auto;\r\n  background-color: rgb(56 94 108 / 43%);\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: #FDF8F3;\r\n  margin: auto;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  width: 600px;\r\n  color: #494B55;\r\n}\r\n.modal-content-all p {\r\n  font-family: \"Nunito\", sans-serif;\r\n  font-style: normal;\r\n  font-weight: 700;\r\n  font-size: 20px;\r\n  margin: 10px 0 20px;\r\n  text-align: center;\r\n}\r\n.modal-close-butt {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n}\r\n.modal-close-butt img {\r\n  cursor: pointer;\r\n}\r\n.modal-window.is-active {\r\n  display: flex;\r\n}\r\n.chosen-templates .container-input select {\r\n  width: 100%;\r\n  height: auto !important;\r\n  margin: 0;\r\n  line-height: normal;\r\n  max-width: none;\r\n}\r\n</style>"],"mappings":";OAKaA,UAAoC;;EAFxCC,KAAK,EAAC;AAAe;;EACnBA,KAAK,EAAC;AAAkB;;EAGxBA,KAAK,EAAC;AAAmB;gCAC5BC,mBAAA,CAAoC,WAAjC,+BAA6B;;EAC3BD,KAAK,EAAC;AAA+B;;EACnCA,KAAK,EAAC;AAAiB;gCAExBC,mBAAA,CAA8D;EAAtDC,QAAQ,EAAR,EAAQ;EAACC,KAAK,EAAC;GAAG,6BAA2B;mBAZnE;;EAgBeH,KAAK,EAAC;AAAW;;uBAd9BI,mBAAA,CAoBM;IApBAJ,KAAK,EAFbK,eAAA;MAAA;MAAA,aAEoDC,IAAA,CAAAC;IAAS;MACzDN,mBAAA,CAkBM,OAlBNO,UAkBM,GAjBJP,mBAAA,CAEM,OAFNQ,UAEM,GADJR,mBAAA,CAA0E;IAArES,GAAoC,EAApCX,UAAoC;IAACY,GAAG,EAAC,OAAO;IAAEC,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAER,IAAA,CAAAS,UAAA,IAAAT,IAAA,CAAAS,UAAA,IAAAD,IAAA,CAAU;QAE1Eb,mBAAA,CAaM,OAbNe,UAaM,GAZJC,UAAoC,EACpChB,mBAAA,CAUM,OAVNiB,UAUM,GATJjB,mBAAA,CAKM,OALNkB,UAKM,G,gBAJJlB,mBAAA,CAGS;IAdrB,uBAAAY,MAAA,QAAAA,MAAA,MAAAO,MAAA,IAW6Bd,IAAA,CAAAe,kBAAkB,GAAAD,MAAA;MACjCE,UAA8D,G,kBAC9DlB,mBAAA,CAAmHmB,SAAA,QAbjIC,WAAA,CAayClB,IAAA,CAAAmB,iBAAiB,EAA7BC,QAAQ;yBAAvBtB,mBAAA,CAAmH;MAApED,KAAK,EAAEuB,QAAQ,CAACC,EAAE;MAAGC,GAAG,EAAEF,QAAQ,CAACC;wBAAOD,QAAQ,CAACG,KAAK,wBAbrHC,UAAA;2EAW6BxB,IAAA,CAAAe,kBAAkB,E,KAKrCpB,mBAAA,CAEM,OAFN8B,UAEM,GADJ9B,mBAAA,CAA2E;IAAnED,KAAK,EAAC,oBAAoB;IAAEY,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAER,IAAA,CAAA0B,YAAA,IAAA1B,IAAA,CAAA0B,YAAA,IAAAlB,IAAA,CAAY;KAAE,WAAS,E"},"metadata":{},"sourceType":"module","externalDependencies":[]}