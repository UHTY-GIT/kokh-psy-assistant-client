{"ast":null,"code":"import apiService from '@/services/apiService';\nexport default {\n  name: \"AllClient\",\n  data() {\n    return {\n      clients: [] // Масив для зберігання даних клієнтів\n    };\n  },\n  async mounted() {\n    await this.fetchClients();\n  },\n  methods: {\n    async fetchClients() {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getClients(token);\n          if (response && response.data) {\n            this.clients = response.data; // Зберігання даних клієнтів у масив\n          }\n        }\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n        // Тут можна обробити помилку, наприклад відобразити повідомлення користувачеві\n      }\n    }\n  }\n};","map":{"version":3,"names":["apiService","name","data","clients","mounted","fetchClients","methods","token","localStorage","getItem","response","getClients","error","console"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\AllClientPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"client-header\">\r\n      <button class=\"btn-add-client\">\r\n        Додати клієнта\r\n      </button>\r\n      <button class=\"btn-refresh\">\r\n        <img src=\"@/assets/icons/refresh.svg\" alt=\"Оновити\">\r\n      </button>\r\n    </div>\r\n    <div class=\"search\">\r\n      <input type=\"text\" class=\"search-input\" placeholder=\"Пошук\">\r\n    </div>\r\n\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Ім'я</th>\r\n          <th>Номер телефону</th>\r\n          <th>Прийняв згоду</th>\r\n          <th>Первинне оцінювання</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <!-- Приклад рядка таблиці -->\r\n        <tr>\r\n          <td>Клієнт Іван</td>\r\n          <td>+38095925237</td>\r\n          <td>так</td>\r\n          <td>так</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">\r\n            </button>\r\n          </td>\r\n        </tr>\r\n        <!-- Подальші рядки... -->\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n<script>\r\nimport apiService from '@/services/apiService';\r\n\r\nexport default {\r\n  name: \"AllClient\",\r\n  data() {\r\n    return {\r\n      clients: [], // Масив для зберігання даних клієнтів\r\n    };\r\n  },\r\n  async mounted() {\r\n    await this.fetchClients();\r\n  },\r\n  methods: {\r\n    async fetchClients() {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getClients(token);\r\n          if (response && response.data) {\r\n            this.clients = response.data; // Зберігання даних клієнтів у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n        // Тут можна обробити помилку, наприклад відобразити повідомлення користувачеві\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":"AA4DA,