{"ast":null,"code":"import \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { ref, onMounted } from 'vue';\nimport apiService from \"@/services/apiService\";\nexport default {\n  setup() {\n    const formFields = ref([]);\n    const clientId = ref(null);\n    const templateId = ref(null);\n    onMounted(async () => {\n      const queryParams = new URLSearchParams(window.location.search);\n      clientId.value = queryParams.get('client');\n      templateId.value = queryParams.get('template');\n      await fetchFormData();\n    });\n    const fetchFormData = async () => {\n      if (templateId.value) {\n        try {\n          const response = await apiService.getCustomFormById(templateId.value);\n          formFields.value = response.data.data.form_items;\n          formType.value = response.data.data.console.log(formFields.value);\n          console.log(response.data);\n        } catch (error) {\n          console.error('Error fetching form data:', error);\n          // Обробіть помилку\n        }\n      }\n    };\n    const submitForm = async () => {\n      // Логіка для обробки надсилання форми\n      console.log('Форма надіслана:', formFields.value);\n      // Тут ви можете зробити запит POST до вашого API з даними форми\n    };\n    return {\n      formFields,\n      clientId,\n      templateId,\n      submitForm\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","apiService","setup","formFields","clientId","templateId","queryParams","URLSearchParams","window","location","search","value","get","fetchFormData","response","getCustomFormById","data","form_items","formType","console","log","error","submitForm"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\components\\form\\SendFormPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"send-form-page\">\r\n    <h1>Надіслати форму</h1>\r\n    <form v-if=\"formFields.length > 0\" @submit.prevent=\"submitForm\">\r\n      <div v-for=\"(field, index) in formFields\" :key=\"index\">\r\n        <label :for=\"`field-${index}`\">{{ field.field_name }}</label>\r\n        <input v-if=\"field.field_type !== 'boolean'\" :id=\"`field-${index}`\" type=\"text\" v-model=\"field.value\"/>\r\n        <label v-else :for=\"`field-${index}`\">\r\n          <input :id=\"`field-${index}`\" type=\"checkbox\" v-model=\"field.value\"> Так\r\n        </label>\r\n      </div>\r\n      <button type=\"submit\">Надіслати</button>\r\n    </form>\r\n    <div v-else>\r\n      <p>Завантаження форми...</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue';\r\nimport apiService from \"@/services/apiService\";\r\n\r\nexport default {\r\n  setup() {\r\n    const formFields = ref([]);\r\n    const clientId = ref(null);\r\n    const templateId = ref(null);\r\n\r\n    onMounted(async () => {\r\n      const queryParams = new URLSearchParams(window.location.search);\r\n      clientId.value = queryParams.get('client');\r\n      templateId.value = queryParams.get('template');\r\n      await fetchFormData();\r\n    });\r\n\r\n    const fetchFormData = async () => {\r\n      if (templateId.value) {\r\n        try {\r\n          const response = await apiService.getCustomFormById(templateId.value);\r\n          formFields.value = response.data.data.form_items;\r\n          formType.value = response.data.data.\r\n          console.log(formFields.value);\r\n          console.log(response.data);\r\n        } catch (error) {\r\n          console.error('Error fetching form data:', error);\r\n          // Обробіть помилку\r\n        }\r\n      }\r\n    };\r\n\r\n    const submitForm = async () => {\r\n      // Логіка для обробки надсилання форми\r\n      console.log('Форма надіслана:', formFields.value);\r\n      // Тут ви можете зробити запит POST до вашого API з даними форми\r\n    };\r\n\r\n    return {\r\n      formFields,\r\n      clientId,\r\n      templateId,\r\n      submitForm,\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<!--<template>-->\r\n<!--  <div class=\"send-form-page\">-->\r\n<!--    <h1>Надіслати форму</h1>-->\r\n<!--    <form v-if=\"formFields.length > 0\" @submit.prevent=\"submitForm\">-->\r\n<!--      <div v-for=\"(field, index) in formFields\" :key=\"index\">-->\r\n<!--        <label :for=\"`field-${index}`\">{{ field.field_name }}</label>-->\r\n<!--        <input v-if=\"field.field_type !== 'boolean'\" :id=\"`field-${index}`\" type=\"text\" v-model=\"field.value\"/>-->\r\n<!--        <label v-else :for=\"`field-${index}`\">-->\r\n<!--          <input :id=\"`field-${index}`\" type=\"checkbox\" v-model=\"field.value\"> Так-->\r\n<!--        </label>-->\r\n<!--      </div>-->\r\n<!--      <button type=\"submit\">Надіслати</button>-->\r\n<!--    </form>-->\r\n<!--    <div v-else>-->\r\n<!--      <p>Завантаження форми...</p>-->\r\n<!--    </div>-->\r\n<!--  </div>-->\r\n<!--</template>-->\r\n\r\n<!--<script>-->\r\n<!--import apiService from \"@/services/apiService\";-->\r\n\r\n<!--export default {-->\r\n<!--  data() {-->\r\n<!--    return {-->\r\n<!--      formFields: [],-->\r\n<!--      clientId: null,-->\r\n<!--      templateId: null-->\r\n<!--    };-->\r\n<!--  },-->\r\n<!--  created() {-->\r\n<!--    const queryParams = new URLSearchParams(window.location.search);-->\r\n<!--    this.clientId = queryParams.get('client');-->\r\n<!--    this.templateId = queryParams.get('template');-->\r\n<!--    this.fetchFormData();-->\r\n<!--  },-->\r\n<!--  methods: {-->\r\n<!--    async fetchFormData() {-->\r\n<!--      if (this.templateId) {-->\r\n<!--        try {-->\r\n<!--          const response = await apiService.getCustomFormById(this.templateId);-->\r\n<!--          this.formFields = response.data.data.form_items;-->\r\n<!--          console.log(this.formFields)-->\r\n<!--          console.log(response.data)-->\r\n<!--        } catch (error) {-->\r\n<!-- 