SessionIcon, isVisible: true },\r\n      { title: 'Клієнти', url: '/podcast', exact: true, icon: clientsIcon, isVisible: false },\r\n      { title: 'Підтримка', url: '/saved', exact: true, icon: supportIcon, isVisible: false },\r\n      { title: 'Банк інфомації', url: '/categories', exact: true, icon: bankInformationIcon, isVisible: true },\r\n    ],\r\n  }),\r\n\r\n}\r\n</script>"],"mappings":"AAwDA,OAAOA,YAAW,MAAO,6BAA6B;AACtD,OAAOC,aAAY,MAAO,8BAA8B;AACxD,OAAOC,WAAU,MAAO,iCAAiC;AACzD,OAAOC,WAAU,MAAO,8BAA8B;AACtD,OAAOC,mBAAkB,MAAO,yBAAyB;AAEzD,eAAe;EACbC,IAAI,EAAEA,CAAA,MAAO;IACXC,KAAK,EAAE,CACL;MAAEC,KAAK,EAAE,UAAU;MAAEC,GAAG,EAAE,GAAG;MAAEC,IAAI,EAAET,YAAY;MAAEU,SAAS,EAAE;IAAK,CAAC,EACpE;MAAEH,KAAK,EAAE,WAAW;MAAEC,GAAG,EAAE,aAAa;MAAEG,KAAK,EAAE,IAAI;MAAEF,IAAI,EAAER,aAAa;MAAES,SAAS,EAAE;IAAK,CAAC,EAC7F;MAAEH,KAAK,EAAE,SAAS;MAAEC,GAAG,EAAE,UAAU;MAAEG,KAAK,EAAE,IAAI;MAAEF,IAAI,EAAEP,WAAW;MAAEQ,SAAS,EAAE;IAAM,CAAC,EACvF;MAAEH,KAAK,EAAE,WAAW;MAAEC,GAAG,EAAE,QAAQ;MAAEG,KAAK,EAAE,IAAI;MAAEF,IAAI,EAAEN,WAAW;MAAEO,SAAS,EAAE;IAAM,CAAC,EACvF;MAAEH,KAAK,EAAE,gBAAgB;MAAEC,GAAG,EAAE,aAAa;MAAEG,KAAK,EAAE,IAAI;MAAEF,IAAI,EAAEL,mBAAmB;MAAEM,SAAS,EAAE;IAAK,CAAC;EAE5G,CAAC;AAEH"},"metadata":{},"sourceType":"module","externalDependencies":[]}