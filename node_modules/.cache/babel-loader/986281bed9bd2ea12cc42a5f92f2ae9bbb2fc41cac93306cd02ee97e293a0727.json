{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { useRouter } from 'vue-router';\nimport apiService from '@/services/apiService';\nimport M from \"materialize-css\";\n// import M from 'materialize-css';\n\nexport default {\n  name: 'BankInformation',\n  data() {\n    return {\n      allforms: [] // Масив для зберігання даних клієнтів\n    };\n  },\n  setup() {\n    const router = useRouter();\n    const goToAddTemplate = () => {\n      router.push({\n        name: 'AddTemplate'\n      });\n    };\n    return {\n      goToAddTemplate\n    };\n  },\n  methods: {\n    async fetchAllForms() {\n      try {\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\n        if (token) {\n          const response = await apiService.getForms(token);\n          console.log(response.data.data);\n          if (response && response.data && response.data.data) {\n            this.allforms = response.data.data; // Зберігання даних форм у масив\n          }\n        }\n      } catch (error) {\n        console.error('Error fetching clients:', error);\n        M.toast({\n          html: `Увійдіть у систему`\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["useRouter","apiService","M","name","data","allforms","setup","router","goToAddTemplate","push","methods","fetchAllForms","token","localStorage","getItem","response","getForms","console","log","error","toast","html"],"sources":["C:\\Users\\Denys\\WebstormProjects\\kokh-psy-assistant-client\\src\\views\\BankInformationPage.vue"],"sourcesContent":["<template>\r\n  <section class=\"client-section\">\r\n    <div class=\"client-header\">\r\n      <button class=\"btn-add-client\" @click=\"goToAddTemplate\">\r\n        Додати шаблон\r\n      </button>\r\n      <button class=\"btn-refresh\">\r\n        <img src=\"@/assets/icons/refresh.svg\" alt=\"Оновити\">\r\n      </button>\r\n    </div>\r\n    <div class=\"client-list\">\r\n      <table class=\"table\">\r\n        <thead>\r\n        <tr>\r\n          <th>Назва шаблону</th>\r\n        </tr>\r\n        </thead>\r\n        <tbody>\r\n        <tr v-for=\"form in allforms\" :key=\"form.id\">\r\n          <td>{form.name}</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">\r\n            </button>\r\n          </td>\r\n        </tr>\r\n        <tr>\r\n          <td>Шаблон для клієнтів + телеграм</td>\r\n          <td class=\"all-butt-management\">\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/visible-client.svg\" alt=\"Переглянути\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/edit-client.svg\" alt=\"Редагувати\">\r\n            </button>\r\n            <button class=\"btn-action\">\r\n              <img src=\"@/assets/icons/trash-client.svg\" alt=\"Видалити\">\r\n            </button>\r\n          </td>\r\n        </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n    <div class=\"client-footer\">\r\n      <div class=\"pagination-info\">\r\n        Сторінка 1 з 10\r\n      </div>\r\n      <div class=\"pagination-controls\">\r\n        <button class=\"btn-pagination before\">назад</button>\r\n        <button class=\"btn-pagination after\">далі</button>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n<script>\r\nimport { useRouter } from 'vue-router';\r\nimport apiService from '@/services/apiService';\r\nimport M from \"materialize-css\";\r\n// import M from 'materialize-css';\r\n\r\nexport default {\r\n  name: 'BankInformation',\r\n  data() {\r\n    return {\r\n      allforms: [], // Масив для зберігання даних клієнтів\r\n    };\r\n  },\r\n  setup() {\r\n    const router = useRouter();\r\n\r\n    const goToAddTemplate = () => {\r\n      router.push({ name: 'AddTemplate' });\r\n    };\r\n\r\n    return {\r\n      goToAddTemplate,\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchAllForms() {\r\n      try {\r\n        const token = localStorage.getItem('token'); // Отримання токена з локального сховища\r\n        if (token) {\r\n          const response = await apiService.getForms(token);\r\n          console.log(response.data.data)\r\n          if (response && response.data && response.data.data) {\r\n            this.allforms = response.data.data; // Зберігання даних форм у масив\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('Error fetching clients:', error);\r\n        M.toast({ html: `Увійдіть у систему` });\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":";AA8DA,SAASA,SAAQ,QAAS,YAAY;AACtC,OAAOC,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,CAAA,MAAO,iBAAiB;AAC/B;;AAEA,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE,CAAE;IAChB,CAAC;EACH,CAAC;EACDC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIP,SAAS,CAAC,CAAC;IAE1B,MAAMQ,eAAc,GAAIA,CAAA,KAAM;MAC5BD,MAAM,CAACE,IAAI,CAAC;QAAEN,IAAI,EAAE;MAAc,CAAC,CAAC;IACtC,CAAC;IAED,OAAO;MACLK;IACF,CAAC;EACH,CAAC;EACDE,OAAO,EAAE;IACP,MAAMC,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAMC,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;QAC7C,IAAIF,KAAK,EAAE;UACT,MAAMG,QAAO,GAAI,MAAMd,UAAU,CAACe,QAAQ,CAACJ,KAAK,CAAC;UACjDK,OAAO,CAACC,GAAG,CAACH,QAAQ,CAACX,IAAI,CAACA,IAAI;UAC9B,IAAIW,QAAO,IAAKA,QAAQ,CAACX,IAAG,IAAKW,QAAQ,CAACX,IAAI,CAACA,IAAI,EAAE;YACnD,IAAI,CAACC,QAAO,GAAIU,QAAQ,CAACX,IAAI,CAACA,IAAI,EAAE;UACtC;QACF;MACF,EAAE,OAAOe,KAAK,EAAE;QACdF,OAAO,CAACE,KAAK,CAAC,yBAAyB,EAAEA,KAAK,CAAC;QAC/CjB,CAAC,CAACkB,KAAK,CAAC;UAAEC,IAAI,EAAG;QAAoB,CAAC,CAAC;MACzC;IACF;EACF;AACF,CAAC"},"metadata":{},"sourc